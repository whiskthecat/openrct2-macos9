+    ScreenCoordsXY WindowClampPosition(ScreenCoordsXY position, ScreenSize size)
+    {
+        const auto bounds = WindowGetUsableBounds();
+        // An oversized window may pan over its whole content. Its controls are
+        // pinned separately, so no drag can make the caption/close box unreachable.
+        position.x = std::clamp(
+            position.x, std::min(0, bounds.getWidth() - size.width), std::max(0, bounds.getWidth() - size.width));
+        position.y = std::clamp(
+            position.y, std::min(bounds.getTop(), bounds.getBottom() - size.height),
+            std::max(bounds.getTop(), bounds.getBottom() - size.height));
+        return position;
+    }
+
+    void WindowFitWithinScreen(WindowBase& w)
+    {
+        if (!WindowHasFloatingFrame(w))
+            return;
+        const auto bounds = WindowGetUsableBounds();
+        if (w.flags.has(WindowFlag::resizable))
+        {
+            const auto targetWidth = std::max<int32_t>(w.minWidth, std::min<int32_t>(w.width, bounds.getWidth()));
+            const auto targetHeight = std::max<int32_t>(w.minHeight, std::min<int32_t>(w.height, bounds.getHeight()));
+            if (w.width != targetWidth || w.height != targetHeight)
+                WindowResizeByDelta(w, targetWidth - w.width, targetHeight - w.height);
+        }
+        WindowSetPosition(w, WindowClampPosition(w.windowPos, { w.width, WindowGetVisibleHeight(w) }));
+        WindowPinCaption(w);
+    }
+
+    void WindowPinCaption(WindowBase& w)
+    {
+        if (!WindowHasFloatingFrame(w))
+            return;
+        auto& title = w.widgets[1];
+        auto& close = w.widgets[2];
+        const bool oversized = WindowIsOversized(w);
+        const auto closeWidth = close.width();
+        const auto normalCloseLeft = Config::Get().interface.windowButtonsOnTheLeft ? 2 : w.width - closeWidth - 2;
+        if (!oversized && title.left == 1 && title.top == 1 && title.right == w.width - 2
+            && (close.type != WidgetType::closeBox || (close.left == normalCloseLeft && close.top == 2)))
+            return;
+        const auto titleHeight = title.height();
+        const auto closeHeight = close.height();
+        const auto bounds = WindowGetUsableBounds();
+        const auto left = oversized ? std::max(bounds.getLeft(), w.windowPos.x) - w.windowPos.x : 0;
+        const auto right = oversized ? std::min(bounds.getRight(), w.windowPos.x + w.width) - w.windowPos.x : w.width;
+        const auto top = oversized && !w.windowShaded ? std::max(bounds.getTop(), w.windowPos.y) - w.windowPos.y : 0;
+        title.left = left + 1;
+        title.right = right - 2;
+        title.top = top + 1;
+        title.bottom = title.top + titleHeight - 1;
+        if (close.type == WidgetType::closeBox)
+        {
+            close.left = Config::Get().interface.windowButtonsOnTheLeft ? left + 2 : right - closeWidth - 2;
+            close.right = close.left + closeWidth - 1;
+            close.top = top + 2;
+            close.bottom = close.top + closeHeight - 1;
+        }
+    }
