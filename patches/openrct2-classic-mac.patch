+// that explicit so the engine also runs on big-endian hosts such as PowerPC.
+// ---------------------------------------------------------------------------
+namespace OpenRCT2
+{
+    inline constexpr bool kHostIsBigEndian = std::endian::native == std::endian::big;
+
+    template<typename T>
+    concept EndianScalar = std::is_arithmetic_v<T> || std::is_enum_v<T>;
+
+    // Converts a scalar between host order and stored little-endian order.
+    // The operation is its own inverse.
+    template<EndianScalar T>
+    [[nodiscard]] constexpr T HostLE(T value) noexcept
+    {
+        if constexpr (!kHostIsBigEndian || sizeof(T) == 1)
+        {
+            return value;
+        }
+        else if constexpr (std::is_integral_v<T> && !std::is_same_v<T, bool>)
+        {
+            using U = std::make_unsigned_t<T>;
+            U in = static_cast<U>(value), out = 0;
+            for (size_t i = 0; i < sizeof(T); i++)
+            {
+                out = static_cast<U>((out << 8) | (in & 0xFF));
+                in = static_cast<U>(in >> 8);
+            }
+            return static_cast<T>(out);
+        }
+        else if constexpr (std::is_enum_v<T>)
+        {
+            return static_cast<T>(HostLE(static_cast<std::underlying_type_t<T>>(value)));
+        }
+        else
+        {
+            // Floating point: swap the object representation.
+            unsigned char bytes[sizeof(T)];
+            std::memcpy(bytes, &value, sizeof(T));
+            for (size_t i = 0; i < sizeof(T) / 2; i++)
+            {
+                const unsigned char t = bytes[i];
+                bytes[i] = bytes[sizeof(T) - 1 - i];
+                bytes[sizeof(T) - 1 - i] = t;
+            }
+            T result;
+            std::memcpy(&result, bytes, sizeof(T));
+            return result;
+        }
+    }
