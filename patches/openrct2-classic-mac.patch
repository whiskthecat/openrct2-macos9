     void RideObject::Load()
     {
+        // Classic's TLT1 door layers contain 24 dark-blue (118) pixels in
+        // their dark-red (58) opening. The original RCT Deluxe doorway has
+        // no blue specks. Repair only these two layers in the loaded copy,
+        // leaving the windows and the installed object intact.
+        if (GetIdentifier() == "rct2.ride.tlt1" && GetImageTable().GetCount() >= 7)
+        {
+            for (const size_t image : { size_t{3}, size_t{6} })
+            {
+                const auto& sprite = GetImageTable().GetImages()[image];
+                if (!sprite.flags.has(G1Flag::hasRLECompression))
+                    continue;
+                for (int32_t y = 0; y < sprite.height; ++y)
+                {
+                    // Sprite row offsets are stored little endian on every host.
+                    auto* span = sprite.offset + sprite.offset[2*y] + (sprite.offset[2*y+1] << 8);
+                    uint8_t length;
+                    do
+                    {
+                        length = *span;
+                        span += 2;
+                        for (uint8_t x = 0; x < (length & 0x7F); ++x, ++span)
+                            if (*span == 118)
+                                *span = 58;
+                    } while (!(length & 0x80));
+                }
+            }
+        }
         GetStringTable().Sort();
         _legacyType.naming.Name = LanguageAllocateObjectString(GetName());
         _legacyType.naming.Description = LanguageAllocateObjectString(GetDescription());
diff --git a/src/openrct2/paint/EntityTileOrder.h b/src/openrct2/paint/EntityTileOrder.h
new file mode 100644
index 0000000..586a9c0
--- /dev/null
+++ b/src/openrct2/paint/EntityTileOrder.h
@@ -0,0 +1,121 @@
+#pragma once
+
+#include "../entity/EntityPresentationProbe.h"
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <vector>
+
+namespace OpenRCT2
+{
+    // Retain geometry/order only. The caller must give every new paint key a
+    // fresh preparation epoch before reading entity pointers or rectangles.
+    template<size_t Size, typename Tile>
+    class EntityTileOrder
+    {
+        static_assert(Size * Size <= 65536);
+        std::array<uint8_t, Size * Size / 8> _occupied{};
+        std::vector<uint16_t> _changes;
+        size_t _tiles = 0;
+        bool _valid = false;
+
+    public:
+        size_t storageBytes() const
+        {
+            size_t bytes = sizeof(*this) + _changes.capacity() * sizeof(uint16_t);
+            for (const auto& list : diagonals) bytes += list.capacity() * sizeof(Tile);
+            return bytes;
+        }
+
+        std::array<std::vector<Tile>, 4 * Size> diagonals;
+
+        template<typename MakeTile>
+        void update(const uint8_t* occupied, MakeTile makeTile, bool forceFull = false)
+        {
+            bool unchanged;
+            {
+                PresentationProbe::Scope scope(PresentationProbe::bitmap);
+                unchanged = _valid && std::memcmp(occupied, _occupied.data(), _occupied.size()) == 0;
+                _changes.clear();
+                if (!unchanged)
+                {
+                    for (size_t byte = 0; byte < _occupied.size(); ++byte)
+                    {
+                        unsigned bits = occupied[byte] ^ _occupied[byte];
+                        while (bits)
+                        {
+                            _changes.push_back(static_cast<uint16_t>(byte * 8 + __builtin_ctz(bits)));
+                            bits &= bits - 1;
+                        }
+                    }
+                    std::memcpy(_occupied.data(), occupied, _occupied.size());
+                }
+                if (PresentationProbe::enabled)
+                {
+                    PresentationProbe::stats.bitmapBytes += _occupied.size();
+                    PresentationProbe::stats.changedBits += _changes.size();
+                    PresentationProbe::stats.changedPictures += !_changes.empty();
+                }
+            }
+            // Bound load/edit churn. Rebuilds retain the original diagonal sort;
+            // ordinary movement changes only a small number of occupancy bits.
+            const bool rebuild = forceFull || !_valid || _changes.size() > std::max(size_t{64}, _tiles / 4);
+            if (rebuild)
+            {
+                {
+                    PresentationProbe::Scope scope(PresentationProbe::diagonal);
+                    for (auto& list : diagonals) list.clear();
+                    _tiles = 0;
+                    for (size_t byte = 0; byte < _occupied.size(); ++byte)
+                    {
+                        unsigned bits = occupied[byte];
+                        while (bits)
+                        {
+                            const auto index = static_cast<uint16_t>(byte * 8 + __builtin_ctz(bits));
+                            bits &= bits - 1;
+                            auto [diagonal, tile] = makeTile(index);
+                            diagonals[diagonal].push_back(tile);
+                            ++_tiles;
+                        }
+                    }
+                }
+                {
+                    PresentationProbe::Scope scope(PresentationProbe::sorting);
+                    for (auto& list : diagonals)
+                        std::sort(list.begin(), list.end(), [](const Tile& a, const Tile& b) { return a.u < b.u; });
+                }
+                if (PresentationProbe::enabled) PresentationProbe::stats.rebuilds++;
+            }
+            else if (!unchanged)
+            {
+                PresentationProbe::Scope scope(PresentationProbe::diagonal);
+                for (const auto index : _changes)
+                {
+                    auto [diagonal, tile] = makeTile(index);
+                    auto& list = diagonals[diagonal];
+                    const auto at = std::lower_bound(list.begin(), list.end(), tile.u,
+                        [](const Tile& a, int u) { return a.u < u; });
+                    if (occupied[index / 8] & (1u << (index & 7)))
+                    {
+                        list.insert(at, tile); ++_tiles;
+                    }
+                    else
+                    {
+                        if (at == list.end() || at->u != tile.u)
+                        {
+                            // The bitmap no longer describes these lists. Rebuild
+                            // from the current bitmap, including earlier changes.
+                            update(occupied, makeTile, true);
+                            return;
+                        }
+                        list.erase(at); --_tiles;
+                    }
+                }
+                if (PresentationProbe::enabled) PresentationProbe::stats.reused++;
+            }
+            else if (PresentationProbe::enabled) PresentationProbe::stats.reused++;
+            _valid = true;
+            if (PresentationProbe::enabled) PresentationProbe::stats.occupied += _tiles;
+        }
+    };
+}
