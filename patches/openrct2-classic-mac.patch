+        void PaintScaledMap(RenderTarget& rt, const ScreenCoordsXY& offset)
+        {
+            // Clip first. Work and storage depend on visible pixels, never on zoomed park area.
+            const auto extent = getMiniMapWidth() * _zoom;
+            const auto l = std::max(rt.x, offset.x), t = std::max(rt.y, offset.y);
+            const auto r = std::min(rt.x + rt.width, offset.x + extent);
+            const auto b = std::min(rt.y + rt.height, offset.y + extent);
+            if (l >= r || t >= b) return;
+            for (auto y = t; y < b; ++y)
