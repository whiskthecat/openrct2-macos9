+    };
+    template<typename T>
+    struct IsEndianNeutral<LittleEndian<T>> : std::true_type
+    {
+    };
+    template<typename T, size_t N>
+    struct IsEndianNeutral<T[N]> : IsEndianNeutral<T>
+    {
+    };
+    template<typename T, size_t N>
+    struct IsEndianNeutral<std::array<T, N>> : IsEndianNeutral<T>
