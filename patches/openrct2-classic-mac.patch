+        // Fill only the picture blocks requested by this repaint. Off-screen gutter rows
+        // stay invalid until a scroll exposes them; settling does not trigger a rebuild.
+        void ColumnPaintPicture(CachedColumn& column, int32_t top, int32_t bottom, bool owners)
+        {
+            OG_SCOPE(paint);
+            const auto promotionStart = CacheCPUTrace() && gPaintClock != nullptr ? gPaintClock() : 0;
+            bool allocated = false;
+            if (!owners && !CacheCPUEagerOwners() && ColumnOwnerSize(column) != 0
+                && std::none_of(column.pictureRowsValid.begin(), column.pictureRowsValid.end(),
+                                [](uint8_t mask) { return (mask & 2) != 0; }))
+            {
+                std::vector<uint16_t>().swap(column.pictureOwners);
+                std::vector<uint8_t>().swap(column.pictureOwners8);
+            }
+            if (owners && ColumnOwnerSize(column) != column.picture.size())
+            {
+                bool denied = CacheCPUOwnerLimit() != 0 && column.picture.size() * sizeof(uint16_t) > CacheCPUOwnerLimit();
+                if (!denied)
+                {
+                    try {
+                        if (gPaintByteOwners && column.zoom == ZoomLevel{0} && column.baseList.size() <= 255)
+                            column.pictureOwners8.resize(column.picture.size());
+                        else column.pictureOwners.resize(column.picture.size());
+                        allocated = true;
+                    }
+                    catch (const std::bad_alloc&) { denied = true; }
+                }
+                if (denied)
+                {
+                    if (CacheCPUTrace())
+                    {
+                        SC_SCOPE(metadata);
+                        std::fprintf(stderr, "CC,denied,%u,%d,%d,%zu\n", gPaintFrameSerial, column.x,
+                            static_cast<int8_t>(column.zoom), column.picture.size() * sizeof(uint16_t));
+                    }
+                    // No owner-valid bit is set. The caller's readiness check
+                    // selects the ordinary painter and can retry later.
+                    return;
+                }
+            }
+            gSpriteRasterCacheStats.pictureBuilds++;
+            if (column.pictureStarted) gSpriteRasterCacheStats.pictureRepairs++;
+            column.pictureStarted = true;
+            // At small target widths a tiny row fill repeatedly scans a long map list.
+            // Keep the amortised full picture there.
+            if (column.zoom > ZoomLevel{0} && !gPaintPartialZoomPictures)
+            {
+                top = column.top;
+                bottom = column.bottom;
+            }
+#ifdef OPENRCT2_SCROLL_TRACE
+            if (column.traceBuilt == gPaintFrameSerial) ScrollTrace::Mark<ScrollTrace::freshPicture>();
+            else ScrollTrace::Mark<ScrollTrace::repairPicture>();
+#endif
+            auto* session = column.session;
+            const auto start = gPaintClock != nullptr ? gPaintClock() : 0;
+            const int32_t first = std::max(top, column.top) - column.top;
+            const int32_t last = std::min(bottom, column.bottom) - column.top;
+            const int32_t endBlock = (last + kPictureBlockRows - 1) / kPictureBlockRows;
+            const uint8_t mask = owners ? 3 : 1;
+            const bool promotion = owners && !ColumnPictureReady(column, column.top + first, column.top + last, 2);
+            if (owners) column.ownerEverPainted = true;
+            for (int32_t block = first / kPictureBlockRows; block < endBlock;)
+            {
+                if ((column.pictureRowsValid[block] & mask) == mask)
+                {
+                    block++;
+                    continue;
+                }
+                int32_t end = block;
+                while (end < endBlock && (column.pictureRowsValid[end] & mask) != mask)
+                    column.pictureRowsValid[end++] = mask;
+                RenderTarget rt = column.fullRT;
+                rt.y = column.top + block * kPictureBlockRows;
+                rt.height = std::min(column.bottom, column.top + end * kPictureBlockRows) - rt.y;
+                rt.bits = column.picture.data() + static_cast<size_t>(rt.y - column.top) * column.width;
+                rt.pitch = 0;
+                std::fill_n(rt.bits, static_cast<size_t>(rt.height) * column.width,
+                    column.flags.has(ViewportFlag::undergroundInside) ? PaletteIndex::pi10 : PaletteIndex::transparent);
+                const size_t offset = static_cast<size_t>(rt.y - column.top) * column.width;
+                // Existing scenery writers use a resident word scratch for repaired blocks.
+                // Only the repaired rows are narrowed back into the persistent plane.
+                static std::vector<uint16_t> ownerScratch;
+                const bool narrow = owners && !column.pictureOwners8.empty();
+                uint16_t* ownerTarget = nullptr;
+                if (owners)
+                {
+                    if (narrow) {ownerScratch.resize(static_cast<size_t>(rt.height)*column.width);ownerTarget=ownerScratch.data();}
+                    else ownerTarget = column.pictureOwners.data()+offset;
+                    std::fill_n(ownerTarget, static_cast<size_t>(rt.height)*column.width, 0);
+                }
+                if (gPaintOwnerPictures && owners)
+                    gSpriteOwnerTarget = { narrow ? rt.bits : column.picture.data(), narrow ? ownerTarget : column.pictureOwners.data(), 0, true };
+                session->rt = rt;
+                PaintDrawMapEntries(*session, column.nodesOk ? column.baseList : column.drawList);
+                if (narrow)
+                    for (size_t i=0;i<static_cast<size_t>(rt.height)*column.width;++i)
+                        column.pictureOwners8[offset+i]=static_cast<uint8_t>(ownerTarget[i]);
+                gSpriteRasterCacheStats.basePixels += static_cast<uint64_t>(rt.width) * rt.height;
+                gSpriteOwnerTarget = {};
+                block = end;
+            }
+            session->rt = column.fullRT;
+            // Complete means every row is ready, including the off-screen gutter. In the
+            // usual partial case inspect only the requested blocks on the next repaint.
+            column.pictureComplete = first == 0 && last == column.bottom - column.top ? mask : 0;
+#ifdef OPENRCT2_SCROLL_TRACE
+            ScrollTrace::Mark<31>();
+#endif
+            if (gPaintClock != nullptr)
+                gSpriteRasterCacheStats.baseMicros += gPaintClock() - start;
+            if (CacheCPUTrace() && promotion)
+            {
+                SC_SCOPE(metadata);
+                std::fprintf(stderr, "CC,promotion,%u,%d,%d,%zu,%u,%u\n", gPaintFrameSerial, column.x,
+                    static_cast<int8_t>(column.zoom), ColumnOwnerSize(column) * 2,
+                    static_cast<unsigned>(gPaintClock != nullptr ? gPaintClock() - promotionStart : 0), unsigned(allocated));
+            }
+        }
+
+        CachedColumn& ColumnFind(int32_t x)
+        {
+            const auto slot = static_cast<size_t>((x / _set->zoom.ApplyInversedTo(kCoordsXYStep)) & 255);
+            const size_t cached = _set->lookup[slot];
+            if (gPaintColumnLookup && cached < _set->columns.size() && _set->columns[cached].x == x)
+                return _set->columns[cached];
+            for (size_t i = 0; i < _set->columns.size(); i++)
+            {
+                auto& column = _set->columns[i];
+                if (column.x == x)
+                {
+                    _set->lookup[slot] = static_cast<uint16_t>(i);
+                    return column;
+                }
+            }
+            // A small view (inside a window) keeps only about as many columns as it shows.
+            // (Zoomed out, the columns are narrow and a view shows many more of them.)
+            size_t limit = kColumnCacheMax;
+            if (_set->viewport != nullptr)
+            {
+                const int32_t columnWidth = _set->zoom.ApplyInversedTo(kCoordsXYStep);
+                const size_t shown = static_cast<size_t>(_set->view.width / columnWidth) + 4;
+                limit = shown > kColumnCacheMax ? std::min(shown, kColumnCacheMaxZoomedOut) : std::min(kColumnCacheMax, shown + 20);
+            }
+            if (_set->columns.size() < limit)
+            {
+                auto& column = _set->columns.emplace_back();
+                column.x = x;
+                _set->lookup[slot] = static_cast<uint16_t>(_set->columns.size() - 1);
+                return column;
+            }
+            // lastUsed records repaints, not residence. Quiet visible columns may have
+            // older timestamps than a column which just left the screen. Evict outside
+            // the current view first, retaining LRU within each group.
+            const int32_t viewLeft = _set->zoom.ApplyInversedTo(_set->view.viewPos.x);
+            const int32_t viewRight = viewLeft + _set->view.width;
+            const auto outside = [&](const CachedColumn& column) {
+                return column.x + column.width <= viewLeft || column.x >= viewRight;
+            };
+            auto* oldest = &_set->columns[0];
+            bool oldestOutside = outside(*oldest);
+            for (auto& column : _set->columns)
+            {
+                const bool columnOutside = outside(column);
+                if ((columnOutside && !oldestOutside)
+                    || (columnOutside == oldestOutside && column.lastUsed < oldest->lastUsed))
+                {
+                    oldest = &column;
+                    oldestOutside = columnOutside;
+                }
+            }
+#ifdef OPENRCT2_SCROLL_TRACE
+            if (oldest->traceId != 0) TraceColumn("end", *oldest);
+            oldest->traceId = 0;
+#endif
+            oldest->x = x;
+            oldest->valid = false;
+            oldest->cold = true;
+            _set->lookup[slot] = static_cast<uint16_t>(oldest - _set->columns.data());
+            return *oldest;
+        }
+
+        // The sorted draw list for one rectangle of a column: the entities that draw into its
+        // rows and the map entries that do. With `onlyIfMoving`, returns false without a list
+        // when no entity is there.
+        bool ColumnLocalList(CachedColumn& column, const RenderTarget& rt, bool onlyIfMoving)
+        {
+            SC_SCOPE(localList);
+            OG_SCOPE(collect);
+            PAINT_TIMING(localList);
+            // The contextual sort can order two visible roots through a third
+            // root whose sprite is outside this dirty rectangle. Keep all roots
+            // of the generated tiles in that mode; a sprite-extent halo makes
+            // scenery depth depend on the damage rectangle after scrolling.
+            const int32_t halo = !(ColumnUsesDirectOwners() && gPaintOwnerPictures) ? -1
+                : column.zoom >= ZoomLevel{2} ? gPaintSortHalo2 : column.zoom == ZoomLevel{1} ? gPaintSortHalo1 : gPaintSortHalo;
+            const bool compact = onlyIfMoving && gPaintDirectRankReuse && gPaintCompactLocalLists;
+            const auto start = gPaintClock != nullptr ? gPaintClock() : 0;
+            const int32_t top = rt.y, bottom = rt.y + rt.height;
+            _localEntities.clear();
+            PAINT_COUNT(entityRangeTests, column.entityNodes.size());
+            for (size_t i = 0; i < column.entityNodes.size(); i++)
+            {
+                const auto& range = column.entityRanges[i];
+                if (range.getBottom() > top && range.getTop() < bottom
+                    && range.getRight() > rt.x && range.getLeft() < rt.x + rt.width)
+                    _localEntities.push_back(static_cast<uint16_t>(i));
+            }
+            if (onlyIfMoving && _localEntities.empty() && !column.hasAnimated)
+                return false;
+            std::vector<uint16_t>* selectedMaps = nullptr;
+            const unsigned selectionSlot = ((static_cast<uint32_t>(top) * 2654435761u) ^ (static_cast<uint32_t>(bottom) * 2246822519u)) >> 24;
+            if (gPaintMemoMaps && gPaintMemoLookup)
+            {
+                const size_t index = column.selectionLookup[selectionSlot];
+                if (index < column.mapSelections.size())
+                {
+                    auto& candidate = column.mapSelections[index];
+                    if (candidate.top == top && candidate.bottom == bottom && candidate.halo == halo)
+                    {
+                        candidate.used = gPaintFrameSerial;
+                        selectedMaps = &candidate.maps;
+                        gSpriteRasterCacheStats.selectionHits++;
+                    }
+                }
+            }
+            if (gPaintMemoMaps && selectedMaps == nullptr)
+                for (auto& candidate : column.mapSelections)
+                    if (candidate.top == top && candidate.bottom == bottom && candidate.halo == halo)
+                    {
+                        candidate.used = gPaintFrameSerial;
+                        column.selectionLookup[selectionSlot] = static_cast<uint16_t>(&candidate - column.mapSelections.data());
+                        selectedMaps = &candidate.maps;
+                        gSpriteRasterCacheStats.selectionHits++;
+                        break;
+                    }
+            if (selectedMaps == nullptr)
+            {
+            _localMask.assign((column.mapNodes.size() + 31) / 32, 0);
+            const int32_t bandCount = static_cast<int32_t>(column.bands.size());
+            const int32_t first = std::max<int32_t>(0, (top - column.top) / kColumnBandRows);
+            const int32_t last = std::min<int32_t>(bandCount - 1, (bottom - 1 - column.top) / kColumnBandRows);
+            for (int32_t band = first; band <= last; band++)
+            {
+                const auto& bits = column.bands[static_cast<size_t>(band)];
+                for (size_t i = 0; i < bits.size(); i++)
+                    _localMask[i] |= bits[i];
+            }
+            _localMaps.clear();
+            const int32_t scanStart = (floor2(rt.WorldY() - 16, 32) - floor2(column.fullRT.WorldY() - 16, 32)) / 32;
+            const int32_t scanEnd = scanStart + ((rt.WorldHeight() + 2128) >> 5);
+            for (size_t word = 0; word < _localMask.size(); word++)
+            {
+                uint32_t bits = _localMask[word];
+                while (bits != 0)
+                {
+                    const size_t index = word * 32 + __builtin_ctz(bits);
+                    bits &= bits - 1;
+                    const auto& node = column.mapNodes[index];
+                    const auto range = ColumnNodeTileRange(column, index);
+                    const int32_t scanRow = node.GenerateStep / 4;
+                    if (range.second > top && range.first < bottom && scanRow >= scanStart && scanRow < scanEnd
+                        && (halo < 0 || (node.moving && ColumnUsesDirectOwners() && gPaintOwnerPictures)
+                            || (node.bottom > top - halo && node.top < bottom + halo)))
+                        _localMaps.push_back(static_cast<uint16_t>(index));
+                }
+            }
+                if (gPaintMemoMaps)
+                {
+                    CachedColumn::MapSelection* entry;
+                    if (column.mapSelections.size() < 64)
+                        entry = &column.mapSelections.emplace_back();
+                    else
+                        entry = &*std::min_element(column.mapSelections.begin(), column.mapSelections.end(),
+                            [](const auto& a, const auto& b) { return a.used < b.used; });
+                    *entry = { top, bottom, halo, gPaintFrameSerial, _localMaps };
+                    column.selectionLookup[selectionSlot] = static_cast<uint16_t>(entry - column.mapSelections.data());
+                    selectedMaps = &entry->maps;
+                    gSpriteRasterCacheStats.selectionMisses++;
+                }
+                else
+                    selectedMaps = &_localMaps;
+            }
+            PAINT_COUNT(selectedMaps, selectedMaps->size());
+            // Compact owner coverage is a set. Only the surviving blends need
+            // order; the full-list fallback still requires the complete order,
+            // including a memo first populated by a compact rectangle.
+            if (!compact && ColumnUsesDirectOwners() && gPaintOwnerPictures)
+            {
+                const auto byRank = [&column](uint16_t a, uint16_t b) {
+                    return column.mapNodes[a].baseRank < column.mapNodes[b].baseRank;
+                };
+                if (!std::is_sorted(selectedMaps->begin(), selectedMaps->end(), byRank))
+                    std::sort(selectedMaps->begin(), selectedMaps->end(), byRank);
+            }
+            // Direct insertion can memoise picture-rank order. The contextual
+            // full sort starts in collected index order, including after a mode change.
+            if (!(ColumnUsesDirectOwners() && gPaintOwnerPictures)
+                && !std::is_sorted(selectedMaps->begin(), selectedMaps->end()))
+                std::sort(selectedMaps->begin(), selectedMaps->end());
+            const auto sorted = gPaintClock != nullptr ? gPaintClock() : 0;
+            gSpriteRasterCacheStats.localFilterMicros += sorted - start;
+            if (ColumnUsesDirectOwners() && gPaintOwnerPictures)
+            {
+                if (compact)
+                {
+                    if (column.hasAnimated) ColumnCollectOrderNodes(column);
+                    else ColumnCollectBlends(column);
+                    if (column.blendPositionsFrame != gPaintFrameSerial)
+                    {
+                        column.entityBlendPositions.assign(column.entityNodes.size(), UINT32_MAX);
+                        column.blendPositionsFrame = gPaintFrameSerial;
+                    }
+                }
+                PaintInsertSelected(*column.session, column.mapNodes, column.entityNodes, *selectedMaps, _localEntities,
+                    _localList, compact, compact ? (column.hasAnimated ? &column.orderNodes : &column.blendNodes) : nullptr,
+                    compact ? &column.entityBlendPositions : nullptr,
+                    compact ? (column.hasAnimated ? column.maxOrderHeight : column.maxBlendHeight) : 0);
+            }
+            else if (gPaintSelectedSort)
+                PaintArrangeSelected(*column.session, column.mapNodes, column.entityNodes, *selectedMaps, _localEntities, _localList);
+            else
+            {
+                _localMapNodes.clear();
+                _localEntityNodes.clear();
+                for (const auto index : *selectedMaps)
+                {
+                    auto node = column.mapNodes[index];
+                    node.SortFlags = 0;
+                    _localMapNodes.push_back(node);
+                }
+                for (const auto index : _localEntities)
+                {
+                    auto node = column.entityNodes[index];
+                    node.SortFlags = 0;
+                    _localEntityNodes.push_back(node);
+                }
+                PaintArrangeMerged(*column.session, _localMapNodes, _localEntityNodes, _workNodes, _localList);
+            }
+            if (gPaintClock != nullptr)
+                gSpriteRasterCacheStats.localSortMicros += gPaintClock() - sorted;
+            return true;
+        }
