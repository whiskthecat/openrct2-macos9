+            for (size_t begin = 0; begin < ys.size(); ++begin)
+            {
+                while (end < ys.size() && ys[end] < ys[begin] + height)
+                    ++end;
+                if (end - begin > best)
+                {
+                    best = end - begin;
+                    view = { x, ys[begin] };
+                }
+            }
+        }
+        return { { "x", view.x }, { "y", view.y }, { "points", best } };
+    }
+
+    inline nlohmann::json SurveyPark(GameState_t& state)
+    {
+        using nlohmann::json;
+        json result;
+        result["ticks"] = state.currentTicks;
+        result["map"] = { state.mapSize.x, state.mapSize.y };
+        result["guests"] = state.park.numGuestsInPark;
+        result["park_open"] = state.park.flags.has(ParkFlag::parkOpen);
+        result["saved_view"] = { { "centre_x", state.savedView.x }, { "centre_y", state.savedView.y },
+            { "zoom", static_cast<int8_t>(state.savedViewZoom) }, { "rotation", state.savedViewRotation } };
+        const uint8_t rotation = state.savedViewRotation & 3;
+        constexpr std::array<const char*, 13> entities = { "vehicle", "guest", "staff", "litter", "steam",
+            "money", "crashedVehicle", "explosionCloud", "crashSplash", "explosionFlare", "fountain", "balloon", "duck" };
+        for (size_t i = 0; i < entities.size(); ++i)
+            result["entities"][entities[i]] = state.entities.getEntityListCount(static_cast<EntityType>(i));
+        std::array<uint32_t, 8> tiles{};
+        std::array<uint32_t, Limits::kMaxRidesInPark> tracks{};
+        uint32_t water = 0, underground = 0, trees = 0, animatedScenery = 0;
+        for (int y = 0; y < state.mapSize.y; ++y)
+        {
+            for (int x = 0; x < state.mapSize.x; ++x)
+            {
+                auto* element = MapGetFirstElementAt(TileCoordsXY{ x, y });
+                if (element == nullptr)
+                    continue;
+                const auto* surface = MapGetSurfaceElementAt(TileCoordsXY{ x, y });
+                const int surfaceZ = surface ? surface->getBaseZ() : 0;
+                do
+                {
+                    ++tiles[static_cast<size_t>(element->getType())];
+                    if (const auto* surface = element->asSurface())
+                    {
+                        water += surface->getWaterHeight() != 0;
+                    }
+                    if (const auto* scenery = element->asSmallScenery())
+                        if (const auto* entry = scenery->getEntry())
+                        {
+                            trees += entry->flags.has(SmallSceneryFlag::isTree);
+                            animatedScenery += entry->flags.has(SmallSceneryFlag::isAnimated);
+                        }
+                    if (const auto* track = element->asTrack())
+                    {
+                        const auto id = track->getRideIndex().ToUnderlying();
+                        if (id < tracks.size())
+                            ++tracks[id];
+                        underground += track->getBaseZ() < surfaceZ;
+                    }
+                } while (!(element++)->isLastForTile());
+            }
+        }
+        result["tile_elements"] = tiles;
+        result["water_tiles"] = water;
+        result["underground_track_elements"] = underground;
+        result["trees"] = trees;
+        result["animated_small_scenery"] = animatedScenery;
+        std::array<uint32_t, 6> categories{};
+        RideId largest = RideId::GetNull();
+        uint32_t largestTrack = 0;
+        int32_t longest = 0;
+        result["rides"] = json::array();
+        for (const auto& ride : RideManager(state))
+        {
+            const auto& descriptor = GetRideTypeDescriptor(ride.type);
+            const auto cat = static_cast<size_t>(descriptor.Category);
+            if (cat < categories.size())
+                ++categories[cat];
+            result["rides"].push_back({ { "id", ride.id.ToUnderlying() }, { "type", descriptor.Name },
+                { "category", cat }, { "status", static_cast<int>(ride.status) }, { "track_elements", tracks[ride.id.ToUnderlying()] },
+                { "length_fixed", ride.getTotalLength() }, { "trains", ride.numTrains }, { "cars_per_train", ride.numCarsPerTrain },
+                { "x", ride.overallView.x }, { "y", ride.overallView.y } });
+            if (cat != static_cast<size_t>(RideCategory::shop)
+                && (ride.getTotalLength() > longest || (ride.getTotalLength() == longest && tracks[ride.id.ToUnderlying()] > largestTrack)))
+            {
+                largest = ride.id;
+                longest = ride.getTotalLength();
+                largestTrack = tracks[ride.id.ToUnderlying()];
+            }
+        }
+        result["ride_categories"] = categories;
+        std::vector<ScreenCoordsXY> guests, vehicles;
+        result["guest_states"] = json::object();
+        for (const auto* guest : EntityList<Guest>(state.entities))
+        {
+            const auto key = std::to_string(static_cast<int>(guest->state));
+            result["guest_states"][key] = result["guest_states"].value(key, uint32_t{}) + 1;
+            if (guest->x != kLocationNull)
+                guests.push_back(SurveyProject(guest->getLocation(), rotation));
+        }
+        for (const auto* vehicle : EntityList<Vehicle>(state.entities))
+            if (vehicle->ride == largest && vehicle->x != kLocationNull)
+                vehicles.push_back(SurveyProject(vehicle->getLocation(), rotation));
+        std::array<uint32_t, 12> litter{};
+        for (const auto* item : EntityList<Litter>(state.entities))
+            ++litter[static_cast<size_t>(item->subType)];
+        result["litter_types"] = litter;
+        result["crowd_view"] = SurveyDensestView(std::move(guests), 640, 416);
+        result["ride_view"] = SurveyDensestView(std::move(vehicles), 640, 416);
+        result["largest_ride"] = largest.ToUnderlying();
+        return result;
+    }
+}
