--- /dev/null
+++ b/src/openrct2/interface/FarEntityVisibility.h
@@ -0,0 +1,81 @@
+/*****************************************************************************
+ * Copyright (c) 2014-2026 OpenRCT2 developers
+ *
+ * For a complete list of all authors, please refer to contributors.md
+ * Interested in contributing? Visit https://github.com/OpenRCT2/OpenRCT2
+ *
+ * OpenRCT2 is licensed under the GNU General Public License version 3.
+ *****************************************************************************/
+
+#pragma once
+
+#include <cstdint>
+
+namespace OpenRCT2
+{
+    struct FarEntityVisibility
+    {
+        uint32_t windowMicros{}, simulationPictures{}, meanMicros{};
+        uint32_t slowMicros{};
+        uint32_t healthyMicros{}, shownMicros{}, hiddenMicros{}, hiddenEntities{};
+        uint32_t visibleEntities{}, hides{}, releases{};
+        bool automaticHidden{};
+
+        bool WindowDue(uint32_t frameMicros) const
+        {
+            return frameMicros <= 500000 && windowMicros + frameMicros >= 1000000;
+        }
+
+        bool Update(uint32_t frameMicros, bool simulationPicture, uint32_t entities)
+        {
+            // Loads/switching out are not scene pressure. An isolated gap must
+            // neither hide entities nor claim that the scene recovered.
+            if (frameMicros > 500000)
+            {
+                windowMicros = simulationPictures = slowMicros = healthyMicros = 0;
+                return false;
+            }
+            windowMicros += frameMicros;
+            simulationPictures += simulationPicture;
+            if (windowMicros < 1000000)
+                return false;
+            const auto elapsed = windowMicros;
+            windowMicros = 0;
+            if (!simulationPictures)
+                return false;
+            // Extra interpolated pictures spend time but do not reset pressure
+            // or pretend that the simulation has produced another picture.
+            meanMicros = elapsed / simulationPictures;
+            simulationPictures = 0;
+            visibleEntities = entities;
+            if (!automaticHidden)
+            {
+                slowMicros = meanMicros > 50000 ? slowMicros + elapsed : 0;
+                if (slowMicros < 2000000)
+                    return false;
+                shownMicros = meanMicros;
+                hiddenMicros = 0;
+                hiddenEntities = entities;
+                slowMicros = healthyMicros = 0;
+                automaticHidden = true;
+                ++hides;
+                return true;
+            }
+            if (!hiddenMicros || meanMicros < hiddenMicros)
+                hiddenMicros = meanMicros;
+            // Hiding itself improves FPS. Do not immediately undo that saving.
+            // Retain its measured cost, scaled conservatively by the current
+            // on-screen entity population, until the view really gets cheaper.
+            const auto saved = shownMicros > hiddenMicros ? shownMicros - hiddenMicros : 0;
+            const uint64_t estimate = meanMicros + (hiddenEntities
+                ? uint64_t(saved) * entities / hiddenEntities : 0);
+            healthyMicros = estimate < 1000000 / 30 ? healthyMicros + elapsed : 0;
+            if (healthyMicros < 8000000)
+                return false;
+            slowMicros = healthyMicros = 0;
+            automaticHidden = false;
+            ++releases;
+            return true;
+        }
+    };
+}
