+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace OpenRCT2::ViewportCache
+{
+    struct Box
+    {
+        int32_t left, top, right, bottom;
+    };
+
+    // Analyze only roots which can paint the patch. Clipping the root bounds
+    // before inversion tests cannot remove any nonempty intersection in it.
+    // The budget is work, not time: exhausted analysis never yields partial
+    // damage, and the caller replays the complete patch in its original order.
+    class PatchRepair
+    {
+        struct Root { Box box; uint16_t rank; };
+        Box _clip{};
+        size_t _limit = 0;
+        bool _filter = true;
+        bool _exhausted = false;
+        std::vector<Root> _roots;
+        std::vector<uint16_t> _suffix;
+
+        Box Clip(Box box) const
+        {
+            return {std::max(box.left, _clip.left), std::max(box.top, _clip.top),
+                    std::min(box.right, _clip.right), std::min(box.bottom, _clip.bottom)};
+        }
+
+    public:
+        std::vector<Box> damage;
+        size_t pairs = 0, merges = 0, added = 0;
+
+        size_t CapacityBytes() const
+        {
+            return _roots.capacity() * sizeof(Root) + damage.capacity() * sizeof(Box)
+                + _suffix.capacity() * sizeof(uint16_t);
+        }
+
+        void Reset(Box clip, size_t limit, bool filter = true)
+        {
+            _clip = clip; _limit = limit; _filter = filter; _exhausted = false;
+            _roots.clear(); damage.clear(); pairs = merges = added = 0;
+        }
+
+        void Include(Box box, uint16_t rank)
+        {
+            if (_filter) box = Clip(box);
+            if (!_filter || (box.left < box.right && box.top < box.bottom))
+                _roots.push_back({box, rank});
+        }
+
+        void Add(Box box)
+        {
+            box = Clip(box);
+            if (box.left >= box.right || box.top >= box.bottom) return;
+            // Bounding retained scratch as well as comparison work matters in
+            // an adversarial dense column. Ordinary clips use very few boxes.
+            if (_limit != 0 && damage.size() >= 1024) { _exhausted = true; return; }
+            damage.push_back(box); added++;
+        }
+
+        bool Analyze()
+        {
+            // Most map roots keep their retained order. A suffix minimum proves
+            // that an entire outer row has no inversion, without testing every
+            // later pair. Keep the original pair/damage order for actual inversions.
+            _suffix.resize(_roots.size() + 1);
+            _suffix.back() = UINT16_MAX;
+            for (size_t i = _roots.size(); i-- > 0;)
+                _suffix[i] = std::min(_roots[i].rank, _suffix[i + 1]);
+            for (size_t i = 0; i < _roots.size() && !_exhausted; i++)
+            {
+                if (_roots[i].rank <= _suffix[i + 1])
+                    continue;
+                // Bound each inner loop once. Checking the allowance for every
+                // pair adds work to cheap ordinary misses and dense hot loops.
+                const size_t end = _limit == 0 ? _roots.size()
+                    : i + 1 + std::min(_roots.size() - i - 1, _limit - pairs);
+                for (size_t j = i + 1; j < end; j++)
+                {
+                    pairs++;
+                    const auto& a = _roots[i]; const auto& b = _roots[j];
+                    if (a.rank > b.rank)
+                        Add({std::max(a.box.left,b.box.left),std::max(a.box.top,b.box.top),
+                             std::min(a.box.right,b.box.right),std::min(a.box.bottom,b.box.bottom)});
+                    if (_exhausted) break;
+                }
+                if (end < _roots.size()) _exhausted = true;
+            }
+            for (bool merged = true; merged && !_exhausted;)
+            {
+                merged = false;
+                for (size_t i = 0; i < damage.size() && !merged && !_exhausted; i++)
+                {
+                    const size_t end = _limit == 0 ? damage.size()
+                        : i + 1 + std::min(damage.size() - i - 1, _limit - pairs - merges);
+                    for (size_t j = i + 1; j < end; j++)
+                    {
+                        merges++;
+                        auto& a = damage[i]; const auto& b = damage[j];
+                        if (a.left < b.right && b.left < a.right && a.top < b.bottom && b.top < a.bottom)
+                        {
+                            a = {std::min(a.left,b.left),std::min(a.top,b.top),
+                                 std::max(a.right,b.right),std::max(a.bottom,b.bottom)};
+                            damage[j] = damage.back(); damage.pop_back(); merged = true; break;
+                        }
+                    }
+                    if (!merged && end < damage.size()) _exhausted = true;
+                }
+            }
+            return !_exhausted;
+        }
+    };
+
+    // Only bit-2 blocks contain readable ranks. Move runs in memmove order,
+    // including reusable owners in a column which is quiet this frame.
+    // The row-validity plane is still at its old origin when this is called.
+    template<typename Move>
+    size_t ShiftOwnerRows(const std::vector<uint8_t>& valid, int32_t source, int32_t target,
+                          int32_t kept, int32_t blockRows, Move move)
+    {
+        size_t moved = 0;
+        const int32_t begin = source / blockRows, end = (source + kept) / blockRows;
+        if (target <= source)
+        {
+            for (int32_t block = begin; block < end;)
+            {
+                if ((valid[block] & 2) == 0) { block++; continue; }
+                const int32_t first = block;
+                while (block < end && (valid[block] & 2) != 0) block++;
+                const int32_t rows = (block-first) * blockRows;
+                move(first*blockRows, first*blockRows-source+target, rows); moved += rows;
+            }
+        }
+        else
+        {
+            for (int32_t block = end; block > begin;)
+            {
+                if ((valid[block-1] & 2) == 0) { block--; continue; }
+                const int32_t last = block;
+                while (block > begin && (valid[block-1] & 2) != 0) block--;
+                const int32_t rows = (last-block) * blockRows;
+                move(block*blockRows, block*blockRows-source+target, rows); moved += rows;
+            }
+        }
+        return moved;
+    }
+}
