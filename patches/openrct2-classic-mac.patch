+    // context stays fixed throughout this blit; cache its descriptor, not pixels.
+    const auto& occlusion = []() -> decltype(auto) {
+        if constexpr (LocalState)
+            return SpriteOcclusionTarget{ gSpriteOcclusionTarget };
+        else
+            return (gSpriteOcclusionTarget);
+    }();
+    const bool magnify = rt.zoom_level < ZoomLevel{ 0 };
+    const int step = magnify ? 1 : rt.zoom_level.ApplyTo(1);
+    // Clipping supplies positive dimensions. Sampling rounds their coverage up
+    // by a power of two; use the zoom operation instead of two runtime divides.
+    const int width = magnify ? args.Width : rt.zoom_level.ApplyInversedTo(args.Width + step - 1);
+    const int height = magnify ? args.Height : rt.zoom_level.ApplyInversedTo(args.Height + step - 1);
+    const auto offset = args.DestinationBits - occlusion.target;
+    const int x0 = offset % rt.LineStride(), y0 = offset / rt.LineStride();
+    const Owner* plane;
+    if constexpr (sizeof(Owner) == 1) plane = occlusion.owners8;
+    else plane = TBlendOnly ? occlusion.coverage : occlusion.owners;
+    const int planeStride = TBlendOnly ? occlusion.coverageStride : occlusion.ownerStride;
+    for (int y = 0; y < height; y++)
+    {
+        const int sy = magnify ? rt.zoom_level.ApplyTo(args.SrcY + y) : args.SrcY + y * step;
+        const auto* source = reinterpret_cast<const PaletteIndex*>(args.SourceImage.offset) + sy * args.SourceImage.width;
+        auto* dest = args.DestinationBits + y * rt.LineStride();
+        const auto* covering = plane + (y0 + y) * planeStride + x0;
