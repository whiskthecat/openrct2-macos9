+            if (_set->viewport == viewport && (!gPaintViewHistory || SetMatchesView(*_set, *viewport)))
+            {
+                if (create) _set->storageValid = false;
+                return true;
+            }
+            ColumnCacheSet* free = nullptr;
+            ColumnCacheSet* oldest = nullptr;
+            for (size_t i = 0; i < gPaintHistorySets; i++)
+            {
+                auto& set = _columnSets[i];
+                if (set.viewport == viewport && (!gPaintViewHistory
+                    || (set.zoom == viewport->zoom && set.view.rotation == viewport->rotation
+                        && set.view.flags == viewport->flags)))
+                {
+                    _set = &set;
+                    if (create) _set->storageValid = false;
+                    return true;
+                }
+                if (set.viewport == nullptr)
+                    free = free == nullptr ? &set : free;
+                else if (oldest == nullptr || set.lastPainted < oldest->lastPainted)
+                    oldest = &set;
+            }
+            if (!create)
+                return false;
+            _set = free != nullptr ? free : oldest;
+            ColumnCacheClear();
+            _set->viewport = viewport;
+            _set->view = *viewport;
+            _set->zoom = viewport->zoom;
+            _set->refreshCursor = 0;
+            return true;
+        }
+
+        bool ColumnCacheUsable(const Viewport* viewport, const RenderTarget& rt)
+        {
+            if (!gPaintColumnCache || gPaintBoundingBoxes || gTrackDesignSaveMode)
+                return false;
+            if (rt.zoom_level != ZoomLevel{ 0 })
+                return false;
+            // Compact draw extents are signed 16-bit target coordinates. A magnified
+            // view can exceed that range; use the engine painter before roots are
+            // culled by saturated extents or excluded from the static picture.
+            const int64_t targetX = viewport->zoom.ApplyInversedTo<int64_t>(viewport->viewPos.x);
+            const int64_t targetY = viewport->zoom.ApplyInversedTo<int64_t>(viewport->viewPos.y);
+            if (targetX < -32768 || targetY < -32768
+                || targetX + viewport->width > 32767 || targetY + viewport->height > 32767)
+                return false;
+            // Three steps out a column is 4 pixels wide and a view has 200 of them: more
+            // bookkeeping than painting. (Measured on the G3: slower with the cache.)
+            if (viewport->zoom > ZoomLevel{ 2 }
+                && !(gPaintSmallZoom3 && viewport->zoom == ZoomLevel{3} && viewport->height <= 240
+                    && viewport->width / viewport->zoom.ApplyInversedTo(kCoordsXYStep) + 4
+                        <= static_cast<int32_t>(kColumnCacheMaxZoomedOut)))
+                return false;
+            if (!gPaintVisibilityCache && viewport->flags.hasAny(
+                    ViewportFlag::hideSupports, ViewportFlag::undergroundInside,
+                    ViewportFlag::hideRides, ViewportFlag::hideScenery, ViewportFlag::hidePaths))
+                return false;
+            // Invisible rides/scenery/paths have not passed the subject-mode gate.
+            if (viewport->flags.hasAny(ViewportFlag::invisibleRides, ViewportFlag::invisibleScenery, ViewportFlag::invisiblePaths)
+                && (viewport->flags.hasAll(ViewportFlag::hideRides, ViewportFlag::invisibleRides)
+                    || viewport->flags.hasAll(ViewportFlag::hideScenery, ViewportFlag::invisibleScenery)
+                    || viewport->flags.hasAll(ViewportFlag::hidePaths, ViewportFlag::invisiblePaths)))
+                return false;
+            // Other hidden/clipped modes still use the ordinary painter.
+            if (viewport->flags.hasAny(
+                    ViewportFlag::hideVertical, ViewportFlag::hideBase, ViewportFlag::clipView,
+                    ViewportFlag::hideVegetation, ViewportFlag::hideVehicles,
+                    ViewportFlag::hideEntities, ViewportFlag::hideGuests, ViewportFlag::hideStaff,
+                    ViewportFlag::highlightPathIssues, ViewportFlag::transparentBackground))
+                return false;
+            const auto& screen = DrawingEngineGetRT();
+            return rt.bits >= screen.bits && rt.bits < screen.bits + static_cast<size_t>(screen.LineStride()) * screen.height;
+        }
+
+        // Remembers the session as it is now: map entries collected, nothing sorted.
+        void ColumnSnapshot(CachedColumn& column, bool captureLinks = true)
+        {
+            OG_SCOPE_NUMBER(4); // cold study: snapshot (arrangement uses 4 inside sort)
+            auto* session = column.session;
+            column.mapEntryCount = session->paintEntries.size();
+            column.quadrantBack = session->QuadrantBackIndex;
+            column.quadrantFront = session->QuadrantFrontIndex;
+            column.quadrantHeads.clear();
+            column.links.clear();
+            if (column.quadrantBack != std::numeric_limits<uint32_t>::max())
+            {
+                for (uint32_t i = column.quadrantBack; i <= column.quadrantFront; i++)
+                {
+                    column.quadrantHeads.push_back(session->Quadrants[i]);
+                    if (captureLinks)
+                        for (auto* ps = session->Quadrants[i]; ps != nullptr; ps = ps->NextQuadrantEntry)
+                            column.links.emplace_back(ps, ps->NextQuadrantEntry);
+                }
+            }
+            column.entitiesFrame = 0;
+        }
+
+        // Scratch for sorting (see PaintArrangeMerged).
+        std::vector<PaintSortNode> _workNodes, _localMapNodes, _localEntityNodes;
+        InlinePaintNodeStorage<1024> _movingPaintEntries;
+        PaintSession* _patchScratch = nullptr;
+        std::vector<PaintSortNode> _patchNodes;
+        std::vector<PaintStruct*> _patchOldEntries;
+        std::vector<uint16_t> _localMaps, _localEntities;
+        std::vector<uint32_t> _localMask;
+        std::vector<PaintDrawEntry> _localList;
+        constexpr int32_t kColumnBandRows = 32;
+
+        std::pair<int32_t, int32_t> ColumnTilePaintRange(const CachedColumn& column, const CoordsXY& tile)
+        {
+            int32_t top, bottom;
+            if (!TileElementPaintRange(*column.session, tile, top, bottom))
+                return { column.top, column.top };
+            // Construction arrows precede vertical culling and use an unbounded range.
+            // Scale in 64 bits, then clip before subtracting the column origin: both
+            // zooming in and a negative world Y otherwise overflow the row-band math.
+            return {
+                static_cast<int32_t>(std::clamp<int64_t>(column.zoom.ApplyInversedTo<int64_t>(top), column.top, column.bottom)),
+                static_cast<int32_t>(std::clamp<int64_t>(column.zoom.ApplyInversedTo<int64_t>(bottom), column.top, column.bottom))
+            };
+        }
+
+        uint32_t ColumnTileKey(const CoordsXY& tile)
+        {
+            return static_cast<uint32_t>(tile.x / 32 + (tile.y / 32) * 256);
+        }
+
+        uint32_t ColumnDenseTileKey(const CoordsXY& tile)
+        {
+            return uint16_t(tile.x / 32) | (uint32_t(uint16_t(tile.y / 32)) << 16);
+        }
+
+        CoordsXY ColumnDenseTileLocation(uint32_t key)
+        {
+            return {static_cast<int16_t>(key & 0xffff) * 32, static_cast<int16_t>(key >> 16) * 32};
+        }
+
+        std::span<const uint16_t> ColumnTileRoots(const CachedColumn& column, const CoordsXY& tile)
+        {
+            if (!column.denseTiles)
+            {
+                const auto found = column.tileNodes.find(ColumnTileKey(tile));
+                return found == column.tileNodes.end() ? std::span<const uint16_t>{} : found->second;
+            }
+            const uint8_t direction = DirectionFlipXAxis(column.rotation);
+            const auto offset = (tile - column.firstTile).rotate((4 - direction) & 3);
+            const int32_t side = offset.y - offset.x;
+            if (offset.x < 0 || offset.x % 32 != 0 || (side != 0 && side != 32)) return {};
+            const size_t index = static_cast<size_t>(offset.x / 32 * 2 + (side == 32));
+            if (index >= column.tileSlots.size()) return {};
+            const auto& slot = column.tileSlots[index];
+            if (slot.count == 0 || slot.key != ColumnDenseTileKey(tile)) return {};
+            return {column.tileRoots.data() + slot.first, slot.count};
+        }
+
+        std::pair<int32_t, int32_t> ColumnNodeTileRange(const CachedColumn& column, size_t index)
+        {
+            if (!column.denseTiles) return column.tileRanges[index];
+            const auto& slot = column.tileSlots[column.mapNodes[index].GenerateStep / 2];
+            return {slot.top, slot.bottom};
+        }
+
+        bool ColumnDenseTileIndex(CachedColumn& column)
+        {
+            column.denseTiles = false;
+            if (!gPaintCompactColdIndex) return false;
+            const auto& rt = column.fullRT;
+            const uint8_t direction = DirectionFlipXAxis(column.rotation);
+            const ScreenCoordsXY screen{floor2(rt.WorldX(), 32), floor2(rt.WorldY() - 16, 32)};
+            auto tile = CoordsXY{screen.y - screen.x / 2, screen.y + screen.x / 2}.rotate(direction);
+            if (direction & 1) tile.y -= 16;
+            column.firstTile = tile.toTileStart();
+            column.tileSlots.assign(static_cast<size_t>((rt.WorldHeight() + 2128) >> 5) * 2, {});
+            for (const auto& node : column.mapNodes)
+            {
+                const size_t index = node.GenerateStep / 2;
+                if ((node.GenerateStep & 1) != 0 || index >= column.tileSlots.size()) return false;
+                auto& slot = column.tileSlots[index];
+                const auto key = ColumnDenseTileKey(node.ps->MapPos);
+                if (slot.count != 0 && slot.key != key) return false;
+                slot.key = key;
+                slot.count++;
+            }
+            size_t first = 0;
+            for (auto& slot : column.tileSlots)
+            {
+                slot.first = static_cast<uint16_t>(first);
+                first += slot.count;
+                if (slot.count != 0)
+                    std::tie(slot.top, slot.bottom) = ColumnTilePaintRange(column,
+                        ColumnDenseTileLocation(slot.key));
+            }
+            column.tileRoots.resize(column.mapNodes.size());
+            for (size_t i = 0; i < column.mapNodes.size(); i++)
+                column.tileRoots[column.tileSlots[column.mapNodes[i].GenerateStep / 2].first++] = static_cast<uint16_t>(i);
+            for (auto& slot : column.tileSlots) slot.first -= slot.count;
+            column.denseTiles = true;
+            decltype(column.tileNodes){}.swap(column.tileNodes);
+            decltype(column.tileRanges){}.swap(column.tileRanges);
+            return true;
+        }
+
+        int ColumnSignRegionKind(const PaintStruct* ps)
+        {
+            if (ps->InteractionItem == ViewportInteractionItem::ride
+                || ps->InteractionItem == ViewportInteractionItem::parkEntrance) return 0;
+            if (ps->InteractionItem == ViewportInteractionItem::banner) return 1;
+            if (ps->InteractionItem == ViewportInteractionItem::largeScenery) return 2;
+            return -1;
+        }
+
+        bool ColumnSignNeedsOverlay(const CachedColumn& column, const PaintStruct* ps)
+        {
+            const int kind = ColumnSignRegionKind(ps);
+            ScreenRect bounds;
+            if (kind >= 0 && (gPaintSignRegions & (1u << kind)) != 0
+                && Drawing::ScrollingText::gScrollingTextStable
+                && !ps->HasBlend && !ps->HasMasked
+                && PaintStructScrollingBounds(ps, column.zoom, bounds) != 0) return false;
+            return (ps->InteractionItem == ViewportInteractionItem::banner
+                    || ps->InteractionItem == ViewportInteractionItem::largeScenery
+                    || ps->InteractionItem == ViewportInteractionItem::ride
+                    || ps->InteractionItem == ViewportInteractionItem::parkEntrance)
+                && PaintStructScrollingImage(ps) != 0
+                && (gPaintEntranceOverlays
+                    || (ps->InteractionItem != ViewportInteractionItem::ride
+                        && ps->InteractionItem != ViewportInteractionItem::parkEntrance));
+        }
+
+        // The column's map entries as compact sort nodes; the per-entry link table of the long
+        // way is then not needed.
+        void ColumnReserveMapNodes(CachedColumn& column)
+        {
+            if (!gPaintCompactColdIndex || column.mapNodes.capacity() != 0) return;
+            size_t roots = 0;
+            const auto& session = *column.session;
+            if (session.QuadrantBackIndex != std::numeric_limits<uint32_t>::max())
+                for (uint32_t i = session.QuadrantBackIndex; i <= session.QuadrantFrontIndex; i++)
+                    for (auto* ps = session.Quadrants[i]; ps != nullptr; ps = ps->NextQuadrantEntry) roots++;
+            column.mapNodes.reserve(roots);
+        }
+
+        void ColumnCollectNodes(CachedColumn& column, bool alreadySorted = false, bool canonicalOrder = false,
+                                bool* retainedOrder = nullptr)
+        {
+            OG_SCOPE(collect);
+            PAINT_TIMING(columnCollect);
+            SC_SCOPE(nodes);
+            if (retainedOrder != nullptr) *retainedOrder = true;
+            if (!column.mapSelections.empty())
+            {
+                PAINT_TIMING(selectionClear);
+                column.mapSelections.clear();
+            }
+            static const bool longWay = std::getenv("RCT_OLD_ARRANGE") != nullptr; // test: the engine's sort on the entries
+            if (!alreadySorted) ColumnReserveMapNodes(column);
+            if (!alreadySorted)
+            {
+                OG_SCOPE_NUMBER(5); // cold study: map-node collection
+                column.nodesOk = !longWay && PaintCollectNodes(*column.session, column.mapNodes)
+                    && column.mapNodes.size() < 65536;
+            }
+            if (column.nodesOk)
+            {
+                column.links.clear();
+                column.links.shrink_to_fit();
+                if (!alreadySorted) column.entityNodes.clear();
+                std::vector<PaintStruct*> oldOrder;
+                if (!alreadySorted)
+                {
+                    oldOrder.reserve(column.baseList.size());
+                    for (const auto& entry : column.baseList) oldOrder.push_back(entry.ps);
+                }
+                if (!alreadySorted || canonicalOrder)
+                {
+                    PAINT_TIMING(columnArrange);
+                    OG_SCOPE_NUMBER(4);
+                    static const std::vector<PaintSortNode> noEntities;
+                    PaintArrangeMerged(*column.session, column.mapNodes, alreadySorted ? noEntities : column.entityNodes,
+                        _workNodes, column.baseList);
+                }
+                {
+                    PAINT_TIMING(columnOwners);
+                    OG_SCOPE_NUMBER(8);
+                    // Reuse rank nodes for retained roots; allocating every map
+                    // entry again makes a local ghost edit pay for the whole column.
+                    if (gPaintCompactColdSnapshot)
+                        for (auto* ps : oldOrder) ps->CachedBaseRank = UINT16_MAX;
+                    else
+                        for (auto& [ps, rank] : column.ownerBaseOrder) rank = UINT32_MAX;
+                    for (size_t i = 0; i < column.baseList.size(); i++)
+                    {
+                        column.baseList[i].baseRank = static_cast<uint16_t>(i);
+                        if (gPaintCompactColdSnapshot) column.baseList[i].ps->CachedBaseRank = static_cast<uint16_t>(i);
+                        else column.ownerBaseOrder[column.baseList[i].ps] = static_cast<uint32_t>(i);
+                    }
+                    if (!gPaintCompactColdSnapshot)
+                        std::erase_if(column.ownerBaseOrder, [](const auto& entry) {return entry.second == UINT32_MAX;});
+                    for (auto& node : column.mapNodes)
+                    {
+                        node.baseRank = gPaintCompactColdSnapshot ? node.ps->CachedBaseRank
+                            : static_cast<uint16_t>(column.ownerBaseOrder.at(node.ps));
+                        node.moving = column.animatedEntries.count(node.ps) != 0;
+                        // Glyph pixels can extend outside the root's opaque face.
+                        // Draw the complete sign over the retained map picture.
+                        if (ColumnSignNeedsOverlay(column, node.ps))
+                        {
+                            node.moving = true;
+                            column.hasAnimated = true;
+                        }
+                        column.baseList[node.baseRank].moving = node.moving;
+                    }
+                    column.nodesSerial++;
+                    column.blendRevision++;
+                    column.moverRevision++;
+                    column.signNodesSerial++;
+                    if (column.baseList.size() > 255) ColumnOwnersToWords(column);
+                    if (!oldOrder.empty())
+                    {
+                        std::vector<uint16_t> ranks(oldOrder.size() + 1, 0);
+                        for (size_t i = 0; i < oldOrder.size(); i++)
+                        {
+                            if (gPaintCompactColdSnapshot)
+                            {
+                                if (oldOrder[i]->CachedBaseRank != UINT16_MAX)
+                                    ranks[i + 1] = static_cast<uint16_t>(oldOrder[i]->CachedBaseRank + 1);
+                            }
+                            else
+                            {
+                                const auto found = column.ownerBaseOrder.find(oldOrder[i]);
+                                if (found != column.ownerBaseOrder.end()) ranks[i + 1] = static_cast<uint16_t>(found->second + 1);
+                            }
+                        }
+                        if (retainedOrder != nullptr)
+                        {
+                            uint16_t previous = 0;
+                            for (size_t i = 1; i < ranks.size(); i++)
+                                if (ranks[i] != 0)
+                                {
+                                    if (ranks[i] <= previous) *retainedOrder = false;
+                                    previous = ranks[i];
+                                }
+                        }
+                        bool identity = true;
+                        for (size_t i = 1; identity && i < ranks.size(); i++) identity = ranks[i] == i;
+                        // Invalid and colour-only rows have no owner ranks to preserve.
+                        if (!identity) for (size_t block = 0; block < column.pictureRowsValid.size(); block++)
+                            if ((column.pictureRowsValid[block] & 2) != 0)
+                            {
+                                const size_t first = block * kPictureBlockRows * column.width;
+                                const size_t end = std::min(first + kPictureBlockRows * column.width,
+                                                           ColumnOwnerSize(column));
+                                if (column.pictureOwners8.empty())
+                                    for (size_t i = first; i < end; i++)
+                                    {
+                                        const auto owner = column.pictureOwners[i];
+                                        column.pictureOwners[i] = owner < ranks.size() ? ranks[owner] : 0;
+                                    }
+                                else
+                                    for (size_t i = first; i < end; i++)
+                                    {
+                                        const auto owner = column.pictureOwners8[i];
+                                        column.pictureOwners8[i] = owner < ranks.size() ? static_cast<uint8_t>(ranks[owner]) : 0;
+                                    }
+                            }
+                    }
+                }
+                {
+                    PAINT_TIMING(columnBands);
+                    OG_SCOPE_NUMBER(9);
+                    const int32_t bandCount = (column.bottom - column.top + kColumnBandRows - 1) / kColumnBandRows;
+                    column.bands.assign(static_cast<size_t>(std::max(bandCount, 0)),
+                                        std::vector<uint32_t>((column.mapNodes.size() + 31) / 32, 0));
+                    const bool dense = ColumnDenseTileIndex(column);
+                    if (!dense)
+                    {
+                        column.tileSlots.clear();
+                        column.tileRoots.clear();
+                        column.tileRanges.clear();
+                        for (auto& [tile, indices] : column.tileNodes) indices.clear();
+                    }
+                    for (size_t i = 0; i < column.mapNodes.size(); i++)
+                    {
+                        const auto& node = column.mapNodes[i];
+                        const auto& tile = node.ps->MapPos;
+                        int32_t top, bottom;
+                        if (dense)
+                        {
+                            std::tie(top, bottom) = ColumnNodeTileRange(column, i);
+                        }
+                        else
+                        {
+                            auto& indices = column.tileNodes[ColumnTileKey(tile)];
+                            if (indices.empty()) std::tie(top, bottom) = ColumnTilePaintRange(column, tile);
+                            else
+                            {
+                                top = column.tileRanges[indices.front()].first;
+                                bottom = column.tileRanges[indices.front()].second;
+                            }
+                            indices.push_back(static_cast<uint16_t>(i));
+                            column.tileRanges.emplace_back(top, bottom);
+                        }
+                        const int32_t first = std::max<int32_t>(0, (top - column.top) / kColumnBandRows);
+                        const int32_t last = std::min<int32_t>(bandCount - 1, (bottom - 1 - column.top) / kColumnBandRows);
+                        for (int32_t band = first; band <= last; band++)
+                            column.bands[static_cast<size_t>(band)][i / 32] |= uint32_t{1} << (i & 31);
+                    }
+                    // Keep capacities only for tiles still in the column, so a
+                    // long pan cannot grow the per-tile table without bound.
+                    std::erase_if(column.tileNodes, [](const auto& entry) { return entry.second.empty(); });
+                }
+            }
+            else
+            {
+                column.mapNodes.clear();
+                column.mapNodes.shrink_to_fit();
+            }
+        }
+
+        void ColumnClearQuadrants(PaintSession& session)
+        {
+            if (session.QuadrantBackIndex != std::numeric_limits<uint32_t>::max())
+                for (uint32_t i = session.QuadrantBackIndex; i <= session.QuadrantFrontIndex; i++)
+                    session.Quadrants[i] = nullptr;
+            session.QuadrantBackIndex = std::numeric_limits<uint32_t>::max();
+            session.QuadrantFrontIndex = 0;
+        }
