+// --- The same sort on compact copies ---------------------------------------------------
+// Sorting a cached column again every frame (its entities have moved) used to mean linking
+// and walking thousands of 88-byte paint entries. The entries' sort fields are copied once
+// into small nodes; each frame the column's map nodes and that frame's entity nodes are merged
+// into the order the quadrant lists would have, and the engine's own sort (the templates
+// above) runs on the nodes. The paint entries themselves are not touched.
+static void PaintStructFindExtent(PaintStruct* ps, ZoomLevel zoom);
+
+template<bool TStableSort, int TRotation> static PaintSortNode* PaintArrangeNodesImpl(PaintSortNode* first, uint32_t back, uint32_t front)
+{
+    PaintSortNode head{};
+    head.NextQuadrantEntry = first;
+    uint32_t quadrantIndex = back;
+    PaintSortNode* next = PaintArrangeStructsHelperRotation<TStableSort, TRotation, PaintSortNode>(
+        &head, static_cast<uint16_t>(back), PaintSortFlags::Neighbour);
+    while (++quadrantIndex < front)
+        next = PaintArrangeStructsHelperRotation<TStableSort, TRotation, PaintSortNode>(
+            next, static_cast<uint16_t>(quadrantIndex), PaintSortFlags::None);
+    return head.NextQuadrantEntry;
+}
