+    {
+        gScreenshotCountdown = gScreenshotJobs.empty() || Remaining(gScreenshotJobs.front()) != 0
+            ? 0 : gScreenshotJobs.front().countdown;
+    }
+
+    void LogScreenshotRequest(const ScreenshotJob& job)
+    {
+        std::printf("screenshot request id=%lu name=\"%s\" delay_ms=%lu\n",
+            static_cast<unsigned long>(job.id), Path::GetFileName(job.path).c_str(),
+            static_cast<unsigned long>(job.delayMs));
+    }
+
+    void ScreenshotFailed(const ScreenshotJob& job, const char* reason)
+    {
+        gScreenshotBatchFailed = true;
+        const auto name = Path::GetFileName(job.path);
+        std::printf("screenshot failed id=%lu name=\"%s\" reason=\"%s\"\n",
+            static_cast<unsigned long>(job.id), name.c_str(), reason);
+        Formatter ft;
+        ft.Add<const utf8*>(name.c_str());
+        // Keep a failed request visible even if another capture is queued.
+        ContextShowError(STR_SCREENSHOT_FAILED, STR_STRING, ft, false);
+    }
+}
+
+static void ScreenshotSaved(const ScreenshotJob& job, const std::string& screenshotPath)
+{
+    const auto filename = Path::GetFileName(screenshotPath);
+    std::printf("screenshot saved id=%lu name=\"%s\"\n",
+        static_cast<unsigned long>(job.id), filename.c_str());
+    Audio::Play(Audio::SoundId::windowOpen, 100, ContextGetWidth() / 2);
+    Formatter ft;
+    ft.Add<StringId>(STR_STRING);
+    ft.Add<const utf8*>(filename.c_str());
+    // A later success in a burst must not erase the burst's persistent failure.
+    if (!gScreenshotBatchFailed)
+        ContextShowError(STR_SCREENSHOT_SAVED_AS, kStringIdNone, ft, true);
+}
