+    static void ViewportPaintPlain(const Viewport* viewport, RenderTarget& worldRT);
+
+    namespace
+    {
+        struct SeeThroughLens
+        {
+            const Viewport* viewport = nullptr;
+            Viewport view{};
+            ScreenCoordsXY cursor{};
+            int32_t radius = 64;
+            bool dither = false;
+        } _seeThroughLens;
+
+        ScreenRect LensBounds(const ScreenCoordsXY& centre, int32_t radius)
+        {
+            return {centre - ScreenCoordsXY{radius, radius}, centre + ScreenCoordsXY{radius + 1, radius + 1}};
+        }
+    }
+
+    bool ViewportLensContainsPixel(const ScreenCoordsXY& point, const ScreenCoordsXY& centre, int32_t radius, bool dither)
+    {
+        // Screen anchored 2x2 ordered coverage: 100%, 75%, 50%, 25%.
+        // Only the inner six pixels of the existing radius change.
+        constexpr int32_t inset[2][2] = {{0, 3}, {6, 2}};
+        if (dither) radius -= inset[point.y & 1][point.x & 1];
+        const auto delta = point - centre;
+        return delta.x * delta.x + delta.y * delta.y <= radius * radius;
+    }
+
+    void ViewportToggleSeeThroughLens()
+    {
+        Config::Get().interface.seeThroughLens = !Config::Get().interface.seeThroughLens;
+        Config::Save();
+    }
+
+    void ViewportUpdateSeeThroughLens(const ScreenCoordsXY& cursor)
+    {
+        const auto* window = WindowGetMain();
+        const auto* viewport = window != nullptr ? window->viewport : nullptr;
+        const auto& config = Config::Get().interface;
+        const bool active = config.seeThroughLens && viewport != nullptr && ViewportFindFromPoint(cursor) == viewport;
+        auto& old = _seeThroughLens;
+        const int32_t radius = std::clamp(config.seeThroughLensRadius, 16, 128);
+        const bool movedView = old.viewport != nullptr && viewport != nullptr
+            && (old.view.viewPos != viewport->viewPos || old.view.pos != viewport->pos
+                || old.view.zoom != viewport->zoom || old.view.rotation != viewport->rotation
+                || old.view.width != viewport->width || old.view.height != viewport->height
+                || old.view.flags != viewport->flags);
+        if (old.viewport == (active ? viewport : nullptr)
+            && (!active || (old.cursor == cursor && old.radius == radius && old.dither == config.ditheredLensEdge))
+            && !movedView)
+            return;
+        if (old.viewport != nullptr)
+        {
+            ::GfxSetDirtyBlocks(LensBounds(old.cursor, old.radius));
+            // Scroll copied the already-composited lens along with the park.
+            // Repair that displaced footprint after the damage-grid translation.
+            if (old.viewport == viewport && old.view.zoom == viewport->zoom && old.view.rotation == viewport->rotation)
+            {
+                const auto shift = viewport->pos - old.view.pos + ScreenCoordsXY{
+                    viewport->zoom.ApplyInversedTo(old.view.viewPos.x) - viewport->zoom.ApplyInversedTo(viewport->viewPos.x),
+                    viewport->zoom.ApplyInversedTo(old.view.viewPos.y) - viewport->zoom.ApplyInversedTo(viewport->viewPos.y)};
+                if (shift != ScreenCoordsXY{}) ::GfxSetDirtyBlocks(LensBounds(old.cursor + shift, old.radius));
+            }
+        }
+        old.viewport = active ? viewport : nullptr;
+        old.cursor = cursor;
+        old.radius = radius;
+        old.dither = config.ditheredLensEdge;
+        if (active)
+        {
+            old.view = *viewport;
+            ::GfxSetDirtyBlocks(LensBounds(cursor, radius));
+        }
+    }
