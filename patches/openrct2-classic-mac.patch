new file mode 100644
index 0000000..108e115
--- /dev/null
+++ b/src/openrct2/entity/EntityProjection.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include "EntityPresentationProbe.h"
+#include "../world/Location.hpp"
+#include "../interface/ScreenCoords.hpp"
+#include <array>
+#include <cassert>
+
+namespace OpenRCT2
+{
+    ScreenCoordsXY Translate3DTo2DWithZ(int32_t rotation, const CoordsXYZ& pos);
+
+    // One existing invalidation endpoint, one call chain. The visibility guard
+    // supplies the anchor it already computed only when it accepts a viewport.
+    // No entity ID, location, sprite bounds or viewport rectangle is retained.
+    class EntityProjection
+    {
+        // Uninitialized until remember() sets a valid rotation.
+        std::array<int32_t, 2> _screen;
+        uint8_t _rotation = 255;
+
+    public:
+        EntityProjection() = default;
+        EntityProjection(const EntityProjection&) = delete;
+        EntityProjection& operator=(const EntityProjection&) = delete;
+        void remember(uint8_t rotation, const ScreenCoordsXY& screen)
+        {
+            assert(rotation < 4);
+            _screen = {screen.x, screen.y};
+            _rotation = rotation;
+        }
+        ScreenCoordsXY project(uint8_t rotation, const CoordsXYZ& location) const
+        {
+            assert(rotation < 4);
+            if (rotation == _rotation)
+            {
+                if (PresentationProbe::enabled) PresentationProbe::stats.endpointHits++;
+                return {_screen[0], _screen[1]};
+            }
+            if (PresentationProbe::enabled) PresentationProbe::stats.endpointMisses++;
+            return Translate3DTo2DWithZ(rotation, location);
+        }
+    };
+}
