--- /dev/null
+++ b/src/openrct2/core/OgTrace.h
@@ -0,0 +1,27 @@
+#pragma once
+// Opt-in, register-preserving instruction markers for the private RCT1 study.
+// No timer, allocation, game-state access or runtime switch on the measured path.
+namespace OpenRCT2::Og
+{
+    enum Stage { none, collect, sort, blit, dirty, ui, present, guest, vehicle, simulation, paint,
+        tweenPopulate=12, tweenPost, tweenRestore, tweenMove, tweenReset, entityFlush };
+    template<int Id> inline __attribute__((always_inline)) void Marker()
+    {
+#ifdef OPENRCT2_OG_TRACE
+#if defined(__powerpc__)
+        __asm__ volatile("rlwimi %0,%0,0,0,31" : : "i"(Id) : "memory");
+#elif defined(__x86_64__)
+        __asm__ volatile(".byte 0x0f,0x1f,0x84,0x00\n.long %c0" : : "i"(0x0abc0000 + Id) : "memory");
+#endif
+#endif
+    }
+    template<int Id> struct Scope
+    {
+        Scope() { if constexpr (Id != 0) Marker<Id>(); }
+        ~Scope() { if constexpr (Id != 0) Marker<31>(); }
+    };
+}
+#define OG_JOIN_(a,b) a##b
+#define OG_JOIN(a,b) OG_JOIN_(a,b)
+#define OG_SCOPE(stage) ::OpenRCT2::Og::Scope<::OpenRCT2::Og::stage> OG_JOIN(ogScope_,__LINE__)
+#define OG_SCOPE_NUMBER(id) ::OpenRCT2::Og::Scope<(id)> OG_JOIN(ogProbe_,__LINE__)
