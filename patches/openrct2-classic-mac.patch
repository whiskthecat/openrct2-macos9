+        for (auto* live : EntityList<T>())
+        {
+            Entity_t copy;
+            std::memcpy(&copy, live, sizeof(Entity_t));
+            if constexpr (std::is_base_of_v<Peep, T>)
+            {
+                auto& peep = *reinterpret_cast<T*>(&copy);
+                if (live->name)
+                {
+                    _peepNames.emplace_back(live->name);
+                    peep.name = _peepNames.back().data();
+                }
+                if constexpr (std::is_same_v<T, Staff>)
+                {
+                    if (live->patrolInfo)
+                    {
+                        auto area = live->patrolInfo->toVector();
+                        auto& h = _history[live->id.ToUnderlying()];
+                        h.patrolAt = _patrols.GetLength(); h.patrols = area.size();
+                        _patrols.Write(area.data(), area.size() * sizeof(TileCoordsXY));
+                        peep.patrolInfo = nullptr;
+                    }
+                }
+            }
+            if constexpr (std::is_same_v<T, Guest>)
+            {
+                auto& h = _history[live->id.ToUnderlying()];
+                if (auto* v = RideUse::GetHistory().GetAll(live->id))
+                {
+                    h.rideAt = _rideHistory.GetLength(); h.rides = v->size();
+                    _rideHistory.Write(v->data(), v->size() * sizeof(RideId));
+                }
+                if (auto* v = RideUse::GetTypeHistory().GetAll(live->id))
+                {
+                    h.typeAt = _typeHistory.GetLength(); h.types = v->size();
+                    _typeHistory.Write(v->data(), v->size() * sizeof(ObjectEntryIndex));
+                }
+            }
+            _entitySnapshot.Write(&copy, sizeof(copy));
+            _entityCounts[EnumValue(T::kEntityType)]++;
+        }
+    }
+
+    uint64_t ParkFile::Capture(GameState_t& state)
+    {
+        // This method never yields or advances logic. Everything consulted by a
+        // later Step is owned here, including pointer-backed names/patrols and
+        // histories which do not live in GameState. No copied pointer is later
+        // dereferenced into the live park.
+        _frozen = true;
+        _mapSize = state.mapSize;
+        const auto& tiles = state.tileElements;
+        const auto& pointers = GetTileElementPointers();
+        _tileBase = reinterpret_cast<uintptr_t>(tiles.data());
+        _tileSnapshot.Write(tiles.data(), tiles.size() * sizeof(TileElement));
+        _tilePointers.Write(pointers.data(), pointers.size() * sizeof(TileElement*));
+
+        // One reservation prevents repeated realloc/copy as entities are frozen.
+        size_t count = 0;
+        for (unsigned t = 0; t < EnumValue(EntityType::count); t++) count += state.entities.getEntityListCount(static_cast<EntityType>(t));
+        _entitySnapshot = MemoryStream((count + 32) * sizeof(Entity_t));
+        FreezeEntities<Vehicle>(); FreezeEntities<Guest>(); FreezeEntities<Staff>(); FreezeEntities<Litter>();
+        FreezeEntities<SteamParticle>(); FreezeEntities<MoneyEffect>(); FreezeEntities<VehicleCrashParticle>();
+        FreezeEntities<ExplosionCloud>(); FreezeEntities<CrashSplashParticle>(); FreezeEntities<ExplosionFlare>();
+        FreezeEntities<JumpingFountain>(); FreezeEntities<Balloon>(); FreezeEntities<Duck>();
+        _os = std::make_unique<OrcaStream>(_sink, OrcaStream::Mode::writing, 0, true);
+        auto& os = *_os;
+        auto& header = os.getHeader();
+        header.magic = kParkFileMagic; header.targetVersion = kParkFileCurrentVersion; header.minVersion = kParkFileMinVersion;
+        ReadWriteAuthoringChunk(os); ReadWriteObjectsChunk(os); ReadWriteBannersChunk(state, os);
+        ReadWriteScenarioChunk(state, os); ReadWriteGeneralChunk(state, os); ReadWriteParkChunk(state, os);
+        ReadWriteClimateChunk(state, os); ReadWriteResearchChunk(state, os); ReadWriteNotificationsChunk(state, os);
+        ReadWriteInterfaceChunk(state, os); ReadWriteCheatsChunk(state, os); ReadWriteRestrictedObjectsChunk(state, os);
+        ReadWritePluginStorageChunk(state, os); ReadWritePreviewChunk(state, os);
+        // Object files are immutable inputs. Copy repository descriptors now;
+        // open/read their payloads in bounded batches after capture. Park loads
+        // and context teardown drain the job before destroying its sources.
+        for (const auto* ori : ExportObjectsList)
+        {
+            const auto extension = Path::GetExtension(ori->Path);
+            const bool parkobj = String::iequals(extension, ".parkobj");
+            if (parkobj || String::iequals(extension, ".dat"))
+                _objects.push_back({ori->Path, ori->Identifier, ori->ObjectEntry, 0, parkobj});
+        }
+        ExportObjectsList.clear();
+        _frozenRides.reserve(RideManager(state).size());
+        uint64_t rideBytes = 0;
+        for (const auto& ride : RideManager(state)) if (ride.measurement) rideBytes += sizeof(RideMeasurement);
+        _measurements = MemoryStream(rideBytes);
+        _measurementOffsets.reserve(_frozenRides.capacity());
+        for (const auto& ride : RideManager(state))
+        {
+            _frozenRides.push_back(ride.snapshotForSave(false));
+            _measurementOffsets.push_back(ride.measurement ? _measurements.GetLength() : UINT32_MAX);
+            if (ride.measurement) _measurements.Write(ride.measurement.get(), sizeof(RideMeasurement));
+        }
+        _tileWork.reserve(64);
+        // Allocate the canonical stream once, while it is still small, so a
+        // later guest/tile batch never relocates several MiB on one picture.
+        _writeReserve = os.writePosition() + _tileSnapshot.GetLength() + rideBytes * 4 + _frozenRides.size() * sizeof(Ride) * 2
+            + _entitySnapshot.GetLength() * 2 + (_rideHistory.GetLength() + _typeHistory.GetLength() + _patrols.GetLength()) * 4 + 65536;
+        return sizeof(ParkFile) + _tileSnapshot.GetCapacity() + _tilePointers.GetCapacity() + _entitySnapshot.GetCapacity()
+            + rideBytes + _frozenRides.capacity() * sizeof(Ride) + _tileWork.capacity() * sizeof(TileElement) + _rideHistory.GetCapacity() + _typeHistory.GetCapacity() + _patrols.GetCapacity()
+            + os.writeCapacity();
+    }
+
+    template<typename T> bool ParkFile::EncodeEntities(unsigned& budget)
+    {
+        if (!_groupStarted)
+        {
+            _partial->write(T::kEntityType); _partial->write(_entityCounts[EnumValue(T::kEntityType)]);
+            _groupStarted = true;
+        }
+        while (_entityCursor < _entityCounts[EnumValue(T::kEntityType)] && budget)
+        {
+            Entity_t copy;
+            _entitySnapshot.Read(&copy, sizeof(copy));
+            auto& ent = *reinterpret_cast<T*>(&copy);
+            _partial->write(ent.id); ReadWriteEntity(*_os, *_partial, ent);
+            _entityCursor++; budget--;
+        }
+        if (_entityCursor < _entityCounts[EnumValue(T::kEntityType)]) return false;
+        _entityCursor = 0; _groupStarted = false; _entityGroup++; return true;
+    }
+
+    bool ParkFile::Step(MemoryStream& body, MemoryStream& prefix)
+    {
+        auto& os = *_os;
+        if (_writeReserve)
+        {
+            os.reserveWrite(_writeReserve); _writeReserve = 0;
+            return false; // A large Toolbox allocation gets its own picture.
+        }
+        if (!_objectsSized)
+        {
+            if (_objectCursor < _objects.size())
+            {
+                auto& object = _objects[_objectCursor++];
+                FileStream file(object.path, FileMode::open);
+                if (file.GetLength() > UINT32_MAX) throw IOException("Packed object is too large");
+                object.bytes = file.GetLength(); _packedBytes += object.bytes + object.identifier.size() + 32;
+                return false;
+            }
+            if (_packedBytes)
+            {
+                if (ClassicHost::Memory().free < _packedBytes * 2 + os.writeCapacity() + 4 * 1024 * 1024)
+                    throw IOException("Not enough memory to include custom objects; previous saves are intact");
+                os.reserveWrite(os.writeCapacity() + _packedBytes);
+            }
+            _objectCursor = 0; _objectsSized = true;
+        }
+        if (_stage == 0)
+        {
+            if (!_partial)
+            {
+                _partial = os.startWriteChunk(EnumValue(ParkFileChunkType::titles));
+                _partial->write(_mapSize.x); _partial->write(_mapSize.y);
+                _tileCountAt = os.writePosition(); _partial->write(uint32_t(0)); _tileBodyAt = os.writePosition();
+            }
+            const auto* pointers = static_cast<TileElement* const*>(_tilePointers.GetData());
+            const auto end = std::min(_tileCursor + 256, size_t(kMaximumMapSizeTechnical) * kMaximumMapSizeTechnical);
+            for (; _tileCursor < end; _tileCursor++)
+            {
+                auto& tile = _tileWork; tile.clear();
+                // The pointer is an address token only. Convert it against the
+                // captured base; play may have moved/freed the original vector.
+                const auto token = reinterpret_cast<uintptr_t>(pointers[_tileCursor]);
+                if (token)
+                {
+                    const auto offset = token - _tileBase;
+                    if (offset >= _tileSnapshot.GetLength()) throw IOException("Invalid frozen tile pointer");
+                    const auto* el = reinterpret_cast<const TileElement*>(static_cast<const uint8_t*>(_tileSnapshot.GetData()) + offset);
+                    do { if (!el->isGhost()) tile.push_back(*el); } while (!(el++)->isLastForTile());
+                }
+                if (tile.empty())
+                {
+                    TileElement el{}; el.clearAs(TileElementType::surface);
+                    el.baseHeight = el.clearanceHeight = 14;
+                    // The default surface's remaining fields are zero, as in Map.cpp.
+                    tile.push_back(el);
+                }
+                tile.back().setLastForTile(true);
+                for (auto& el : tile)
+                {
+                    if (auto* track = el.asTrack(); track && !track->getRideIndex().IsNull())
+                    {
+                        const auto id = track->getRideIndex().ToUnderlying();
+                        if (id < _seenRides.size()) _seenRides[id] = true;
+                    }
+                    TileElementHostLEInPlace(el, false);
+                }
+                _partial->write(tile.data(), tile.size() * sizeof(TileElement));
+                _tileCount += tile.size();
+                if ((_tileCursor + 1) % kMaximumMapSizeTechnical == 0)
+                    _tileRowEnds[_tileCursor / kMaximumMapSizeTechnical] = os.writePosition();
+            }
+            if (_tileCursor == size_t(kMaximumMapSizeTechnical) * kMaximumMapSizeTechnical)
+            {
+                const uint32_t padding = kStockMapSize * kStockMapSize - kMaximumMapSizeTechnical * kMaximumMapSizeTechnical;
+                os.patchValue(_tileCountAt, _tileCount + padding); _tileBodyEnd = os.writePosition();
+                os.endWriteChunk(); _partial.reset();
+                _tileSnapshot = MemoryStream(); _tilePointers = MemoryStream(); _stage++;
+            }
+            return false;
+        }
+        if (_stage == 1)
+        {
+            if (!_partial)
+            {
+                _partial = os.startWriteChunk(EnumValue(ParkFileChunkType::rides));
+                _partial->beginWriteArray();
+            }
+            if (_rideCursor < _frozenRides.size())
+            {
+                auto& ride = _frozenRides[_rideCursor++];
+                if (!OmitTracklessRides || _seenRides[ride.id.ToUnderlying()])
+                {
+                    const auto offset = _measurementOffsets[_rideCursor - 1];
+                    auto* measurement = offset == UINT32_MAX ? nullptr
+                        : const_cast<RideMeasurement*>(reinterpret_cast<const RideMeasurement*>(static_cast<const uint8_t*>(_measurements.GetData()) + offset));
+                    _partial->write(ride.id); ReadWriteRide(os, *_partial, ride, measurement); _partial->nextWriteArray();
+                }
+                ride = Ride{}; // Return that record's names/measurement in this batch.
+                return false;
+            }
+            _partial->endWriteArray(); os.endWriteChunk(); _partial.reset();
+            _frozenRides.clear(); _measurements = MemoryStream(); _measurementOffsets.clear();
+            _stage++; return false;
+        }
+        if (_stage == 2)
+        {
+            if (!_partial)
+            {
+                _entitySnapshot.SetPosition(0);
+                _partial = os.startWriteChunk(EnumValue(ParkFileChunkType::entities));
+            }
+            unsigned budget = 16;
+#define FROZEN_GROUP(n, T) if (_entityGroup == n && !EncodeEntities<T>(budget)) return false
+            FROZEN_GROUP(0, Vehicle); FROZEN_GROUP(1, Guest); FROZEN_GROUP(2, Staff); FROZEN_GROUP(3, Litter);
+            FROZEN_GROUP(4, SteamParticle); FROZEN_GROUP(5, MoneyEffect); FROZEN_GROUP(6, VehicleCrashParticle);
+            FROZEN_GROUP(7, ExplosionCloud); FROZEN_GROUP(8, CrashSplashParticle); FROZEN_GROUP(9, ExplosionFlare);
+            FROZEN_GROUP(10, JumpingFountain); FROZEN_GROUP(11, Balloon); FROZEN_GROUP(12, Duck);
+#undef FROZEN_GROUP
+            os.endWriteChunk(); _partial.reset(); _stage++;
+            _entitySnapshot = MemoryStream(); _peepNames.clear();
+            _rideHistory = MemoryStream(); _typeHistory = MemoryStream(); _patrols = MemoryStream();
+            return false;
+        }
+        if (_stage == 3)
+        {
+            if (_objects.empty()) { _stage++; return false; }
+            if (!_partial)
+            {
+                _partial = os.startWriteChunk(EnumValue(ParkFileChunkType::packedObjects));
+                _partial->write(uint32_t(_objects.size()));
+            }
+            if (_objectCursor == _objects.size())
+            {
+                os.endWriteChunk(); _partial.reset(); _objects.clear(); _stage++; return false;
+            }
+            auto& object = _objects[_objectCursor];
+            if (!_objectFile)
+            {
+                _objectFile = std::make_unique<FileStream>(object.path, FileMode::open);
+                if (_objectFile->GetLength() != object.bytes) throw IOException("Packed object changed during save");
+                _partial->write(uint8_t(object.parkobj ? 1 : 0));
+                if (object.parkobj) _partial->write(object.identifier);
+                else { auto entry = object.entry; StoredLEInPlace(entry); _partial->write(&entry, sizeof(entry)); }
+                _partial->write(object.bytes);
+                return false;
+            }
+            std::array<uint8_t, 8192> data;
+            const auto size = std::min<uint64_t>(data.size(), object.bytes - _objectFile->GetPosition());
+            _objectFile->Read(data.data(), size); _partial->write(data.data(), size);
+            if (_objectFile->GetPosition() == object.bytes) { _objectFile.reset(); _objectCursor++; }
+            return false;
+        }
+        // Stock OpenRCT2 always indexes a 1001-square technical grid. Keep only
+        // our 256-square bytes in RAM; stream canonical default surfaces into
+        // the compressor for the remaining cells. Offsets describe that stream.
+        const uint64_t padding = uint64_t(kStockMapSize * kStockMapSize - kMaximumMapSizeTechnical * kMaximumMapSizeTechnical) * sizeof(TileElement);
+        body = os.releaseUncompressed(prefix, EnumValue(ParkFileChunkType::titles), padding);
+        _os.reset();
+        uint64_t logical = 0;
+        auto add = [&](uint64_t bytes, uint64_t physical, bool pad) {
+            logical += bytes; _segments.push_back({logical, physical, pad});
+        };
+        _segments.reserve(kMaximumMapSizeTechnical * 2 + 3);
+        add(_tileBodyAt, 0, false);
+        uint64_t physical = _tileBodyAt;
+        for (const auto end : _tileRowEnds)
+        {
+            add(end - physical, physical, false); physical = end;
+            add((kStockMapSize - kMaximumMapSizeTechnical) * sizeof(TileElement), 0, true);
+        }
+        add(uint64_t(kStockMapSize - kMaximumMapSizeTechnical) * kStockMapSize * sizeof(TileElement), 0, true);
+        add(body.GetLength() - _tileBodyEnd, _tileBodyEnd, false);
+        TileElement surface{}; surface.clearAs(TileElementType::surface);
+        surface.baseHeight = surface.clearanceHeight = 14; surface.setLastForTile(true);
+        TileElementHostLEInPlace(surface, false); std::memcpy(_defaultTile.data(), &surface, sizeof(surface));
+        return true;
+    }
+#endif
