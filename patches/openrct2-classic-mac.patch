+static bool PaintDrawMovingOverMapImpl(PaintSession& session, const std::vector<PaintDrawEntry>& list)
+{
+    const RenderTarget clip = session.rt;
+    const int32_t clipLeft = clip.x, clipTop = clip.y, clipRight = clip.x + clip.width, clipBottom = clip.y + clip.height;
+    struct Box
+    {
+        int32_t left, top, right, bottom;
+    };
+    constexpr int kMaxBoxes = 48;
+    Box boxes[kMaxBoxes];
+    int boxShown[kMaxBoxes];
+    int boxCount = 0;
+    const auto visible = [&](const PaintDrawEntry& entry) {
+        return entry.bottom > clipTop && entry.top < clipBottom && entry.right > clipLeft && entry.left < clipRight;
+    };
+    // One pass over the column's list picks out what this rectangle shows; the rest of the work
+    // only looks at those.
+    constexpr int kMaxShown = 192;
+    const PaintDrawEntry* shown[kMaxShown];
+    int shownCount = 0;
+    bool anyMoving = false;
+    for (const auto& entry : list)
+    {
+        if (!visible(entry))
+            continue;
+        if (shownCount == kMaxShown)
+        {
+            gPaintMovingFallbacks++;
+            return false;
+        }
+        shown[shownCount++] = &entry;
+        anyMoving = anyMoving || entry.moving;
+    }
+    if (!anyMoving)
+        return true;
+    // Where are the moving things?
+    for (int index = 0; index < shownCount; index++)
+    {
+        const auto& entry = *shown[index];
+        if (!entry.moving)
+            continue;
+        if (boxCount == kMaxBoxes)
+        {
+            gPaintMovingFallbacks++;
+            return false;
+        }
+        boxShown[boxCount] = index;
+        boxes[boxCount++] = { std::max<int32_t>(entry.left, clipLeft), std::max<int32_t>(entry.top, clipTop),
+                              std::min<int32_t>(entry.right, clipRight), std::min<int32_t>(entry.bottom, clipBottom) };
+    }
+    if (boxCount == 0)
+        return true;
+    const auto touches = [](const PaintDrawEntry& entry, const Box& box) {
+        return entry.bottom > box.top && entry.top < box.bottom && entry.right > box.left && entry.left < box.right;
+    };
+    // The picture underneath already contains every map entry. Drawing an opaque one again changes
+    // nothing, but a translucent one (water, glass) would be applied twice. A box touched by a
+    // translucent map entry is therefore "wet": everything in it is drawn again from the back,
+    // which is right whatever was there. Wet boxes that overlap are merged so that no translucent
+    // pixel is drawn twice.
+    bool wet[kMaxBoxes]{};
+    bool anyWet = false;
+    const bool orderedVisibilityRepair = gPaintVisibilityRepairs && gPaintOrderedBlends
+        && session.ViewFlags.hasAny(ViewportFlag::hideRides, ViewportFlag::hideScenery, ViewportFlag::hidePaths);
+    for (int index = 0; index < shownCount; index++)
+    {
+        const auto& entry = *shown[index];
+        if (entry.moving || !entry.blend)
+            continue;
+        for (int i = 0; i < boxCount; i++)
+            // Glass already behind a mover is part of its retained background.
+            // Only a later filter needs the interleaved repair from the back.
+            if ((!orderedVisibilityRepair || index > boxShown[i]) && touches(entry, boxes[i]))
+                wet[i] = anyWet = true;
+    }
+    // Wet areas, kept apart from the per-entity boxes.
+    Box wetBoxes[kMaxBoxes];
+    int wetCount = 0;
+    if (anyWet)
+    {
+        for (int i = 0; i < boxCount; i++)
+            if (wet[i])
+                wetBoxes[wetCount++] = boxes[i];
+        for (bool merged = true; merged;)
+        {
+            merged = false;
+            for (int i = 0; i < wetCount && !merged; i++)
+                for (int j = i + 1; j < wetCount && !merged; j++)
+                {
+                    Box& a = wetBoxes[i];
+                    const Box& b = wetBoxes[j];
+                    if (a.left < b.right && b.left < a.right && a.top < b.bottom && b.top < a.bottom)
+                    {
+                        a = { std::min(a.left, b.left), std::min(a.top, b.top), std::max(a.right, b.right),
+                              std::max(a.bottom, b.bottom) };
+                        wetBoxes[j] = wetBoxes[--wetCount];
+                        merged = true;
+                    }
+                }
+        }
+        // A merged area may have grown onto translucent entries its parts did not touch; that is
+        // fine (they are drawn once, from the back, like everything else in it), but it may also
+        // have grown onto further boxes, which the in-order pass below handles.
+    }
+    const auto drawIn = [&](PaintStruct* ps, const Box& box) {
+        if (box.right <= box.left || box.bottom <= box.top)
+            return;
+        RenderTarget part = clip;
+        part.bits = clip.bits + (box.top - clip.y) * clip.LineStride() + (box.left - clip.x);
+        part.pitch = clip.pitch + (clip.width - (box.right - box.left));
+        part.x = box.left;
+        part.y = box.top;
+        part.width = box.right - box.left;
+        part.height = box.bottom - box.top;
+        session.rt = part;
+        PaintDrawStruct(session, ps);
+    };
+    const auto inside = [](const Box& inner, const Box& outer) {
+        return inner.left >= outer.left && inner.right <= outer.right && inner.top >= outer.top && inner.bottom <= outer.bottom;
+    };
+    if (session.ViewFlags.hasAny(ViewportFlag::undergroundInside, ViewportFlag::hideSupports,
+            ViewportFlag::hideRides, ViewportFlag::hideScenery, ViewportFlag::hidePaths))
+    {
+        // These modes can leave transparent terrain/glass in the copied map.
+        // Start blend repairs from the ordinary background, not that already filtered picture.
+        const auto background = session.ViewFlags.has(ViewportFlag::undergroundInside)
+            ? PaletteIndex::pi10 : PaletteIndex::transparent;
+        for (int i = 0; i < wetCount; i++)
+        {
+            const auto& box = wetBoxes[i];
+            for (int32_t y = box.top; y < box.bottom; y++)
+                std::fill_n(clip.bits + (y-clip.y)*clip.LineStride() + box.left-clip.x,
+                    box.right-box.left, background);
+        }
+    }
+    int active = 0;
+    for (int index = 0; index < shownCount; index++)
+    {
+        const auto& entry = *shown[index];
+        PaintStruct* const ps = entry.ps;
+        if (entry.moving)
+        {
+            session.rt = clip;
+            if (ps->Moving)
+                gPaintDrawnEntityEntries++;
+            else
+                gPaintDrawnMapEntries++;
+            PaintDrawStruct(session, ps);
+            active++;
+            continue;
+        }
+        // Map entry: again in every wet area it touches...
+        for (int i = 0; i < wetCount; i++)
+            if (touches(entry, wetBoxes[i]))
+            {
+                gPaintDrawnMapEntries++;
+                drawIn(ps, wetBoxes[i]);
+            }
+        if (entry.blend)
+            continue; // translucent entries only ever go into wet areas
+        // ...and over each moving thing already drawn (unless a wet area covers that box anyway).
+        for (int i = 0; i < active; i++)
+        {
+            if (wet[i] || !touches(entry, boxes[i]))
+                continue;
+            bool covered = false;
+            for (int k = 0; k < wetCount && !covered; k++)
+                covered = inside(boxes[i], wetBoxes[k]);
+            if (covered)
+                continue;
+            gPaintDrawnMapEntries++;
+            drawIn(ps, boxes[i]);
+        }
+    }
+    session.rt = clip;
+    return true;
+}
