+                    : entity.ps->Entity->type == EntityType::guest || entity.ps->Entity->type == EntityType::staff ? 0
+                    : entity.ps->Entity->type == EntityType::vehicle ? 1 : 2;
+            else if (entity.ps->Element != nullptr)
+                kind = 3 + (static_cast<unsigned>(entity.ps->Element->getType()) & 7);
+            unsigned sprites = 0;
+            for (const auto* part = entity.ps; part != nullptr; part = part->Children)
+            {
+                sprites++;
+                for (const auto* attached = part->Attached; attached != nullptr; attached = attached->NextEntry)
+                    sprites++;
+            }
+            if (kind == 5)
+            {
+                const auto* track = entity.ps->Element->asTrack();
