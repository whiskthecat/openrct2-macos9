+#include <cstdint>
+#ifdef OPENRCT2_PERF_METRICS
+#include <algorithm>
+#include <vector>
+namespace OpenRCT2::Perf
+{
+    enum Source { unknown, guestMoved, guestPose, guestUnchanged, vehicles, otherEntity, map, ui,
+        strip, toolbar, parkPanel, datePanel, otherWindow, clock, sourceCount };
+    enum Kind { otherSprite, guestSprite, vehicleSprite, terrainSprite, scenerySprite, uiSprite, baseCopy, kindCount };
+    inline bool enabled = false, pixelsEnabled = false;
+    inline Source source = unknown;
+    inline Kind kind = uiSprite;
+    inline uint64_t dirtyCalls[sourceCount]{}, dirtyPixels[sourceCount]{}, guestChanges[4]{};
+    inline uint64_t spriteCalls[kindCount]{}, spriteBoxes[kindCount]{}, spriteTicks[kindCount]{}, writes[kindCount]{}, canvasWrites[kindCount]{};
+    inline uint64_t repeatedWrites = 0, tracedFrames = 0, scrollWindows[256]{};
+    enum HudReason { hudOther, hudTooltip, hudClimate, hudGuestCount, hudRating, hudDate, hudCash, hudReasonCount };
+    inline HudReason hudReason = hudOther;
+    inline uint64_t hudCalls[256][hudReasonCount]{}, hudPixels[256][hudReasonCount]{};
+    inline uint64_t hudWidgetCalls[256]{};
+    inline uint64_t tooltipVisits = 0, tooltipSame = 0;
+    struct HudReasonScope { HudReason previous; explicit HudReasonScope(HudReason r) : previous(hudReason) { hudReason = r; }
+        ~HudReasonScope() { hudReason = previous; } };
+    inline void HudDirty(unsigned window, int l, int t, int r, int b, int w, int h, bool widget = false)
+    {
+        if (!enabled || window >= 256) return;
+        l = std::max(0, l); t = std::max(0, t); r = std::min(w, r); b = std::min(h, b);
+        if (l >= r || t >= b) return;
+        hudCalls[window][hudReason]++; hudPixels[window][hudReason] += uint64_t(r-l) * (b-t);
+        hudWidgetCalls[window] += widget;
+    }
+    inline uintptr_t canvas = 0;
+    inline size_t canvasBytes = 0;
+    inline std::vector<uint8_t> touched;
+    struct SourceScope { Source previous; explicit SourceScope(Source s) : previous(source) { source = s; }
+        ~SourceScope() { source = previous; } };
+    struct KindScope { Kind previous; explicit KindScope(Kind k) : previous(kind) { kind = k; }
+        ~KindScope() { kind = previous; } };
+    inline void Dirty(int l, int t, int r, int b, int w, int h, Source fallback)
+    {
+        if (!enabled) return;
+        l = std::max(0, l); t = std::max(0, t); r = std::min(w, r); b = std::min(h, b);
+        if (l >= r || t >= b) return;
+        auto s = source == unknown ? fallback : source;
+        dirtyCalls[s]++; dirtyPixels[s] += uint64_t(r-l) * (b-t);
+    }
+    inline void Write(const void* destination, size_t length = 1)
+    {
+        if (!pixelsEnabled) return;
+        writes[kind] += length;
+        const auto at = reinterpret_cast<uintptr_t>(destination);
+        if (at < canvas || at - canvas >= canvasBytes || length > canvasBytes - (at-canvas)) return;
+        canvasWrites[kind] += length;
+        for (size_t i = at-canvas; i < at-canvas+length; ++i)
+        {
+            repeatedWrites += touched[i] != 0;
+            touched[i] = 1;
+        }
+    }
+    inline void Frame(void* bits, size_t bytes)
+    {
+        if (!enabled) return;
+        canvas = reinterpret_cast<uintptr_t>(bits); canvasBytes = bytes;
+        if (pixelsEnabled) touched.assign(bytes, 0);
+        tracedFrames++;
+    }
+}
+#define PERF_WRITE(dst, length) ::OpenRCT2::Perf::Write(dst, length)
+#else
+#define PERF_WRITE(dst, length)
+#endif
