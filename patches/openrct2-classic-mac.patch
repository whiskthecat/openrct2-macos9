+// Apply the same bitmap sampling and palette rules as the ordinary blitter,
+// with the cached map owner/coverage planes deciding which pixels may be drawn.
+// This also handles bitmap construction sprites under translucent water.
+template<DrawBlendOp TBlendOp, bool TBlendOnly, typename Owner = uint16_t, bool LocalState = false>
+static void DrawBMPSpriteOccluded(RenderTarget& rt, const DrawSpriteArgs& args)
