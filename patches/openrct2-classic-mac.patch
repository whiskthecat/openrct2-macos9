+    }
+    if (gPaintClock != nullptr)
+        gSpriteRasterCacheStats.ownerMicros += gPaintClock() - checked;
+    gSpriteRasterCacheStats.ownerRestores += restored;
+    gSpriteRasterCacheStats.ownerPasses++;
+    return true;
