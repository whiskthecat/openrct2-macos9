diff --git a/src/openrct2/core/CachePrefetch.h b/src/openrct2/core/CachePrefetch.h
new file mode 100644
index 0000000..a72521c
--- /dev/null
+++ b/src/openrct2/core/CachePrefetch.h
@@ -0,0 +1,28 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+namespace OpenRCT2
+{
+    inline void CachePrefetch(const void* address)
+    {
+#if defined(__powerpc__) || defined(__ppc__)
+        asm volatile("dcbt 0,%0" : : "r"(address));
+#else
+        (void)address;
+#endif
+    }
+
+    // Each touched line intersects the valid byte range, even for partial rows.
+    inline void CachePrefetchRange(const void* address, int32_t bytes)
+    {
+        if (bytes <= 0)
+            return;
+        const auto* first = static_cast<const uint8_t*>(address);
+        CachePrefetch(first);
+        const auto line = reinterpret_cast<uintptr_t>(first) & ~uintptr_t{31};
+        const auto last = reinterpret_cast<uintptr_t>(first + bytes - 1) & ~uintptr_t{31};
+        for (auto next = line + 32; next <= last; next += 32)
+            CachePrefetch(reinterpret_cast<const void*>(next));
+    }
+}
