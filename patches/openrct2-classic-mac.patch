+namespace
+{
+    template<typename TBox> inline bool DirectInFront(uint8_t rotation, const TBox& a, const TBox& b)
+    {
+        switch (rotation & 3)
+        {
+            case 0: return CheckBoundingBox<0>(a, b);
+            case 1: return CheckBoundingBox<1>(a, b);
+            case 2: return CheckBoundingBox<2>(a, b);
+            default: return CheckBoundingBox<3>(a, b);
+        }
+    }
+    // The order two nodes have before any box comparison moves them (see PaintArrangeSelected).
+    template<typename TNode> inline bool DirectBefore(const TNode& a, bool aEntity, const TNode& b, bool bEntity)
+    {
+        if (a.QuadrantIndex != b.QuadrantIndex)
+            return a.QuadrantIndex < b.QuadrantIndex;
+        if (aEntity && !bEntity)
+            return a.GenerateStep >= b.GenerateStep;
+        if (!aEntity && bEntity)
+            return b.GenerateStep < a.GenerateStep;
+        return a.GenerateStep < b.GenerateStep;
+    }
+    // True when `front` is drawn after (over) `back`: what the sort does with this pair alone.
+    // The later node of the two stays in front unless the earlier one's box comparison pulls
+    // it behind, which the sort only tries within one quadrant step.
+    template<typename TNode>
+    inline bool DirectOver(uint8_t rotation, const TNode& front, bool frontEntity, const TNode& back, bool backEntity)
+    {
+        if (DirectBefore(back, backEntity, front, frontEntity))
+            return front.QuadrantIndex > back.QuadrantIndex + 1 || !DirectInFront(rotation, back.Bounds, front.Bounds);
+        return back.QuadrantIndex <= front.QuadrantIndex + 1 && DirectInFront(rotation, front.Bounds, back.Bounds);
+    }
