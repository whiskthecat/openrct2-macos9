+        {
+            using U = EndianRaw<T>;
+            U result = 0;
+            for (size_t i = sizeof(T); i-- > 0;)
+            {
+                result = static_cast<U>((sizeof(T) > 1 ? result << 8 : 0) | bytes[i]);
+            }
+            return static_cast<T>(result);
+        }
+        constexpr LittleEndian& operator=(T value) noexcept
+        {
+            using U = EndianRaw<T>;
