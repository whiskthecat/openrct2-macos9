diff --git a/src/openrct2/core/ScopeProbe.h b/src/openrct2/core/ScopeProbe.h
new file mode 100644
index 0000000..ab54acc
--- /dev/null
+++ b/src/openrct2/core/ScopeProbe.h
@@ -0,0 +1,120 @@
+#pragma once
+// Lightweight timing probes for machines where no profiler is available (the G3).
+// PROBE_SCOPE(Name) at the top of a function charges the time until the scope ends to that
+// name, exclusive of any probed scopes entered inside it, using the processor's free-running
+// counter (PowerPC time base). Always compiled in; costs one test per scope until switched on.
+#include <cstdint>
+#include "OgTrace.h"
+
+namespace OpenRCT2::Probe
+{
+    enum Id : uint8_t
+    {
+        Other,
+        GameLogicRest,
+        PeepUpdateAllRest,
+        GuestUpdateRest,
+        GuestWalking,
+        GuestQueuing,
+        PeepNextAction,
+        PeepUpdateAction,
+        PeepLevelCrossing,
+        PathFinding,
+        StaffUpdate,
+        EntityMoveTo,
+        EntityInvalidate,
+        EntitySpatialIndex,
+        VehicleUpdateAllRest,
+        VehicleTrackMotionTrain,
+        VehicleTrackMotionCar,
+        RideUpdateAll,
+        RideRatings,
+        MapAnimations,
+        MiscEntities,
+        MapUpdateTiles,
+        PathWideFlags,
+        ParkUpdate,
+        SpatialPass,
+        RideMeasurements,
+        Sounds,
+        VehicleSounds,
+        CrowdNoise,
+        GuestTick128,
+        RideMusicChannels,
+        RideMusicInstance,
+        SoundVolume,
+        SoundPan,
+        ViewportsMayShow,
+        ViewportInvalidate,
+        ColumnCacheMapChanged,
+        ColumnCacheRideChanged,
+        DirtyBlocks,
+        Count
+    };
+    constexpr int OgStage(Id id)
+    {
+        switch (id)
+        {
+            case GameLogicRest: return Og::simulation;
+            case PeepUpdateAllRest: return Og::guest;
+            case VehicleUpdateAllRest: return Og::vehicle;
+            case EntityInvalidate: case ViewportInvalidate: case DirtyBlocks: return Og::dirty;
+            default: return Og::none;
+        }
+    }
+    extern const char* const kNames[Count];
+    extern uint64_t gTicks[Count];
+    extern uint32_t gCalls[Count];
+    extern bool gEnabled;
+    extern uint8_t gCurrent;
+    extern uint32_t gLastStamp;
+
+    inline uint32_t Stamp()
+    {
+#if defined(__powerpc__) || defined(__POWERPC__) || defined(__ppc__)
+        uint32_t ticks;
+        __asm__ volatile("mftb %0" : "=r"(ticks));
+        return ticks;
+#elif defined(__x86_64__) || defined(__i386__)
+        return static_cast<uint32_t>(__builtin_ia32_rdtsc() >> 6);
+#else
+        return 0;
+#endif
+    }
+
+    struct Scope
+    {
+        uint8_t previous;
+        explicit Scope(uint8_t id)
+        {
+            if (!gEnabled)
+            {
+                previous = 0xFF;
+                return;
+            }
+            // Viewport invalidation also runs while painting; capture only simulation work.
+            if (gCurrent == Other && id != GameLogicRest)
+            {
+                previous = 0xFF;
+                return;
+            }
+            const uint32_t now = Stamp();
+            gTicks[gCurrent] += now - gLastStamp;
+            gLastStamp = now;
+            previous = gCurrent;
+            gCurrent = id;
+            gCalls[id]++;
+        }
+        ~Scope()
+        {
+            if (previous == 0xFF)
+                return;
+            const uint32_t now = Stamp();
+            gTicks[gCurrent] += now - gLastStamp;
+            gLastStamp = now;
+            gCurrent = previous;
+        }
+    };
+} // namespace OpenRCT2::Probe
+
+#define PROBE_SCOPE(name) OG_SCOPE_NUMBER(::OpenRCT2::Probe::OgStage(::OpenRCT2::Probe::name)); ::OpenRCT2::Probe::Scope probeScope_(::OpenRCT2::Probe::name)
diff --git a/src/openrct2/core/ScrollTrace.h b/src/openrct2/core/ScrollTrace.h
new file mode 100644
index 0000000..d8fb713
--- /dev/null
+++ b/src/openrct2/core/ScrollTrace.h
@@ -0,0 +1,28 @@
+#pragma once
+// Opt-in measurement scopes; compiled out of normal and native builds.
+namespace OpenRCT2::ScrollTrace {
+enum Stage { setup=1, build, shift, patch, freshPicture, repairPicture, localList,
+    owner, copy, gloom, entities, mapInvalidation, entityInvalidation, tick,
+    ui, present, input, windows, plain, nodes, metadata=29 };
+template<int Id> inline __attribute__((always_inline)) void Mark() {
+#ifdef OPENRCT2_SCROLL_TRACE
+#if defined(__powerpc__)
+    __asm__ volatile("rlwimi %0,%0,0,0,31" : : "i"(Id) : "memory");
+#elif defined(__x86_64__)
+    __asm__ volatile(".byte 0x0f,0x1f,0x84,0x00\n.long %c0" : : "i"(0x0abc0000 + Id) : "memory");
+#endif
+#endif
+}
+struct InvalidationScope {
+    explicit InvalidationScope(bool entity) {
+#ifdef OPENRCT2_SCROLL_TRACE
+        if (entity) Mark<entityInvalidation>(); else Mark<mapInvalidation>();
+#endif
+    }
+    ~InvalidationScope() { Mark<31>(); }
+};
+template<int Id> struct Scope { Scope(){Mark<Id>();} ~Scope(){Mark<31>();} };
+}
+#define SC_JOIN_(a,b) a##b
+#define SC_JOIN(a,b) SC_JOIN_(a,b)
+#define SC_SCOPE(id) ::OpenRCT2::ScrollTrace::Scope<::OpenRCT2::ScrollTrace::id> SC_JOIN(scrollTrace_,__LINE__)
