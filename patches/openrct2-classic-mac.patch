+            for (uint32_t n = moverIndex == 0 ? 0 : _directOverEnds[moverIndex - 1]; n < _directOverEnds[moverIndex]; n++)
+                const_cast<uint16_t*>(ownerRanks)[_directOverOwners[n]] = 0xffff;
+        }
+        const auto restoreRanks = [&] {
+            if (direct)
+                for (uint32_t n = moverIndex == 0 ? 0 : _directOverEnds[moverIndex - 1]; n < _directOverEnds[moverIndex]; n++)
+                    const_cast<uint16_t*>(ownerRanks)[_directOverOwners[n]] = 0;
+        };
