+            continue;
+        }
+        if (gSpriteOcclusionEnabled)
+        {
+            const auto* covering = owners + (clip.y - pictureY) * pictureWidth + clip.x - pictureX;
+            const uint16_t* words = nullptr;const uint8_t* bytes = nullptr;
+            if constexpr (sizeof(Owner) == 1) bytes = covering;else words = covering;
+            gSpriteOcclusionTarget = { clip.bits, words,
+                ownerRanks, clip.LineStride(), pictureWidth, mapIndex, false,
+                hasForegroundBlend ? coverage.data() : nullptr, clip.width, false, bytes };
+        }
+        {
+            PAINT_TIMING(moverDraw);
+            PaintDrawStruct(session, entity.ps);
+        }
+        const bool clipped = gSpriteOcclusionEnabled && !gSpriteOcclusionTarget.unhandled;
+        gSpriteOcclusionTarget = {};
+        if (clipped)
+        {
+            restoreRanks();
+            continue;
+        }
+        for (int y = top; y < bottom; y++)
+        {
+            const size_t start = static_cast<size_t>(y - pictureY) * pictureWidth + left - pictureX;
+            const auto* source = picture + start;
+            const auto* covering = owners + start;
+            auto* dst = clip.bits + (y - clip.y) * clip.LineStride() + left - clip.x;
+            for (int x = 0; x < right - left; x++)
+                if ((ownerRanks != nullptr ? ownerRanks[covering[x]] : covering[x]) > mapIndex)
+                {
+                    dst[x] = source[x];
+                    if (_staffPass != StaffPass::none)
+                        gSpriteOwnerTarget.owners[dst + x - gSpriteOwnerTarget.pixels] = 0;
+                    restored++;
+                }
+        }
+        restoreRanks();
+    }
+    if (hasForegroundBlend)
+    {
+        const bool clipVisibilityBlend = gPaintVisibilityRepairs && gPaintCompactMoving && gPaintOrderedBlends;
+        mapIndex = 0;
+        const size_t blendCount = gPaintCompactMoving ? blendEntries.size() : list.size();
+        for (size_t i = 0; i < blendCount; i++)
+        {
+            const auto& map = gPaintCompactMoving ? *blendEntries[i].entry : list[i];
+            if (map.moving)
+                continue;
+            if (gPaintCompactMoving)
+                mapIndex = blendEntries[i].mapIndex;
+            else
+                mapIndex++;
+            if (!map.blend)
+                continue;
+            if constexpr (TRepair)
+                if (std::binary_search(repair->entries.begin(), repair->entries.end(), &map))
+                    continue;
+            if (clipVisibilityBlend)
+            {
+                // The coverage plane can only contain pixels within a mover's
+                // conservative whole-sprite extent. Keep the original plane
+                // origin and stride while clipping the glass draw to movers
+                // earlier than this root. No pixel outside this union's bounds
+                // could pass its coverage test.
+                int32_t left = clip.x + clip.width, top = clip.y + clip.height;
+                int32_t right = clip.x, bottom = clip.y;
+                for (const auto& moving : movingEntries)
+                {
+                    if (moving.listIndex >= blendEntries[i].listIndex)
+                        break;
+                    const auto& entity = *moving.entry;
+                    const int32_t l = std::max<int32_t>({clip.x, map.left, entity.left});
+                    const int32_t t = std::max<int32_t>({clip.y, map.top, entity.top});
+                    const int32_t r = std::min<int32_t>({clip.x + clip.width, map.right, entity.right});
+                    const int32_t b = std::min<int32_t>({clip.y + clip.height, map.bottom, entity.bottom});
+                    if (l < r && t < b)
+                    {
+                        left = std::min(left, l); top = std::min(top, t);
+                        right = std::max(right, r); bottom = std::max(bottom, b);
+                    }
+                }
+                if (left >= right || top >= bottom)
+                    continue;
+                auto rt = clip;
+                rt.bits += (top - clip.y) * clip.LineStride() + left - clip.x;
+                rt.x = left; rt.y = top;
+                rt.width = right - left; rt.height = bottom - top;
+                rt.pitch = clip.LineStride() - rt.width;
+                session.rt = rt;
+            }
+            const auto* covering = owners + (clip.y - pictureY) * pictureWidth + clip.x - pictureX;
+            const uint16_t* words = nullptr;const uint8_t* bytes = nullptr;
+            if constexpr (sizeof(Owner) == 1) bytes = covering;else words = covering;
+            gSpriteOcclusionTarget = { clip.bits, words,
+                ownerRanks, clip.LineStride(), pictureWidth, mapIndex, false, coverage.data(), clip.width, true, bytes };
+            gPaintDrawnMapEntries++;
+            PaintDrawStruct(session, map.ps);
+            gSpriteOcclusionTarget = {};
+            session.rt = clip;
+        }
+    }
+    if constexpr (TRepair)
+    {
+        for (const auto& box : repair->boxes)
+        {
+            auto rt = clip;
+            rt.bits += (box.top - clip.y) * clip.LineStride() + box.left - clip.x;
+            rt.x = box.left; rt.y = box.top;
+            rt.width = box.right - box.left; rt.height = box.bottom - box.top;
+            rt.pitch = clip.LineStride() - rt.width;
+            session.rt = rt;
+            GfxClear(rt, session.ViewFlags.has(ViewportFlag::undergroundInside)
+                ? PaletteIndex::pi10 : PaletteIndex::transparent);
