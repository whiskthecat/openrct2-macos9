diff --git a/src/openrct2/paint/Paint.Staff.h b/src/openrct2/paint/Paint.Staff.h
new file mode 100644
index 0000000..ae22423
--- /dev/null
+++ b/src/openrct2/paint/Paint.Staff.h
@@ -0,0 +1,114 @@
+#pragma once
+
+// Private painter implementation, included after Paint.cpp's drawing/entity imports.
+
+// Only pixels whose final opaque contributor is a guest may be replaced, and
+// only by a staff pixel surviving the same renderer with guests omitted. This
+// preserves every non-guest occluder; a global staff-last sort cannot do that.
+namespace
+{
+    enum class StaffPass { none, normal, withoutGuests };
+    StaffPass _staffPass = StaffPass::none;
+    bool _staffDrawing = false;
+
+    uint16_t StaffContributor(const PaintStruct* ps)
+    {
+        if (!ps->Moving || ps->InteractionItem != ViewportInteractionItem::entity || ps->Entity == nullptr)
+            return 0;
+        switch (ps->Entity->type)
+        {
+            case EntityType::guest: return 1;
+            case EntityType::staff: return 2;
+            default: return 0;
+        }
+    }
+
+    struct StaffScratch
+    {
+        std::vector<PaletteIndex> seed, normal, withoutGuests;
+        std::vector<uint16_t> normalOwners, staffOwners;
+    } _staffScratch;
+
+    template<typename TDraw>
+    bool PaintWithStaffPriority(PaintSession& session, const std::vector<PaintDrawEntry>& list, TDraw draw)
+    {
+        if (_staffDrawing || !Config::Get().interface.staffOverGuests || gSpriteOwnerTarget.pixels != nullptr)
+            return draw();
+        const auto clip = session.rt;
+        int32_t left = clip.x + clip.width, top = clip.y + clip.height, right = clip.x, bottom = clip.y;
+        for (size_t i = 0; i < list.size(); ++i)
+        {
+            const auto& staff = list[i];
+            if (StaffContributor(staff.ps) != 2 || staff.right <= clip.x || staff.left >= clip.x + clip.width
+                || staff.bottom <= clip.y || staff.top >= clip.y + clip.height)
+                continue;
+            // Later guests alone can hide this staff root. Extents include
+            // children and attachments, at this viewport's zoom and rotation.
+            for (size_t j = i + 1; j < list.size(); ++j)
+            {
+                const auto& guest = list[j];
+                if (StaffContributor(guest.ps) != 1)
+                    continue;
+                const int32_t l = std::max<int32_t>({clip.x, staff.left, guest.left});
+                const int32_t t = std::max<int32_t>({clip.y, staff.top, guest.top});
+                const int32_t r = std::min<int32_t>({clip.x + clip.width, staff.right, guest.right});
+                const int32_t b = std::min<int32_t>({clip.y + clip.height, staff.bottom, guest.bottom});
+                if (l < r && t < b)
+                {
+                    left = std::min(left, l); top = std::min(top, t);
+                    right = std::max(right, r); bottom = std::max(bottom, b);
+                }
+            }
+        }
+        if (left >= right || top >= bottom)
+            return draw();
+        const int32_t width = right - left, height = bottom - top;
+        const size_t count = static_cast<size_t>(width) * height;
+        // Reused, bounded by this column's current repaint. Nothing persists
+        // with the cached map picture or its owner identities.
+        auto& [seed, normal, withoutGuests, normalOwners, staffOwners] = _staffScratch;
+        seed.resize(count);
+        for (int32_t y = 0; y < height; ++y)
+            std::copy_n(clip.bits + (top - clip.y + y) * clip.LineStride() + left - clip.x,
+                width, seed.data() + static_cast<size_t>(y) * width);
+        struct DrawingScope
+        {
+            DrawingScope() { _staffDrawing = true; }
+            ~DrawingScope() { _staffDrawing = false; _staffPass = StaffPass::none; }
+        } scope;
+        const bool result = draw();
+        if (!result)
+            return false;
+        normal = seed;
+        withoutGuests = seed;
+        normalOwners.assign(count, 0);
+        staffOwners.assign(count, 0);
+        auto scratch = clip;
+        scratch.x = left; scratch.y = top; scratch.width = width; scratch.height = height; scratch.pitch = 0;
+        const auto replay = [&](StaffPass pass, std::vector<PaletteIndex>& pixels, std::vector<uint16_t>& owners) {
+            _staffPass = pass;
+            scratch.bits = pixels.data();
+            session.rt = scratch;
+            gSpriteOwnerTarget = {pixels.data(), owners.data(), 0, false};
+            const bool ok = draw();
+            gSpriteOwnerTarget = {};
+            session.rt = clip;
+            return ok;
+        };
+        if (replay(StaffPass::normal, normal, normalOwners)
+            && replay(StaffPass::withoutGuests, withoutGuests, staffOwners))
+        {
+            for (int32_t y = 0; y < height; ++y)
+            {
+                auto* dest = clip.bits + (top - clip.y + y) * clip.LineStride() + left - clip.x;
+                for (int32_t x = 0; x < width; ++x)
+                {
+                    const size_t i = static_cast<size_t>(y) * width + x;
+                    if (normalOwners[i] == 1 && staffOwners[i] == 2)
+                        dest[x] = withoutGuests[i];
+                }
+            }
+        }
+        return true;
+    }
+}
