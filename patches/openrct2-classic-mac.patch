new file mode 100644
index 0000000..a7ca10f
--- /dev/null
+++ b/src/openrct2/core/FrameTiming.h
@@ -0,0 +1,98 @@
+#pragma once
+// Always-on picture timing. Fixed storage; no allocations or file writes on a normal frame.
+#include <cstdint>
+#include "OgTrace.h"
+
+namespace OpenRCT2::FrameTiming
+{
+    enum Stage { messages, wait, simulation, input, windows, draw, autosave, sounds, calendar, remote, log, count };
+    extern const char* const names[count];
+    struct Frame
+    {
+        uint64_t number = 0, presentedAtUs = 0;
+        uint32_t us = 0, medianUs = 0, baselineUs = 0, tick = 0, ticks = 0, tickCalls = 0;
+        uint32_t stage[count]{};
+        uint32_t yieldCalls = 0, yieldUs = 0, yieldMaxUs = 0, coarseYields = 0, eventMask = 0;
+        uint32_t paintUs = 0, presentUs = 0, pumpUs = 0, paletteUs = 0, readbackUs = 0;
+        uint32_t columns = 0, patches = 0, shifts = 0, paletteSets = 0;
+        uint32_t columnBuildUs = 0, columnShiftUs = 0, basePictureUs = 0, patchPictureUs = 0;
+        uint32_t reads = 0, readBytes = 0, readUs = 0, writes = 0, writeBytes = 0, writeUs = 0;
+        uint32_t allocations = 0, allocationBytes = 0, heapCalls = 0, heapUs = 0;
+        uint32_t autosaves = 0, days = 0, weeks = 0, months = 0, opened = 0, windowClass = 0;
+        uint32_t calendarWeekUs = 0, calendarAwardUs = 0, scoreScanUs = 0, scenarioEndUs = 0;
+        uint32_t audioPumpUs = 0;
+        uint32_t commands = 0, actions = 0, weatherChanges = 0, weather = 0, news = 0, lightning = 0;
+        uint32_t month = 0, monthTick = 0, zoom = 0;
+        bool diskAvailable = false, allocationsAvailable = false, hitch = false;
+        char command[24]{};
+    };
+    constexpr unsigned historySize = 128, worstSize = 8, binCount = 12;
+    extern const uint32_t binUpperUs[binCount];
+    struct Statistics
+    {
+        uint64_t frames = 0, hitches = 0, sumUs = 0;
+        double sumSquaredUs = 0;
+        uint32_t medianUs = 25000, maximumUs = 0;
+        uint32_t medianByTicks[2]{25000, 25000};
+        uint64_t histogram[binCount]{}, ticksHistogram[13]{};
+        Frame history[historySize]{}, worst[worstSize]{};
+    };
+    extern Statistics stats;
+    extern Frame current;
+    extern uint64_t (*clock)();
+    extern void (*sample)(Frame&);
+    extern bool presented;
+    extern void (*observe)(const Frame&);
+    // Collection, AUTO's frame durations and observer callbacks are unconditional.
+    // Only automatic text output is controlled here. Immediate is a diagnostic control.
+    enum class HitchReporting { off, limited, immediate };
+    struct HitchReportStatistics
+    {
+        uint64_t printed = 0, coalesced = 0, reportUs = 0;
+        bool pending = false;
+    };
+    void SetHitchReporting(HitchReporting mode);
+    HitchReporting GetHitchReporting();
+    HitchReportStatistics GetHitchReportStatistics();
+    void Reset();
+    void Finish(uint32_t tick, uint32_t month, uint32_t monthTick);
+    void Command(const char* op);
+    // Rare calendar leaves, measured inside the existing calendar bucket.
+    class DetailScope
+    {
+        uint32_t& _total;
+        uint64_t _start;
+    public:
+        explicit DetailScope(uint32_t& total) : _total(total), _start(clock ? clock() : 0) {}
+        ~DetailScope() { if (clock) _total += static_cast<uint32_t>(clock() - _start); }
+    };
+    class Scope
+    {
+        Stage _stage;
+        uint64_t _start;
+    public:
+        explicit Scope(Stage stage) : _stage(stage), _start(clock ? clock() : 0)
+        {
+#ifdef OPENRCT2_OG_TRACE
+            // Survey-only whole-frame boundaries; ordinary builds emit no markers.
+            switch (stage)
+            {
+#define FRAME_MARK(name) case name: Og::Marker<18 + name>(); break
+                FRAME_MARK(messages); FRAME_MARK(wait); FRAME_MARK(simulation);
+                FRAME_MARK(input); FRAME_MARK(windows); FRAME_MARK(draw);
+                FRAME_MARK(autosave); FRAME_MARK(sounds); FRAME_MARK(calendar);
+                FRAME_MARK(remote); FRAME_MARK(log);
+#undef FRAME_MARK
+                default: break;
+            }
+#endif
+        }
+        ~Scope()
+        {
+#ifdef OPENRCT2_OG_TRACE
+            if (_stage < count) Og::Marker<31>();
+#endif
+            if (clock) current.stage[_stage] += static_cast<uint32_t>(clock() - _start);
+        }
+    };
+}
