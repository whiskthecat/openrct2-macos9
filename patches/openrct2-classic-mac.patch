+    inline ScreenCoordsXY SurveyProject(const CoordsXYZ& p, uint8_t rotation)
+    {
+        const auto r = p.rotate(rotation);
+        return { r.y - r.x, ((r.x + r.y) >> 1) - p.z };
+    }
+
+    // Exact maximum of point positions in a width x height half-open view.
+    // Each optimum can be moved right until its leftmost point meets its edge.
+    inline nlohmann::json SurveyDensestView(std::vector<ScreenCoordsXY> points, int width, int height)
+    {
+        if (points.empty())
+            return { { "x", 0 }, { "y", 0 }, { "points", 0 } };
+        std::sort(points.begin(), points.end(), [](const auto& a, const auto& b) {
+            return a.y < b.y || (a.y == b.y && a.x < b.x);
+        });
+        std::vector<int32_t> xs;
+        for (const auto& p : points)
+            xs.push_back(p.x);
+        std::sort(xs.begin(), xs.end());
+        xs.erase(std::unique(xs.begin(), xs.end()), xs.end());
