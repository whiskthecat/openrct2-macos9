+void PaintArrangeMerged(
+    PaintSession& session, const std::vector<PaintSortNode>& mapNodes, const std::vector<PaintSortNode>& entityNodes,
+    std::vector<PaintSortNode>& work, std::vector<PaintDrawEntry>& list)
+{
+    OG_SCOPE(sort);
+    _directListValid = false;
+    list.clear();
+    work.clear();
+    work.reserve(mapNodes.size() + entityNodes.size());
+    gPaintNodesSorted += mapNodes.size() + entityNodes.size();
+    // Both are in quadrant order, newest (highest step) first inside a quadrant; an entity goes
+    // in front of everything of its quadrant that is not newer (see PaintSessionAddPSToQuadrant).
+    size_t m = 0, e = 0;
+    while (m < mapNodes.size() || e < entityNodes.size())
+    {
+        bool takeEntity;
+        if (m == mapNodes.size())
+            takeEntity = true;
+        else if (e == entityNodes.size())
+            takeEntity = false;
+        else if (entityNodes[e].QuadrantIndex != mapNodes[m].QuadrantIndex)
+            takeEntity = entityNodes[e].QuadrantIndex < mapNodes[m].QuadrantIndex;
+        else
+            takeEntity = entityNodes[e].GenerateStep >= mapNodes[m].GenerateStep;
+        work.push_back(takeEntity ? entityNodes[e++] : mapNodes[m++]);
+    }
+    if (work.empty())
+        return;
+    for (size_t i = 0; i + 1 < work.size(); i++)
+        work[i].NextQuadrantEntry = &work[i + 1];
+    work.back().NextQuadrantEntry = nullptr;
+    const uint32_t back = work.front().QuadrantIndex, front = work.back().QuadrantIndex;
+    PaintSortNode* first = nullptr;
+    const auto rotation = session.CurrentRotation;
+    if (gPaintStableSort)
+        first = rotation == 0 ? PaintArrangeNodesImpl<true, 0>(work.data(), back, front)
+            : rotation == 1   ? PaintArrangeNodesImpl<true, 1>(work.data(), back, front)
+            : rotation == 2   ? PaintArrangeNodesImpl<true, 2>(work.data(), back, front)
+                              : PaintArrangeNodesImpl<true, 3>(work.data(), back, front);
+    else
+        first = rotation == 0 ? PaintArrangeNodesImpl<false, 0>(work.data(), back, front)
+            : rotation == 1   ? PaintArrangeNodesImpl<false, 1>(work.data(), back, front)
+            : rotation == 2   ? PaintArrangeNodesImpl<false, 2>(work.data(), back, front)
+                              : PaintArrangeNodesImpl<false, 3>(work.data(), back, front);
+    list.reserve(work.size());
+    for (const PaintSortNode* node = first; node != nullptr; node = node->NextQuadrantEntry)
