+uint32_t PaintStructScrollingImage(const PaintStruct* root, int32_t* top, int32_t* bottom)
+{
+    const auto found = [&](ImageId image, const ScreenCoordsXY& pos) {
+        if (const auto* g1 = GfxGetG1Element(image); g1 != nullptr && top != nullptr && bottom != nullptr)
+        {
+            *top = pos.y + g1->yOffset;
+            *bottom = *top + g1->height;
+        }
+        return image.GetIndex();
+    };
+    for (const auto* part = root; part != nullptr; part = part->Children)
+    {
+        if (OpenRCT2::Drawing::ScrollingText::isImage(part->image_id.GetIndex()))
+            return found(part->image_id, part->ScreenPos);
+        for (const auto* attached = part->Attached; attached != nullptr; attached = attached->NextEntry)
+            if (OpenRCT2::Drawing::ScrollingText::isImage(attached->image_id.GetIndex()))
+                return found(attached->image_id, part->ScreenPos + attached->RelativePos);
+    }
+    return 0;
+}
+
+uint32_t PaintStructScrollingBounds(const PaintStruct* root, ZoomLevel zoom, ScreenRect& bounds)
+{
+    PaintExtent extent;
+    uint32_t image = 0;
+    bool multiple = false;
+    const auto add = [&](ImageId id, ScreenCoordsXY pos) {
+        if (!OpenRCT2::Drawing::ScrollingText::isImage(id.GetIndex())) return;
+        if (image != 0 && image != id.GetIndex()) multiple = true;
+        image = id.GetIndex();
+        ScreenRect glyph;
+        const auto* g1=GfxGetG1Element(id);
+        if (g1==nullptr || !OpenRCT2::Drawing::ScrollingText::imageBounds(id.GetIndex(),glyph))
+        {
+            extent.Add(id,pos,zoom);return;
+        }
+        int32_t l=pos.x+g1->xOffset+glyph.getLeft(),r=pos.x+g1->xOffset+glyph.getRight();
+        int32_t t=pos.y+g1->yOffset+glyph.getTop(),b=pos.y+g1->yOffset+glyph.getBottom();
+        if (zoom>ZoomLevel{0})
+        {
+            const int level=static_cast<int8_t>(zoom),step=(1<<level)-1;
+            l=(l-step)>>level;t=(t-step)>>level;r=(r+step)>>level;b=(b+step)>>level;
+        }
+        else if (zoom<ZoomLevel{0})
+        {
+            l=zoom.ApplyInversedTo(l);t=zoom.ApplyInversedTo(t);
+            r=zoom.ApplyInversedTo(r);b=zoom.ApplyInversedTo(b);
+        }
+        extent.left=std::min(extent.left,l);extent.right=std::max(extent.right,r);
+        extent.top=std::min(extent.top,t);extent.bottom=std::max(extent.bottom,b);
+    };
+    for (const auto* part = root; part != nullptr; part = part->Children)
+    {
+        add(part->image_id, part->ScreenPos);
+        for (const auto* attached = part->Attached; attached != nullptr; attached = attached->NextEntry)
+            add(attached->image_id, part->ScreenPos + attached->RelativePos);
+    }
+    if (multiple || extent.left >= extent.right || extent.top >= extent.bottom) return 0;
+    const int32_t slack = zoom < ZoomLevel{0} ? zoom.ApplyInversedTo(2) : 1;
+    bounds = {extent.left - slack, extent.top - slack, extent.right + slack, extent.bottom + slack};
+    return image;
+}
