+                                auto zoom = clip.zoom_level;
+                                const auto* g1 = GfxGetG1Element(image);
+                                while (g1 != nullptr && zoom > ZoomLevel{ 0 } && g1->flags.has(G1Flag::hasZoomSprite))
+                                {
+                                    image = image.WithIndex(image.GetIndex() - g1->zoomedOffset);
+                                    g1 = GfxGetG1Element(image);
+                                    zoom = zoom - 1;
+                                }
+                                if (g1 == nullptr || g1->flags.has(G1Flag::one))
+                                    return false;
+                            }
+                        auto image = part->image_id;
+                        auto zoom = clip.zoom_level;
+                        const auto* g1 = GfxGetG1Element(image);
+                        while (g1 != nullptr && zoom > ZoomLevel{ 0 } && g1->flags.has(G1Flag::hasZoomSprite))
+                        {
+                            image = image.WithIndex(image.GetIndex() - g1->zoomedOffset);
+                            g1 = GfxGetG1Element(image);
+                            zoom = zoom - 1;
+                        }
+                        if (g1 == nullptr || g1->flags.has(G1Flag::one)
+                            || (clip.zoom_level < ZoomLevel{ 0 } && !g1->flags.has(G1Flag::hasRLECompression)))
