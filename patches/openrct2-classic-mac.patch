+                const unsigned type = ride != nullptr ? std::min<unsigned>(ride->type, 126) : 127;
+                gPaintCensusRide[type][track->isStation() ? 1 : 0][0]++;
+                gPaintCensusRide[type][track->isStation() ? 1 : 0][1] += static_cast<uint64_t>(right - left) * (bottom - top);
+            }
