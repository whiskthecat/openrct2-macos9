diff --git a/src/openrct2-ui/windows/PreviewSelection.h b/src/openrct2-ui/windows/PreviewSelection.h
new file mode 100644
index 0000000..8109e43
--- /dev/null
+++ b/src/openrct2-ui/windows/PreviewSelection.h
@@ -0,0 +1,130 @@
+#pragma once
+
+#include <openrct2/core/FileStream.h>
+#include <openrct2/park/ParkPreview.h>
+#include <openrct2/platform/Platform.h>
+#include <algorithm>
+#include <cstdio>
+#include <optional>
+#include <string>
+#include <vector>
+
+namespace OpenRCT2::Ui::Windows
+{
+    struct PreviewStamp
+    {
+        uint64_t size;
+        time_t modified;
+        uint32_t header;
+        bool operator==(const PreviewStamp&) const = default;
+    };
+
+    inline std::optional<PreviewStamp> GetPreviewStamp(const std::string& path)
+    {
+        try
+        {
+            FileStream stream(path, FileMode::open);
+            // PARK's body checksum is in the header. This also catches same-size,
+            // same-second replacements that a timestamp-only cache would miss.
+            uint8_t bytes[64];
+            const auto n = stream.TryRead(bytes, sizeof(bytes));
+            uint32_t hash = 2166136261u;
+            for (uint64_t i = 0; i < n; i++) hash = (hash ^ bytes[i]) * 16777619u;
+            return PreviewStamp{ stream.GetLength(), Platform::FileGetModifiedTime(path), hash };
+        }
+        catch (const std::exception&)
+        {
+            return std::nullopt;
+        }
+    }
+
+    // Main-thread selection/cache state, independent of worker scheduling. Each
+    // window owns its lifetime, so a closed/reopened window cannot receive old work.
+    class PreviewSelection
+    {
+        struct Cached
+        {
+            std::string path;
+            PreviewStamp stamp;
+            ParkPreview preview;
+        };
+        std::vector<Cached> _cache;
+        std::string _path;
+        uint64_t _serial = 0;
+        uint32_t _selectedAt = 0;
+        bool _waiting = false;
+#ifdef OPENRCT2_SERVICES_PREVIEW_COUNTS
+        uint32_t _selects = 0, _starts = 0, _hits = 0, _stores = 0;
+#endif
+
+    public:
+        static constexpr uint32_t delayMs = 150;
+#ifdef OPENRCT2_SERVICES_PREVIEW_COUNTS
+        ~PreviewSelection()
+        {
+            std::fprintf(stderr, "services-preview selects=%u starts=%u hits=%u stores=%u\n", _selects, _starts, _hits, _stores);
+        }
+#endif
+        void Cancel()
+        {
+            ++_serial;
+            _waiting = false;
+            _path.clear();
+        }
+        void Select(std::string path, uint32_t now)
+        {
+            Cancel();
+#ifdef OPENRCT2_SERVICES_PREVIEW_COUNTS
+            _selects++;
+#endif
+            _path = std::move(path);
+            _selectedAt = now;
+            _waiting = true;
+        }
+        bool Ready(uint32_t now)
+        {
+            // Unsigned elapsed time retains the normal low32 millisecond wrap.
+            if (!_waiting || static_cast<uint32_t>(now - _selectedAt) < delayMs) return false;
+            _waiting = false;
+#ifdef OPENRCT2_SERVICES_PREVIEW_COUNTS
+            _starts++;
+#endif
+            return true;
+        }
+        bool Waiting() const { return _waiting; }
+        uint64_t Serial() const { return _serial; }
+        const std::string& Path() const { return _path; }
+        bool IsCurrent(uint64_t serial, const std::string& path) const { return serial == _serial && path == _path; }
+        void ClearCache() { _cache.clear(); }
+        const ParkPreview* Find(const std::string& path, const PreviewStamp& stamp)
+        {
+            for (auto i = _cache.begin(); i != _cache.end(); ++i)
+                if (i->path == path)
+                {
+                    if (i->stamp == stamp)
+                    {
+#ifdef OPENRCT2_SERVICES_PREVIEW_COUNTS
+                        _hits++;
+#endif
+                        return &i->preview;
+                    }
+                    _cache.erase(i);
+                    break;
+                }
+            return nullptr;
+        }
+        void Store(const std::string& path, const PreviewStamp& stamp, const ParkPreview& preview)
+        {
+            // At most two results with up to eight fixed-size images each (< 1 MiB).
+            // Valid unusually large previews still display; only retention is refused.
+            if (preview.images.size() > 8) return;
+#ifdef OPENRCT2_SERVICES_PREVIEW_COUNTS
+            _stores++;
+#endif
+            _cache.erase(std::remove_if(_cache.begin(), _cache.end(), [&](const auto& item) { return item.path == path; }),
+                _cache.end());
+            if (_cache.size() == 2) _cache.erase(_cache.begin());
+            _cache.push_back({ path, stamp, preview });
+        }
+    };
+}
