diff --git a/src/openrct2/localisation/FormatterAudit.cpp b/src/openrct2/localisation/FormatterAudit.cpp
new file mode 100644
index 0000000..63cd674
--- /dev/null
+++ b/src/openrct2/localisation/FormatterAudit.cpp
@@ -0,0 +1,145 @@
+#include "FormatterAudit.h"
+
+#ifdef OPENRCT2_FORMATTER_AUDIT
+#include <array>
+#include <bit>
+#include <cstdio>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <set>
+#include <sstream>
+
+namespace OpenRCT2::FormatterAudit
+{
+    void (*UiCommand)(const std::vector<std::string>&) = nullptr;
+    struct Field
+    {
+        size_t offset{}, width{};
+        const char* type{};
+        std::source_location location;
+        std::array<unsigned char, 8> bytes{};
+    };
+    struct Layout { size_t capacity{}; std::map<size_t, Field> fields; };
+    struct State
+    {
+        std::map<uintptr_t, Layout> buffers;
+        std::set<std::string> events;
+        FILE* log{};
+        unsigned root{}, id{};
+        const char* token{};
+        size_t reads{}, unknown{}, violations{};
+    };
+    // Retain state until exit handlers run. No audit state exists in production builds.
+    static State& Get()
+    {
+        static auto* state = [] {
+            auto* s = new State();
+            const char* path = std::getenv("RCT_FORMAT_AUDIT_LOG");
+            s->log = path ? std::fopen(path, "w") : stderr;
+            if (!s->log) std::abort();
+            std::atexit(Summary);
+            return s;
+        }();
+        return *state;
+    }
+    static void Event(const std::string& text)
+    {
+        auto& s = Get();
+        if (s.events.insert(text).second)
+        {
+            std::fprintf(s.log, "%s\n", text.c_str());
+            std::fflush(s.log);
+        }
+    }
+    void Reset(const void* buffer, size_t capacity) { Get().buffers[reinterpret_cast<uintptr_t>(buffer)] = {capacity, {}}; }
+    void Forget(const void* buffer) { Get().buffers.erase(reinterpret_cast<uintptr_t>(buffer)); }
+    void Copy(const void* destination, const void* source)
+    {
+        auto& buffers = Get().buffers;
+        auto found = buffers.find(reinterpret_cast<uintptr_t>(source));
+        if (found != buffers.end()) buffers[reinterpret_cast<uintptr_t>(destination)] = found->second;
+        else buffers.erase(reinterpret_cast<uintptr_t>(destination));
+    }
+    void Write(const void* buffer, size_t offset, size_t width, const char* type, std::source_location location)
+    {
+        auto& layout = Get().buffers[reinterpret_cast<uintptr_t>(buffer)];
+        layout.capacity = std::max(layout.capacity, offset + width);
+        for (auto it = layout.fields.begin(); it != layout.fields.end();)
+            if (it->first < offset + width && it->first + it->second.width > offset) it = layout.fields.erase(it);
+            else ++it;
+        Field field{offset, width, type, location};
+        std::memcpy(field.bytes.data(), static_cast<const unsigned char*>(buffer) + offset, width);
+        layout.fields[offset] = field;
+        std::ostringstream out;
+        out << "WRITE\t" << location.file_name() << ':' << location.line() << '\t' << type << '\t' << width;
+        Event(out.str());
+    }
+    void Begin(unsigned id)
+    {
+        Get().root = id;
+        Event("FORMAT\t" + std::to_string(id));
+    }
+    void Token(unsigned id, const char* token) { Get().id = id; Get().token = token; }
+    void Read(const void* pointer, size_t width)
+    {
+        auto& s = Get();
+        const auto address = reinterpret_cast<uintptr_t>(pointer);
+        auto found = s.buffers.upper_bound(address);
+        const Layout* layout = nullptr;
+        size_t offset = 0;
+        if (found != s.buffers.begin())
+        {
+            --found;
+            offset = address - found->first;
+            if (offset < found->second.capacity) layout = &found->second;
+        }
+        std::ostringstream out;
+        if (!layout)
+        {
+            ++s.unknown;
+            out << "UNTRACKED\t" << s.root << '\t' << s.id << '\t' << s.token << '\t' << width;
+            Event(out.str());
+            return;
+        }
+        ++s.reads;
+        auto field = layout->fields.find(offset);
+        bool valid = field != layout->fields.end() && field->second.width == width;
+        if (valid && std::memcmp(field->second.bytes.data(), pointer, width) != 0)
+        {
+            // Raw overwrites/copies must be registered explicitly; never inherit stale provenance.
+            ++s.unknown;
+            out << "RAW_OVERWRITE\t" << s.root << '\t' << s.id << '\t' << s.token << '\t' << offset << '\t' << width;
+            Event(out.str());
+            return;
+        }
+        out << (valid ? "READ" : "VIOLATION") << '\t' << s.root << '\t' << s.id << '\t' << s.token
+            << '\t' << offset << '\t' << width;
+        if (field != layout->fields.end())
+            out << '\t' << field->second.location.file_name() << ':' << field->second.location.line()
+                << '\t' << field->second.type << '\t' << field->second.width;
+        else out << "\tno argument begins here";
+        if (std::getenv("RCT_FORMAT_AUDIT_VALUES"))
+        {
+            uint64_t bits{};
+            auto* low = reinterpret_cast<unsigned char*>(&bits)
+                + (std::endian::native == std::endian::big ? sizeof(bits) - width : 0);
+            std::memcpy(low, pointer, width);
+            out << "\tvalue_bits=" << bits;
+        }
+        Event(out.str());
+        if (!valid)
+        {
+            ++s.violations;
+            if (!std::getenv("RCT_FORMAT_AUDIT_COLLECT")) std::abort();
+        }
+    }
+    void Summary()
+    {
+        auto& s = Get();
+        std::fprintf(s.log, "SUMMARY\treads=%zu\tuntracked=%zu\tviolations=%zu\n", s.reads, s.unknown, s.violations);
+        std::fflush(s.log);
+    }
+}
+#endif
diff --git a/src/openrct2/localisation/FormatterAudit.h b/src/openrct2/localisation/FormatterAudit.h
new file mode 100644
index 0000000..af8dab6
--- /dev/null
+++ b/src/openrct2/localisation/FormatterAudit.h
@@ -0,0 +1,45 @@
+#pragma once
+
+// Debug-only tracing of the native-byte-order legacy argument protocol.
+#ifdef OPENRCT2_FORMATTER_AUDIT
+#include <cstddef>
+#include <cstdint>
+#include <array>
+#include <cstring>
+#include <source_location>
+#include <string>
+#include <vector>
+
+namespace OpenRCT2::FormatterAudit
+{
+    void Reset(const void* buffer, size_t capacity = 256);
+    void Forget(const void* buffer);
+    void Copy(const void* destination, const void* source);
+    void Write(const void* buffer, size_t offset, size_t width, const char* type, std::source_location location);
+    void Begin(unsigned id);
+    void Token(unsigned id, const char* token);
+    void Read(const void* pointer, size_t width);
+    void Summary();
+    // Registered by the UI executable, so the headless engine has no UI dependency.
+    extern void (*UiCommand)(const std::vector<std::string>&);
+
+    // Preserve provenance through the two legacy raw-buffer owners used by actions/guest filters.
+    template<size_t N> struct Buffer : std::array<uint8_t, N>
+    {
+        Buffer() : std::array<uint8_t, N>{} { Reset(this->data(), N); }
+        Buffer(const Buffer& other) { *this = other; }
+        Buffer& operator=(const Buffer& other)
+        {
+            if (this != &other)
+            {
+                std::memcpy(this->data(), other.data(), N);
+                Copy(this->data(), other.data());
+            }
+            return *this;
+        }
+        ~Buffer() { Forget(this->data()); }
+        operator uint8_t*() { return this->data(); }
+        operator const uint8_t*() const { return this->data(); }
+    };
+}
+#endif
