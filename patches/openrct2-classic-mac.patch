+    std::optional<ScreenRect> WindowGetTitleBarControlRect(const WindowBase& w, TitleBarControl control)
+    {
+        if (!WindowHasTitleBarControls(w) || control == TitleBarControl::none
+            || (control == TitleBarControl::zoom && !w.canBeResized()))
+            return std::nullopt;
