+#ifdef OPENRCT2_PAK_VFS
+    size_t ParkFile::ReadSave(const MemoryStream& body, uint64_t at, uint8_t* out, size_t capacity) const
+    {
+        const auto it = std::upper_bound(_segments.begin(), _segments.end(), at,
+            [](uint64_t pos, const SaveSegment& s) { return pos < s.end; });
+        if (it == _segments.end()) return 0;
+        const auto begin = it == _segments.begin() ? 0 : (it - 1)->end;
+        const size_t size = std::min<uint64_t>(it->end - at, std::min<size_t>(capacity, it->padding ? 65536 : 8192));
+        if (it->padding)
+        {
+            const auto first = std::min(size, _defaultTile.size());
+            for (size_t i = 0; i < first; i++) out[i] = _defaultTile[(at - begin + i) % sizeof(TileElement)];
+            for (size_t filled = first; filled < size;)
+            {
+                const auto n = std::min(filled, size - filled);
+                std::memcpy(out + filled, out, n); filled += n;
+            }
+        }
+        else std::memcpy(out, static_cast<const uint8_t*>(body.GetData()) + it->physical + at - begin, size);
+        return size;
+    }
+#endif
