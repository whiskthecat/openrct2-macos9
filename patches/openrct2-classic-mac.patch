diff --git a/src/openrct2-ui/windows/OriginalHud.cpp b/src/openrct2-ui/windows/OriginalHud.cpp
new file mode 100644
index 0000000..b1c2e02
--- /dev/null
+++ b/src/openrct2-ui/windows/OriginalHud.cpp
@@ -0,0 +1,129 @@
+/*****************************************************************************
+ * Copyright (c) 2014-2026 OpenRCT2 developers
+ *
+ * For a complete list of all authors, please refer to contributors.md
+ * Interested in contributing? Visit https://github.com/OpenRCT2/OpenRCT2
+ *
+ * OpenRCT2 is licensed under the GNU General Public License version 3.
+ *****************************************************************************/
+
+#include "OriginalHud.h"
+
+#include <openrct2-ui/interface/Theme.h>
+#include <openrct2/Context.h>
+#include <openrct2/OpenRCT2.h>
+#include <openrct2/config/Config.h>
+#include <openrct2/drawing/Drawing.h>
+#include <openrct2/drawing/Drawing.Screen.h>
+#include <openrct2/drawing/Text.h>
+#include <openrct2/interface/WindowBase.h>
+#include <openrct2/ui/WindowManager.h>
+
+namespace OpenRCT2::Ui::Windows
+{
+    bool OriginalHudEnabled()
+    {
+        return Config::Get().interface.originalSolidBars && gLegacyScene == LegacyScene::playing;
+    }
+
+    int32_t OriginalHudBottomHeight()
+    {
+        return std::max(34, FontGetLineHeight(FontStyle::medium) * 2 + 12);
+    }
+
+    int32_t HudToolbarHeight()
+    {
+        if (auto* toolbar = GetWindowManager()->FindByClass(WindowClass::topToolbar))
+            return toolbar->height;
+        return kTopToolbarHeight + 1;
+    }
+
+    ScreenRect WindowGetUsableBounds()
+    {
+        auto top = gLegacyScene == LegacyScene::titleSequence ? 0 : HudToolbarHeight();
+        auto bottom = ContextGetHeight();
+        if (gLegacyScene != LegacyScene::titleSequence)
+        {
+            auto footerHeight = OriginalHudEnabled() ? OriginalHudBottomHeight() : 32;
+            if (auto* footer = GetWindowManager()->FindByClass(WindowClass::editorStepController))
+                footerHeight = footer->height;
+            bottom = std::max(top + 1, bottom - footerHeight);
+        }
+        return { { 0, top }, { ContextGetWidth(), bottom } };
+    }
+
+    bool UseCompactWindows()
+    {
+        return ContextGetWidth() < 800;
+    }
+
+    bool ApplyOriginalHudStyle(WindowBase& window, bool bottom)
+    {
+        const bool original = OriginalHudEnabled();
+        const bool wasOriginal = !window.flags.has(WindowFlag::transparent);
+        if (!original && !wasOriginal)
+            return false;
+
+        window.flags.set(WindowFlag::transparent, !original);
+        if (!original)
+            ColourSchemeUpdate(&window);
+        else if (window.classification == WindowClass::newsTicker)
+        {
+            window.colours[0] = ColourWithFlags{ Drawing::Colour::voidBackground };
+            window.colours[1] = ColourWithFlags{ Drawing::Colour::grey };
+            window.colours[2] = ColourWithFlags{ Drawing::Colour::grey };
+        }
+        else
+        {
+            window.colours[0] = ColourWithFlags{ Drawing::Colour::grey };
+            if (!bottom)
+                for (auto& colour : window.colours) colour = ColourWithFlags{ Drawing::Colour::grey };
+            else if (window.classification == WindowClass::parkInfoPanel)
+                window.colours[1] = ColourWithFlags{ Drawing::Colour::yellow };
+        }
+
+        if (bottom)
+        {
+            const auto panelWidth = original ? kOriginalHudPanelWidth : 142;
+            if (window.classification == WindowClass::parkInfoPanel)
+            {
+                window.width = panelWidth;
+                window.windowPos.x = 0;
+            }
+            else if (window.classification == WindowClass::dateInfoPanel)
+            {
+                window.width = panelWidth;
+                window.windowPos.x = ContextGetWidth() - panelWidth;
+            }
+            else
+            {
+                window.width = ContextGetWidth() - panelWidth * 2;
+                window.windowPos.x = panelWidth;
+            }
+            window.widgets[0].right = window.width - 1;
+            if (window.widgets.size() > 1) window.widgets[1].right = window.width - 3;
+        }
+        return true;
+    }
+
+    void RefreshOriginalHud()
+    {
+        if (gLegacyScene != LegacyScene::playing)
+            return;
+        auto* manager = GetWindowManager();
+        if (OriginalHudEnabled())
+        {
+            manager->CloseByClass(WindowClass::mapTooltip);
+            if (manager->FindByClass(WindowClass::gameStatusBar) == nullptr)
+                manager->OpenWindow(WindowClass::gameStatusBar);
+        }
+        else if (!(ThemeGetFlags() & UITHEME_FLAG_USE_GAME_STATUS_BAR))
+            manager->CloseByClass(WindowClass::gameStatusBar);
+        // Changing a HUD preference must not move unrelated floating windows.
+        for (const auto kind : {WindowClass::topToolbar, WindowClass::parkInfoPanel,
+                               WindowClass::dateInfoPanel, WindowClass::gameStatusBar, WindowClass::newsTicker})
+            if (auto* window = manager->FindByClass(kind)) window->onResize();
+        if (auto* main = WindowGetMain()) main->onResize();
+        Drawing::GfxInvalidateScreen();
+    }
+}
diff --git a/src/openrct2-ui/windows/OriginalHud.h b/src/openrct2-ui/windows/OriginalHud.h
new file mode 100644
index 0000000..f396be6
--- /dev/null
+++ b/src/openrct2-ui/windows/OriginalHud.h
@@ -0,0 +1,29 @@
+/*****************************************************************************
+ * Copyright (c) 2014-2026 OpenRCT2 developers
+ *
+ * For a complete list of all authors, please refer to contributors.md
+ * Interested in contributing? Visit https://github.com/OpenRCT2/OpenRCT2
+ *
+ * OpenRCT2 is licensed under the GNU General Public License version 3.
+ *****************************************************************************/
+
+#pragma once
+
+#include <openrct2/interface/ScreenCoords.hpp>
+#include <openrct2/interface/Window.h>
+
+namespace OpenRCT2::Ui::Windows
+{
+    // The title/editor toolbars have their own layouts, which this option preserves.
+    bool OriginalHudEnabled();
+    constexpr int32_t kOriginalToolbarRowHeight = 30;
+    int32_t OriginalHudBottomHeight();
+    int32_t HudToolbarHeight();
+    ScreenRect WindowGetUsableBounds();
+    bool UseCompactWindows();
+    constexpr int32_t kOriginalHudPanelWidth = 120;
+
+    // Returns true while applying the original layout or restoring the previous one.
+    bool ApplyOriginalHudStyle(WindowBase& window, bool bottom);
+    void RefreshOriginalHud();
+}
