+#pragma once
+#include <cstdint>
+namespace OpenRCT2::Drawing
+{
+    extern bool gSpriteStatsOn;
+    namespace PaintTiming
+    {
+        enum Id { palette, spriteSetup, blit, entityTile, guest, createEntry, extent, collect, occupiedTiles, copyRows, gloom, localList, ownedPatch, moverDraw, moverRanks, insertSelected, patchTile, patchStructural, columnCollect, patchCall, patchCompare, patchLayout, patchSnapshot, columnArrange, columnOwners, columnBands, selectionClear, rideRedraw, patchLookup,
+#if !defined(OPENRCT2_CLASSIC_MAC) || defined(OPENRCT2_PAINT_DETAIL_PROBES)
+                  ownerCheck, ownerSetup, entityRanges,
+#endif
+                  count };
+        extern uint64_t ticks[count], calls[count];
+#if !defined(OPENRCT2_CLASSIC_MAC) || defined(OPENRCT2_PAINT_DETAIL_PROBES)
+        enum Counter { entityRangeTests, entityRangeProjections, selectedMaps, ownerListEntries,
+                       ownerDrawEntries, ownerOrderEntries, ownerRankEntries, copiedRows, copiedPixels,
+                       guestVisits, guestUnique, entityEligibilityChecks, counterCount };
+        extern uint64_t counters[counterCount];
+#endif
+        inline uint32_t Stamp()
+        {
+#if defined(__powerpc__) || defined(__POWERPC__) || defined(__ppc__)
+            uint32_t value; __asm__ volatile("mftb %0" : "=r"(value)); return value;
+#elif defined(__x86_64__) || defined(__i386__)
+            return static_cast<uint32_t>(__builtin_ia32_rdtsc());
+#else
+            return 0;
+#endif
+        }
+        struct Scope
+        {
+            Id id; bool enabled; uint32_t start;
+            explicit Scope(Id value, bool active = true) : id(value), enabled(gSpriteStatsOn && active), start(enabled ? Stamp() : 0) {}
+            ~Scope() { if (enabled) { ticks[id] += Stamp() - start; calls[id]++; } }
+        };
+    }
+}
+#if !defined(OPENRCT2_CLASSIC_MAC) || defined(OPENRCT2_PAINT_DETAIL_PROBES)
+#define PAINT_COUNT(name, value) do { if (::OpenRCT2::Drawing::gSpriteStatsOn) \
+    ::OpenRCT2::Drawing::PaintTiming::counters[::OpenRCT2::Drawing::PaintTiming::name] += (value); } while (false)
+#define PAINT_TIMING(name) ::OpenRCT2::Drawing::PaintTiming::Scope paintTiming_(::OpenRCT2::Drawing::PaintTiming::name)
+#else
+#define PAINT_TIMING(name)
+#define PAINT_COUNT(name, value)
+#endif
