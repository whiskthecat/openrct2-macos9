+        // Cache the map in the order of this rectangle's merged sort. A column-wide order
+        // can differ when nodes outside a rectangle are omitted, even without scrolling.
+        void ColumnDrawOwnedPatch(CachedColumn& column, PaintSession& session)
+        {
+            SC_SCOPE(owner);
+            OG_SCOPE(paint);
+            PAINT_TIMING(ownedPatch);
+            const auto clip = session.rt;
+            CachedColumn::PicturePatch* patch = nullptr;
+            for (auto& candidate : column.picturePatches)
+            {
+                if (candidate.top != clip.y || candidate.bottom != clip.y + clip.height
+                    || candidate.revision != column.mapRevision || candidate.baseOwners != gPaintPartialPatches)
+                    continue;
+                size_t index = 0;
+                bool same = true;
+                for (const auto& entry : _localList)
+                    if (!entry.moving)
+                    {
+                        if (index == candidate.order.size() || candidate.order[index] != entry.ps)
+                        {
+                            same = false;
+                            break;
+                        }
+                        index++;
+                    }
+                if (same && index == candidate.order.size())
+                {
+                    patch = &candidate;
+                    break;
+                }
+            }
+            static std::vector<uint16_t> ranks, usedRanks;
+            if (gPaintPartialPatches)
+            {
+                for (const auto index : usedRanks) ranks[index] = 0;
+                ranks.resize(column.baseList.size() + 1, 0);
+                usedRanks.clear();
+                uint16_t rank = 0;
+                for (const auto& entry : _localList)
+                    if (!entry.moving)
+                    {
+                        ranks[entry.baseRank + 1] = ++rank;
+                        usedRanks.push_back(entry.baseRank + 1);
+                    }
+            }
+            if (patch == nullptr)
+            {
+                const auto start = gPaintClock != nullptr ? gPaintClock() : 0;
+                gSpriteRasterCacheStats.patchMisses++;
+                if (column.picturePatches.size() < gPaintPatchSlots)
+                    patch = &column.picturePatches.emplace_back();
+                else
+                    patch = &*std::min_element(column.picturePatches.begin(), column.picturePatches.end(),
+                        [](const auto& a, const auto& b) { return a.used < b.used; });
+                patch->top = clip.y;
+                patch->bottom = clip.y + clip.height;
+                patch->revision = column.mapRevision;
+                patch->order.clear();
+                for (const auto& entry : _localList)
+                    if (!entry.moving)
+                        patch->order.push_back(entry.ps);
+                const size_t pixels = static_cast<size_t>(clip.height) * column.width;
+                patch->baseOwners = gPaintPartialPatches;
+                patch->pixels.resize(pixels);
+                patch->owners.resize(pixels);
+                static ViewportCache::PatchRepair repair;
+                repair.Reset({column.x, clip.y, column.x + column.width, clip.y + clip.height},
+                             CacheCPUWorkLimit(), !CacheCPULegacyRepair());
+                auto& damage = repair.damage;
+                const auto analysisStart = CacheCPUTrace() && gPaintClock != nullptr ? gPaintClock() : 0;
+                bool analysed = false;
+                if (gPaintPartialPatches)
+                {
+                    // The omitted-root repair is mandatory even if no visible
+                    // pair is inverted. Preserve base identities and ordering.
+                    for (const auto& entry : column.baseList)
+                        if (!entry.moving && ranks[entry.baseRank + 1] == 0)
+                            repair.Add({entry.left, entry.top, entry.right, entry.bottom});
+                    for (const auto& entry : _localList)
+                        if (!entry.moving)
+                            repair.Include({entry.left, entry.top, entry.right, entry.bottom}, entry.baseRank);
+                    analysed = repair.Analyze();
+                }
+                uint64_t repairPixels = 0;
+                for (const auto& box : damage) repairPixels += (box.right-box.left)*(box.bottom-box.top);
+                const auto analysisEnd = CacheCPUTrace() && gPaintClock != nullptr ? gPaintClock() : 0;
+                gSpriteRasterCacheStats.patchTotalPixels += pixels;
+                const bool partial = gPaintPartialPatches && analysed && repairPixels < pixels * 3 / 4;
+                if (partial)
+                {
+                    const size_t offset = static_cast<size_t>(clip.y - column.top) * column.width;
+                    std::memcpy(patch->pixels.data(), column.picture.data() + offset, pixels);
+                    if (column.pictureOwners8.empty())
+                        std::memcpy(patch->owners.data(), column.pictureOwners.data() + offset, pixels * sizeof(uint16_t));
+                    else
+                        for (size_t i = 0; i < pixels; ++i)
+                            patch->owners[i] = column.pictureOwners8[offset + i];
+                }
+                else
+                {
+                    damage.assign(1, {column.x, clip.y, column.x + column.width, clip.y + clip.height});
+                    repairPixels = pixels;
+                }
+                gSpriteRasterCacheStats.patchRepairPixels += repairPixels;
+                gSpriteOwnerTarget = {patch->pixels.data(), patch->owners.data(), 0, patch->baseOwners};
+                for (const auto& box : damage)
+                {
+                    RenderTarget rt = clip;
+                    rt.x = box.left; rt.y = box.top;
+                    rt.width = box.right-box.left; rt.height = box.bottom-box.top;
+                    rt.pitch = column.width-rt.width;
+                    const size_t offset = static_cast<size_t>(box.top-clip.y)*column.width+box.left-column.x;
+                    rt.bits = patch->pixels.data()+offset;
+                    for (int32_t row = 0; row < rt.height; row++)
+                    {
+                        std::memset(rt.bits + row*column.width,
+                            session.ViewFlags.has(ViewportFlag::undergroundInside) ? 10 : 0, rt.width);
+                        std::memset(patch->owners.data()+offset+row*column.width, 0, rt.width*sizeof(uint16_t));
+                    }
+                    session.rt = rt;
+                    PaintDrawMapEntries(session, _localList);
+                }
+                gSpriteOwnerTarget = {};
+                session.rt = clip;
+                if (CacheCPUTrace())
+                {
+                    SC_SCOPE(metadata);
+                    std::fprintf(stderr, "CC,miss,%u,%d,%d,%d,%zu,%zu,%zu,%zu,%zu,%zu,%zu,%u,%u,%u\n",
+                        gPaintFrameSerial, column.x, static_cast<int8_t>(column.zoom), clip.height,
+                        _localList.size(), column.baseList.size(), repair.pairs, repair.merges, repair.added, pixels,
+                        static_cast<size_t>(repairPixels), static_cast<unsigned>(analysisEnd - analysisStart),
+                        static_cast<unsigned>(gPaintClock != nullptr ? gPaintClock() - analysisEnd : 0), unsigned(partial));
+                    std::fprintf(stderr, "CC,analysis,%u,%d,%u,%zu,%zu\n", gPaintFrameSerial, column.x,
+                        unsigned(gPaintPartialPatches && !analysed), CacheCPUWorkLimit(), repair.CapacityBytes());
+                }
+                if (gPaintClock != nullptr)
+                    gSpriteRasterCacheStats.patchMicros += gPaintClock() - start;
+            }
+            else
+            {
+                gSpriteRasterCacheStats.patchHits++;
+                if (CacheCPUTrace())
+                {
+                    SC_SCOPE(metadata);
+                    std::fprintf(stderr, "CC,hit,%u,%d,%d,%d\n", gPaintFrameSerial, column.x,
+                        static_cast<int8_t>(column.zoom), clip.height);
+                }
+            }
+            patch->used = gPaintFrameSerial;
+            auto* target = clip.bits;
+            const auto* source = patch->pixels.data() + clip.x - column.x;
+            {
+                SC_SCOPE(copy);
+                PAINT_TIMING(copyRows);
+                if (gPaintRowCopyBatch)
+                    CopyColumnRows(target, source, clip.width, clip.height, clip.LineStride(), column.width);
+                else
+                    for (int32_t row = 0; row < clip.height; row++, target += clip.LineStride(), source += column.width)
+                        CopyColumnRow(target, source, clip.width);
+            }
+            if (!PaintDrawMovingOverMapOwners(session, _localList, patch->pixels.data(), patch->owners.data(),
+                                              column.x, clip.y, column.width, patch->baseOwners ? ranks.data() : nullptr))
+            {
+                // Translucency or masked attachments need the ordinary interleaved draw.
+                gSpriteRasterCacheStats.ownerFallbacks++;
+                target = clip.bits;
+                for (int32_t row = 0; row < clip.height; row++, target += clip.LineStride())
+                    std::memset(target, session.ViewFlags.has(ViewportFlag::undergroundInside) ? 10 : 0,
+                        static_cast<size_t>(clip.width));
+                PaintDrawListClipped(session, _localList);
+            }
+        }
+
+        // Deferred retained rows still use the owner compositor. Switching from
+        // interleaved drawing to owner clipping changes guest/railing pixels
+        // when those rows are first filled later. This scratch exists only for
+        // the current cold rectangle; it does not spend an admission slot.
+        bool ColumnDrawDeferredOwners(CachedColumn& column, PaintSession& session)
+        {
+            if (!column.nodesOk || !ColumnUsesDirectOwners() || !gPaintOwnerPictures)
+                return false;
+            const auto clip = session.rt;
+            static std::vector<PaletteIndex> pixels;
+            static std::vector<uint16_t> owners, ranks;
+            const size_t count = static_cast<size_t>(column.width) * clip.height;
+            pixels.assign(count, session.ViewFlags.has(ViewportFlag::undergroundInside)
+                ? PaletteIndex::pi10 : PaletteIndex::transparent);
+            owners.assign(count, 0);
+            RenderTarget target = column.fullRT;
+            target.y = clip.y;
+            target.height = clip.height;
+            target.bits = pixels.data();
+            target.pitch = 0;
+            session.rt = target;
+            gSpriteOwnerTarget = {pixels.data(), owners.data(), 0, true};
+            PaintDrawMapEntries(session, column.baseList);
+            gSpriteOwnerTarget = {};
+            session.rt = clip;
+            CopyColumnRows(clip.bits, pixels.data() + clip.x - column.x,
+                clip.width, clip.height, clip.LineStride(), column.width);
+            if (!ColumnLocalList(column, clip, true))
+                return true;
+            if (ranks.size() < column.baseList.size() + 1)
+                ranks.resize(column.baseList.size() + 1, 0);
+            if (PaintDrawMovingOverMapOwners(session, _localList, pixels.data(), owners.data(),
+                column.x, clip.y, column.width, ranks.data()))
+                return true;
+            ColumnLocalList(column, clip, false);
+            return PaintDrawMovingOverMap(session, _localList);
+        }
+
+        uint32_t _zoomAheadSerial = 0;
+        void ColumnPrepareZoom(const Viewport& viewport)
+        {
+            if (viewport.isSuspended)
+                return;
+            if (!gPaintViewHistory || _zoomAheadSerial == gPaintFrameSerial || gPaintZoomAhead > 2) return;
+            _zoomAheadSerial = gPaintFrameSerial;
+            if (gPaintHistoryFreeBytes != nullptr && gPaintHistoryFreeBytes() < 32 * 1024 * 1024) return;
+            // Use the same centre-preserving projection as WindowZoomSet. The
+            // live viewport and window never change during preparation.
+            auto projected = viewport;
+            while (static_cast<int8_t>(projected.zoom) < gPaintZoomAhead)
+            {
+                projected.zoom++;
+                projected.viewPos.x -= projected.ViewWidth() / 4;
+                projected.viewPos.y -= projected.ViewHeight() / 4;
+            }
+            projected.farEntities = {};
+            auto* current = _set;
+            ColumnCacheSet* prepared = nullptr;
+            ColumnCacheSet* spare = nullptr;
+            ColumnCacheSet* oldest = nullptr;
+            for (size_t i = 0; i < gPaintHistorySets; i++)
+            {
+                auto& candidate = _columnSets[i];
+                if (candidate.viewport == &viewport && SetMatchesView(candidate, projected))
+                { prepared = &candidate; break; }
+                if (candidate.viewport == nullptr) spare = &candidate;
+                else if (SetIsHistory(candidate) && (oldest == nullptr || candidate.lastPainted < oldest->lastPainted))
+                    oldest = &candidate;
+            }
+            if (prepared == nullptr)
+            {
+                if (spare == nullptr) spare = oldest;
+                if (spare == nullptr) return;
+                _set = spare;
+                ColumnCacheClear();
+                prepared = spare;
+                prepared->viewport = &viewport;
+                prepared->zoom = projected.zoom;
+            }
+            _set = prepared;
+            prepared->view = projected;
+            prepared->lastPainted = gPaintFrameSerial;
+            const int32_t width = projected.zoom.ApplyInversedTo(kCoordsXYStep);
+            const int32_t left = projected.zoom.ApplyInversedTo(projected.viewPos.x);
+            const int32_t y = projected.zoom.ApplyInversedTo(projected.viewPos.y);
+            const int32_t top = floor2(y, gPaintColdRowGrid) - gPaintColdRowGrid;
+            const int32_t bottom = top + floor2(projected.height + gPaintColdRowGrid - 1, gPaintColdRowGrid)
+                + 3 * gPaintColdRowGrid;
+            for (int32_t x = floor2(left, width); x < left + projected.width; x += width)
+            {
+                auto& column = ColumnFind(x);
+                if (column.valid && column.top <= top && column.bottom >= bottom) continue;
+                // Leave room before allocating a background column. The
+                // measured columns fit well within this allowance; trimming
+                // also honours the native free-partition guard.
+                constexpr uint64_t reserve = 1024 * 1024;
+                const auto budget = gPaintHistoryBytes;
+                if (budget <= reserve) break;
+                gPaintHistoryBytes = budget - reserve;
+                ColumnHistoryTrim();
+                gPaintHistoryBytes = budget;
+                if (prepared->viewport != &viewport) break;
+                // One complete column per stationary picture. This deliberately
+                // charges its work to that picture; it is not a free preload.
+                prepared->storageValid = false;
+                ColumnBuild(column, &projected, top, bottom, true);
+                column.lastUsed = gPaintFrameSerial;
+                ColumnPaintPicture(column, y, y + projected.height, gPaintOwnerPictures);
+                break;
+            }
+            _set = current;
+            // Prepared visits consume the existing inactive-history allowance,
+            // including its native 32-MiB free-partition guard.
+            ColumnHistoryTrim();
+        }
+
+        void ViewportPaintCached(const Viewport* viewport, RenderTarget& worldRT)
+        {
+            OG_SCOPE(paint);
+            if (CacheCPUTrace())
+            {
+                static uint32_t sampled = 0;
+                if (sampled != gPaintFrameSerial && gPaintFrameSerial % 60 == 0)
+                {
+                    CacheCPUStorage();
+                    sampled = gPaintFrameSerial;
+                }
+            }
+            ColumnCacheSelect(viewport, true);
+            const auto* depthMainWindow = WindowGetMain();
+            _set->fullDepth = depthMainWindow != nullptr && depthMainWindow->viewport == viewport
+                ? Config::Get().interface.exactMainDepth : Config::Get().interface.exactSecondaryDepth;
+            const auto* mainWindow = _viewports.size() > 1 ? WindowGetMain() : nullptr;
+            const bool scrollAhead = gPaintScrollAhead && viewport->zoom >= ZoomLevel{0} && viewport->zoom <= ZoomLevel{1}
+                && (mainWindow == nullptr || mainWindow->viewport == viewport);
+            const bool limitedGeometry = gPaintColumnBuildBudget != 0 && _viewports.size() > 1
+                && (viewport->zoom == ZoomLevel{2} || viewport->zoom == ZoomLevel{3})
+                && (mainWindow == nullptr || mainWindow->viewport != viewport);
+            // Share the ordinary geometry budget with zoom 2. Admitting only
+            // one zoom-3 column repeats expensive uncached pictures for seconds
+            // after opening a ride window on the G3. Pixels still use the
+            // complete fallback until their column is ready.
+            if (gPaintViewHistory && _set->lastPainted + 1 < gPaintFrameSerial)
+            {
+                // Invisible animation need not issue damage. On returning to a
+                // visit, refresh mutable tiles before any retained pixels copy.
+                for (auto& column : _set->columns)
+                {
+                    if (!column.valid) continue;
+                    const auto refresh = [&](const CoordsXY& location) {
+
+
+                        if (!MapAnimations::TileNeedsPaintRefresh(TileCoordsXY{location})) return;
+                        const bool known = std::any_of(column.changedTiles.begin(), column.changedTiles.end(),
+                            [&location](const auto& change) { return change.location == location; });
+                        if (known) return;
+                        if (column.changedTiles.size() >= kColumnMaxChangedTiles) {column.valid = false;return;}
+                        column.changedTiles.push_back({location, false});
+                    };
+                    if (column.denseTiles)
+                        for (const auto& slot : column.tileSlots)
+                        {
+                            if (!column.valid) break;
+                            if (slot.count != 0) refresh(ColumnDenseTileLocation(slot.key));
+                        }
+                    else
+                        for (const auto& [tile, nodes] : column.tileNodes)
+                        {
+                            if (!column.valid) break;
+                            refresh({static_cast<int32_t>(tile % 256) * 32, static_cast<int32_t>(tile / 256) * 32});
+                        }
+                }
+            }
+            _set->lastPainted = gPaintFrameSerial;
+            _set->view = *viewport;
+            // Columns of another zoom level are of no use any more (and two steps out there are
+            // over a hundred of them).
+            if (_set->zoom != viewport->zoom)
+            {
+                ColumnCacheClear();
+                _set->zoom = viewport->zoom;
+            }
+            const int32_t columnWidth = viewport->zoom.ApplyInversedTo(kCoordsXYStep);
+            const int32_t viewY = viewport->zoom.ApplyInversedTo(viewport->viewPos.y);
+            // Snap retained ranges to the row grid and move only a few columns per
+            // picture. The legacy policy settles on a centred canonical range.
+            // At zoom 0/1, scrollAhead instead maintains the approaching edge and
+            // leaves a covering range in place at rest, avoiding a settling tail.
+            const int32_t rowGrid = viewport->zoom >= ZoomLevel{0} ? gPaintColdRowGrid : kColumnRowGrid;
+            int32_t viewTop = viewport->zoom == ZoomLevel{3} ? viewY : floor2(viewY, rowGrid) - rowGrid;
+            int32_t viewBottom = viewport->zoom == ZoomLevel{3} ? viewY + viewport->height
+                : viewTop + floor2(viewport->height + rowGrid - 1, rowGrid) + 3 * rowGrid;
+            if (_set->moveSerial != gPaintFrameSerial)
+            {
+                const int32_t deltaY = viewY - viewport->zoom.ApplyInversedTo(_set->lastViewPos.y);
+                const int32_t deltaX = viewport->zoom.ApplyInversedTo(viewport->viewPos.x - _set->lastViewPos.x);
+                _set->moveY = _set->moveSerial != 0 && std::abs(deltaY) <= rowGrid && std::abs(deltaX) <= rowGrid
+                    ? deltaY : 0;
+                _set->moveX = _set->moveSerial != 0 && std::abs(deltaX) <= 2 * rowGrid && deltaY == 0 ? deltaX : 0;
+                _set->moveSerial = gPaintFrameSerial;
+                _set->viewMoved = _set->lastViewPos != viewport->viewPos;
+                _set->lastViewPos = viewport->viewPos;
+#ifdef OPENRCT2_SCROLL_TRACE
+                { SC_SCOPE(metadata);
+                  std::fprintf(stderr, "SC,view,%u,%d,%d,%d,%d,%d\n", gPaintFrameSerial,
+                    viewport->zoom.ApplyInversedTo(viewport->viewPos.x), viewY,
+                    viewport->width, viewport->height, static_cast<int8_t>(viewport->zoom)); }
+#endif
+                _set->moveBudget = std::max<int32_t>(2, viewport->width / columnWidth / 12);
+                if (scrollAhead && _set->moveY != 0)
+                {
+                    const int32_t shown = (viewport->width + columnWidth - 1) / columnWidth + 1;
+                    _set->moveBudget = std::max(_set->moveBudget, (shown * std::abs(_set->moveY) + rowGrid - 1) / rowGrid);
+                }
+                _set->moveEdge = std::numeric_limits<int32_t>::max();
+                if (scrollAhead && viewport->zoom == ZoomLevel{1} && _set->moveY != 0)
+                {
+                    const int32_t left = viewport->zoom.ApplyInversedTo(viewport->viewPos.x);
+                    int32_t pending = 0;
+                    for (const auto& candidate : _set->columns)
+                    {
+                        if (!candidate.valid || candidate.x + candidate.width <= left || candidate.x >= left + viewport->width)
+                            continue;
+                        const int32_t edge = _set->moveY < 0 ? viewY - candidate.top
+                            : candidate.bottom - (viewY + viewport->height);
+                        if (edge < _set->moveEdge) { _set->moveEdge = edge; pending = 1; }
+                        else if (edge == _set->moveEdge) pending++;
+                    }
+                    // Maintain the oldest range first. Its remaining coverage
+                    // determines how many columns must advance per picture.
+                    const int32_t speed = std::abs(_set->moveY);
+                    const int32_t slack = std::max(speed, _set->moveEdge);
+                    _set->moveBudget = pending == 0 ? 2 : std::max(1, (pending * speed + slack - 1) / slack);
+                }
+            }
+            if (scrollAhead && _set->moveY != 0)
+            {
+                // Keep the same storage size, with more of its gutter ahead of travel.
+                // Each column shifts on demand; no stale or missing rows are displayed.
+                const int32_t height = viewBottom - viewTop;
+                viewTop = floor2(viewY, rowGrid) - (_set->moveY < 0 ? 2 * rowGrid : 0);
+                viewBottom = viewTop + height;
+            }
+            const int32_t rightBorder = worldRT.x + worldRT.width;
+            // A column of a zoomed-out view covers more tiles and so holds more entries.
+            const size_t maxEntries = viewport->zoom > ZoomLevel{ 0 }
+                ? kColumnMaxEntries << static_cast<int8_t>(viewport->zoom)
+                : kColumnMaxEntries;
+            for (int32_t x = floor2(worldRT.x, columnWidth); x < rightBorder; x += columnWidth)
+            {
+                auto& column = ColumnFind(x);
+                column.lastUsed = gPaintFrameSerial;
+#ifdef OPENRCT2_SCROLL_TRACE
+                if (column.traceUsed != gPaintFrameSerial) {
+                    TraceColumn("use", column);
+                    column.traceUsed = gPaintFrameSerial;
+                }
+#endif
+                if (column.valid && !column.changedTiles.empty() && column.session->paintEntries.size() > maxEntries)
+                    column.valid = false;
+                bool collected = false; // session is in its collected, unsorted state
+                const bool reusable = column.valid && column.flags == viewport->flags && column.rotation == viewport->rotation
+                    && column.zoom == viewport->zoom;
+                bool build = !reusable || worldRT.y < column.top || worldRT.y + worldRT.height > column.bottom;
+                const int32_t edge = _set->moveY < 0 ? viewY - column.top
+                    : column.bottom - (viewY + viewport->height);
+                const bool nearBoundary = scrollAhead
+                    ? (_set->moveY != 0 && (viewport->zoom == ZoomLevel{1}
+                        ? edge == _set->moveEdge && edge <= 2 * rowGrid : edge <= rowGrid))
+                    : viewY - column.top < kColumnRowGrid / 2
+                        || column.bottom - (viewY + viewport->height) < kColumnRowGrid / 2;
+                if (!build && (column.top != viewTop || column.bottom != viewBottom) && _set->moveBudget > 0
+                    && (scrollAhead ? nearBoundary : (!_set->viewMoved || nearBoundary)))
+                {
+                    // Still covers what is asked for, but not on the range of where the view is now.
+                    _set->moveBudget--;
+                    build = true;
+                }
+                if (build)
+                {
+                    const bool cold = column.cold || viewport->zoom == ZoomLevel{3} || column.zoom != viewport->zoom
+                        || column.rotation != viewport->rotation || column.flags != viewport->flags;
+                    if (cold && limitedGeometry && _columnsLeft == 0)
+                    {
+                        // Draw every requested pixel through the original painter.
+                        // The quota governs cache work, never scenery visibility.
+                        auto* plain = PaintSessionAlloc(worldRT, viewport->flags, viewport->rotation);
+                        plain->HideFarEntities = viewport->AreFarEntitiesHidden();
+                        auto& clip = plain->rt;
+                        const int32_t left = std::max(x, clip.x);
+                        const int32_t right = std::min(x + columnWidth, clip.x + clip.width);
+                        clip.bits += left - clip.x;
+                        clip.pitch += clip.width - (right - left);
+                        clip.x = left;
+                        clip.width = right - left;
+                        constexpr int32_t cullingY = ZoomLevel::max().ApplyInversedTo(std::numeric_limits<int32_t>::max()) / 2;
+                        clip.cullingX = x;
+                        clip.cullingWidth = columnWidth;
+                        clip.cullingY = -cullingY;
+                        clip.cullingHeight = cullingY * 2;
+                        ViewportFillColumn(*plain);
+                        ViewportPaintColumn(*plain);
+                        PaintSessionFree(plain);
+                        gPaintColumnBuildDeferrals++;
+                        continue;
+                    }
+                    if (cold && limitedGeometry) _columnsLeft--;
+                    const uint64_t start = gPaintClock != nullptr ? gPaintClock() : 0;
+                    if (!reusable || !ColumnShift(column, viewport, viewTop, viewBottom, maxEntries))
