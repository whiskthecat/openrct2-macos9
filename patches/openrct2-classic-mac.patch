+
+        void ColumnColdCensus(const CachedColumn& column, const Viewport& viewport)
+        {
+            static const bool enabled = std::getenv("RCT_COLD_CENSUS") != nullptr;
+            if (!enabled) return;
+            const auto& rt = column.fullRT;
+            const uint8_t direction = DirectionFlipXAxis(viewport.rotation);
+            const ScreenCoordsXY screen{floor2(rt.WorldX(), 32), floor2(rt.WorldY() - 16, 32)};
+            auto tile = CoordsXY{screen.y - screen.x / 2, screen.y + screen.x / 2}.rotate(direction);
+            if (direction & 1) tile.y -= 16;
+            tile = tile.toTileStart();
+            const auto side = CoordsXY{0, 32}.rotate(direction);
+            const auto next = CoordsXY{32, 32}.rotate(direction);
+            const int32_t rows = (rt.WorldHeight() + 2128) >> 5;
+            uint64_t scanned = 0, generated = 0, visible = 0, elements = 0, visibleElements = 0, roots = 0;
+            const int32_t viewY = viewport.zoom.ApplyInversedTo(viewport.viewPos.y);
+            for (int32_t row = 0; row < rows; row++, tile += next)
+                for (const auto& location : {tile, tile + side})
+                {
+                    scanned++;
+                    int32_t top, bottom;
+                    if (!TileElementPaintRange(*column.session, location, top, bottom)) continue;
+                    const bool inGenerated = bottom > rt.WorldY() && top < rt.WorldY() + rt.WorldHeight();
+                    const bool inView = bottom > viewport.viewPos.y && top < viewport.viewPos.y + viewport.ViewHeight();
+                    generated += inGenerated;
+                    visible += inView;
+                    uint64_t tileElements = 0;
+                    if (inGenerated && !MapIsEdge(location))
+                        if (const auto* first = MapGetFirstElementAt(location))
+                        {
+                            const auto* element = first;
+                            do {elements++; tileElements++; visibleElements += inView;} while (!(element++)->isLastForTile());
+                        }
+                    if (inGenerated)
+                        std::fprintf(stderr, "COLD_TILE,%u,%d,%u,%d,%d,%u,%llu\n", gPaintFrameSerial,
+                            int(static_cast<int8_t>(viewport.zoom)), unsigned(viewport.rotation), location.x, location.y,
+                            unsigned(inView), static_cast<unsigned long long>(tileElements));
+                }
+            for (const auto& node : column.mapNodes)
+                roots += node.bottom > viewY && node.top < viewY + viewport.height;
+            // Canonical target rows, two-tile scan calls, admitted tile/element
+            // calls and drawable sorting roots. Run separately from pricing.
+            std::fprintf(stderr, "COLD_COLUMN,%u,%d,%u,%d,%d,%d,%d,%llu,%llu,%llu,%llu,%llu,%zu,%llu,%zu\n",
+                gPaintFrameSerial, int(static_cast<int8_t>(viewport.zoom)), unsigned(viewport.rotation),
+                column.x, column.top, column.bottom, viewport.height,
+                static_cast<unsigned long long>(scanned), static_cast<unsigned long long>(generated),
+                static_cast<unsigned long long>(visible), static_cast<unsigned long long>(elements),
+                static_cast<unsigned long long>(visibleElements), column.mapNodes.size(),
+                static_cast<unsigned long long>(roots), column.mapEntryCount);
+        }
+
+        // Instruction-model delimiters only. Copying a register's own bit
+        // leaves it unchanged; production and x86 builds emit nothing.
+        struct ColdColumnInstructions
+        {
+            ColdColumnInstructions()
+            {
+#if defined(OPENRCT2_OG_TRACE) && defined(__powerpc__)
+                asm volatile("rlwimi 0,0,0,7,7" ::: "memory");
+#endif
+            }
+            ~ColdColumnInstructions()
+            {
+#if defined(OPENRCT2_OG_TRACE) && defined(__powerpc__)
+                asm volatile("rlwimi 0,0,0,8,8" ::: "memory");
+#endif
+            }
+        };
+
+        void ColumnBuild(CachedColumn& column, const Viewport* viewport, int32_t top, int32_t bottom, bool staticFirst = false)
+        {
+            ScrollTrace::Scope<24> origin;
+            SC_SCOPE(build);
+            OG_SCOPE(collect);
+            ColdColumnInstructions instructions;
+            ColumnTimer timer{gPaintColumnBuildMicros};
+#ifdef OPENRCT2_SCROLL_TRACE
+            if (column.traceId != 0) TraceColumn("end", column);
+            column.traceId = ++_traceNextId;
+            column.traceBuilt = gPaintFrameSerial;
+#endif
+            if (column.session != nullptr)
+                PaintSessionFree(column.session);
+            RenderTarget rt{};
+            rt.DrawingEngine = DrawingEngineGetRT().DrawingEngine;
+            rt.bits = nullptr;
+            rt.x = column.x;
+            rt.y = top;
+            const int32_t columnWidth = viewport->zoom.ApplyInversedTo(kCoordsXYStep);
+            rt.width = columnWidth;
+            rt.height = bottom - top;
+            rt.pitch = 0;
+            rt.zoom_level = viewport->zoom;
+            constexpr int32_t cullingY = ZoomLevel::max().ApplyInversedTo(std::numeric_limits<int32_t>::max()) / 2;
+            rt.cullingX = column.x;
+            rt.cullingY = -cullingY;
+            rt.cullingWidth = columnWidth;
+            rt.cullingHeight = cullingY * 2;
+            if (gPaintColdCull)
+            {
+                // Retain a sorting gutter around the canonical row range.
+                rt.cullingY = top - 64;
+                rt.cullingHeight = bottom - top + 128;
+            }
+
+            auto* session = PaintSessionAlloc(rt, viewport->flags, viewport->rotation, gPaintCompactEntries ? 256 : 1024);
+            session->HideFarEntities = viewport->AreFarEntitiesHidden();
+            column.session = session;
+            column.fullRT = rt;
+            column.top = top;
+            column.bottom = bottom;
+            column.flags = viewport->flags;
+            column.rotation = viewport->rotation;
+            column.zoom = viewport->zoom;
+            column.width = columnWidth;
+            column.animatedEntries.clear();
+            column.spareChildren.clear();
+            column.spareAttachments.clear();
+            column.hasAnimated = false;
+            session->GenerateWhat = PaintGenerate::mapOnly;
+            {
+                OG_SCOPE_NUMBER(30); // diagnostic-only separation of generation from cold metadata
+                PaintSessionGenerate(*session);
+            }
+
+            column.onePassPending = gPaintColdOnePass && column.cold && !staticFirst;
+            // Both paths need quadrant heads for later repairs. Only the legacy
+            // path restores individual links; compact nodes discard those below.
+            ColumnSnapshot(column, !gPaintCompactColdSnapshot);
+            // A fresh session has no relationship to the previous picture's owner ranks.
+            // Its picture is reset below; do not remap owners which will be discarded.
+            column.baseList.clear();
+            if (column.onePassPending)
+            {
+                OG_SCOPE_NUMBER(5);
+                ColumnReserveMapNodes(column);
+                column.nodesOk = PaintCollectNodes(*session, column.mapNodes) && column.mapNodes.size() < 65536;
+                column.onePassPending = column.nodesOk;
+            }
+            if (!column.onePassPending) ColumnCollectNodes(column);
+            if (gPaintCompactColdSnapshot && !column.nodesOk)
+                // The long fallback restores physical quadrant links after sorting.
+                ColumnSnapshot(column);
+            ColumnColdCensus(column, *viewport);
+            column.valid = true;
+            column.cold = false;
+            column.listIsMapOnly = false;
+            column.changedTiles.clear();
+            // Every row starts invalid and is cleared immediately before it is painted.
+            // Recycled storage needs no additional whole-buffer clear here.
+            column.picture.resize(static_cast<size_t>(bottom - top) * columnWidth);
+            // A new session has no valid ranks from the old one. Allocate only
+            // when a row needs owners; do not keep a recycled quiet plane alive.
+            std::vector<uint8_t>().swap(column.pictureOwners8);
+            if (CacheCPUEagerOwners()) column.pictureOwners.resize(column.picture.size());
+            else std::vector<uint16_t>().swap(column.pictureOwners);
+            column.ownerEverPainted = false;
+            column.pictureRowsValid.assign(static_cast<size_t>(bottom - top + kPictureBlockRows - 1) / kPictureBlockRows, 0);
+            column.pictureComplete = false;
+            column.pictureStarted = false;
+            column.picturePatches.clear();
+            column.mapRevision++;
+            gPaintColumnBuilds++;
+#ifdef OPENRCT2_SCROLL_TRACE
+            TraceColumn("build", column);
+#endif
+        }
+
+        // Back to the state right after the map entries were collected.
+        void ColumnRestore(CachedColumn& column)
+        {
+            auto* session = column.session;
+            session->paintEntries.truncate(column.mapEntryCount);
+            if (session->QuadrantBackIndex != std::numeric_limits<uint32_t>::max())
+                for (uint32_t i = session->QuadrantBackIndex; i <= session->QuadrantFrontIndex; i++)
+                    session->Quadrants[i] = nullptr;
+            session->QuadrantBackIndex = column.quadrantBack;
+            session->QuadrantFrontIndex = column.quadrantFront;
+            for (size_t i = 0; i < column.quadrantHeads.size(); i++)
+                session->Quadrants[column.quadrantBack + i] = column.quadrantHeads[i];
+            for (auto& [ps, next] : column.links)
+            {
+                ps->NextQuadrantEntry = next;
+                ps->SortFlags = 0;
+            }
+            session->PaintHead = nullptr;
+            session->PSStringHead = nullptr;
+            session->LastPSString = nullptr;
+            session->LastPS = nullptr;
+            session->LastAttachedPS = nullptr;
+            session->CurrentlyDrawnEntity = nullptr;
+            session->CurrentlyDrawnTileElement = nullptr;
+            session->rt = column.fullRT;
+        }
+
+        // Replaces the entries of the changed tiles and leaves everything else as collected.
+        // (The session must be in its collected, unsorted state: see ColumnRestore.)
+        bool ColumnSameEntry(const PaintStruct* a, const PaintStruct* b, bool report = true, bool compareElements = true);
+
+        // Only roots take part in sorting. Changing a culled rider/part below a root
+        // does not invalidate its position in lists, bands or coverage owner ranks.
+        bool ColumnSameTreeLayout(const PaintStruct* a, const PaintStruct* b);
+
+        bool ColumnSameLayout(const PaintStruct* a, const PaintStruct* b)
+        {
+            if (a->QuadrantIndex != b->QuadrantIndex || a->GenerateStep != b->GenerateStep
+                || std::memcmp(&a->Bounds, &b->Bounds, sizeof(a->Bounds)) != 0)
+                return false;
+            if (!gPaintFlatrideLegacy)
+                return true;
+            return ColumnSameTreeLayout(a, b);
+        }
+
+        void ColumnRefreshElementPointers(PaintStruct* a, const PaintStruct* b)
+        {
+            for (; a != nullptr; a = a->Children, b = b->Children)
+                a->Element = b->Element;
+        }
+
+        void ColumnUpdateEntry(PaintStruct* a, const PaintStruct* b)
+        {
+            for (; a != nullptr; a = a->Children, b = b->Children)
+            {
+                auto* children = a->Children;
+                auto* attached = a->Attached;
+                auto* next = a->NextQuadrantEntry;
+                *a = *b;
+                a->Children = children;
+                a->Attached = attached;
+                a->NextQuadrantEntry = next;
+                auto* aa = attached;
+                const auto* bb = b->Attached;
+                for (; aa != nullptr; aa = aa->NextEntry, bb = bb->NextEntry)
+                {
+                    auto* nextAttached = aa->NextEntry;
+                    *aa = *bb;
+                    aa->NextEntry = nextAttached;
+                }
+            }
+        }
+
+        bool ColumnSameTreeLayout(const PaintStruct* a, const PaintStruct* b)
+        {
+            for (; a != nullptr && b != nullptr; a = a->Children, b = b->Children)
+            {
+                const auto* aa = a->Attached;
+                const auto* bb = b->Attached;
+                for (; aa != nullptr && bb != nullptr; aa = aa->NextEntry, bb = bb->NextEntry) {}
+                if (aa != nullptr || bb != nullptr)
+                    return false;
+            }
+            return a == nullptr && b == nullptr;
+        }
+
+        // No retained list points below a sorting root. Keep that root at its address,
+        // copy the freshly generated chain, and save detached parts for its next frame.
+        PaintStruct* ColumnUpdateTree(CachedColumn& column, PaintStruct* old, const PaintStruct* fresh)
+        {
+            if (fresh == nullptr)
+            {
+                while (old != nullptr)
+                {
+                    auto* next = old->Children;
+                    for (auto* attached = old->Attached; attached != nullptr;)
+                    {
+                        auto* following = attached->NextEntry;
+                        column.spareAttachments.push_back(attached);
+                        attached = following;
+                    }
+                    column.spareChildren.push_back(old);
+                    old = next;
+                }
+                return nullptr;
+            }
+            if (old == nullptr)
+            {
+                if (column.spareChildren.empty())
+                    old = column.session->AllocateNormalPaintEntry();
+                else
+                {
+                    old = column.spareChildren.back();
+                    column.spareChildren.pop_back();
+                }
+                old->Children = nullptr;
+                old->Attached = nullptr;
+                old->NextQuadrantEntry = nullptr;
+            }
+            auto* children = old->Children;
+            auto* attached = old->Attached;
+            auto* next = old->NextQuadrantEntry;
+            *old = *fresh;
+            old->NextQuadrantEntry = next;
+            old->Children = ColumnUpdateTree(column, children, fresh->Children);
+            auto** link = &old->Attached;
+            for (const auto* source = fresh->Attached; source != nullptr; source = source->NextEntry)
+            {
+                auto* target = attached;
+                if (target != nullptr)
+                    attached = target->NextEntry;
+                else if (column.spareAttachments.empty())
+                    target = column.session->AllocateAttachedPaintEntry();
+                else
+                {
+                    target = column.spareAttachments.back();
+                    column.spareAttachments.pop_back();
+                }
+                *target = *source;
+                *link = target;
+                link = &target->NextEntry;
+            }
+            *link = nullptr;
+            while (attached != nullptr)
+            {
+                auto* following = attached->NextEntry;
+                column.spareAttachments.push_back(attached);
+                attached = following;
+            }
+            return old;
+        }
+
+        // The scratch tile has already run its paint functions. Copy its tree
+        // into retained storage rather than painting the same tile a second time.
+        PaintStruct* ColumnCopyEntry(PaintSession& session, const PaintStruct* source)
+        {
+            auto* result = session.AllocateNormalPaintEntry();
+            *result = *source;
+            result->NextQuadrantEntry = nullptr;
+            result->Children = source->Children != nullptr ? ColumnCopyEntry(session, source->Children) : nullptr;
+            auto** link = &result->Attached;
+            for (auto* attached = source->Attached; attached != nullptr; attached = attached->NextEntry)
+            {
+                auto* copy = session.AllocateAttachedPaintEntry();
+                *copy = *attached;
+                *link = copy;
+                link = &copy->NextEntry;
+            }
+            *link = nullptr;
+            return result;
+        }
+
+        bool ColumnUseOverlay(const CachedColumn& column, const PaintSortNode& node, bool surfaceChange)
+        {
+            if (surfaceChange || !gPaintAnimatedMaps || node.blend || column.zoom < ZoomLevel{ 0 })
+                return false;
+            // Terrain masks/fences, walls and static entrances belong in the
+            // retained background. Owner clipping a changed root can cover
+            // another tile's mask, lose a thin wall post at smaller zooms, or
+            // expose objects beneath raised land.
+            if (node.ps->Element != nullptr
+                && (node.ps->Element->getType() == TileElementType::surface
+                    || node.ps->Element->getType() == TileElementType::wall
+                    || node.ps->Element->getType() == TileElementType::entrance))
+                return false;
+            // Magnified source-only sprites expand each decoded pixel as a
+            // block. Per-pixel owner clipping loses that advantage for a large
+            // map change, so retain these roots in the repaired map picture.
+            // Keep related terrain/selection roots there too, avoiding a second
+            // water composition over a partly baked construction picture.
+            return true;
+        }
+
+        bool ColumnPatch(CachedColumn& column)
+        {
+            PAINT_TIMING(patchCall);
+            SC_SCOPE(patch);
+            OG_SCOPE(collect);
+            const uint64_t patchStarted = gPaintClock != nullptr ? gPaintClock() : 0;
+            auto* session = column.session;
+            auto* fresh = _patchScratch;
+            if (fresh == nullptr || !gPaintRetainPatchScratch)
+            {
+                fresh = PaintSessionAlloc(column.fullRT, column.flags, column.rotation, gPaintCompactEntries ? 256 : 1024);
+                if (gPaintRetainPatchScratch)
+                    _patchScratch = fresh;
+            }
+            fresh->rt = column.fullRT;
+            fresh->ViewFlags = column.flags;
+            fresh->CurrentRotation = column.rotation;
+            fresh->HideFarEntities = session->HideFarEntities;
+            fresh->SelectedElement = TileInspector::GetSelectedElement();
+            fresh->Flags = 0;
+            fresh->PaintHead = nullptr;
+            fresh->LastPS = nullptr;
+            fresh->LastAttachedPS = nullptr;
+            fresh->PSStringHead = nullptr;
+            fresh->LastPSString = nullptr;
+            fresh->CurrentlyDrawnEntity = nullptr;
+            std::vector<PaintSortNode> temporaryNodes;
+            std::vector<PaintStruct*> temporaryEntries;
+            auto& freshNodes = gPaintRetainPatchScratch ? _patchNodes : temporaryNodes;
+            auto& oldEntries = gPaintRetainPatchScratch ? _patchOldEntries : temporaryEntries;
+            static std::vector<uint8_t> matches;
+            static std::vector<PaintStruct*> reused;
+            bool changed = false, structural = false;
+            // Visible map sprites do not consult their element while drawing.
+            // Ghost removal/insertion relocates tile storage, but that pointer
+            // change alone is not a picture change. Hidden/cut-away views keep
+            // the strict comparison because visibility can inspect the element.
+            const bool compareElements = column.flags.hasAny(
+                ViewportFlag::clipView, ViewportFlag::undergroundInside, ViewportFlag::hideVehicles,
+                ViewportFlag::hideRides, ViewportFlag::hideGuests, ViewportFlag::hideStaff,
+                ViewportFlag::hidePaths, ViewportFlag::hideVegetation, ViewportFlag::hideScenery);
+            for (const auto& change : column.changedTiles)
+            {
+                const auto& tile = change.location;
+                oldEntries.clear();
+                const auto roots = ColumnTileRoots(column, tile);
+                {
+                    PAINT_TIMING(patchLookup);
+                    const bool legacyLookup = gPaintFlatrideLegacy || gPaintFlatrideLookupLegacy;
+                    if (column.nodesOk && (!legacyLookup || !roots.empty()))
+                    {
+                        // The table covers every retained root. A missing tile is empty;
+                        // scanning every quadrant again cannot find another entry for it.
+                        if (!roots.empty())
+                            for (const auto index : roots)
+                                oldEntries.push_back(column.mapNodes[index].ps);
+                    }
+                    else if (session->QuadrantBackIndex != std::numeric_limits<uint32_t>::max())
+                        for (uint32_t i = session->QuadrantBackIndex; i <= session->QuadrantFrontIndex; i++)
+                            for (auto* ps = session->Quadrants[i]; ps != nullptr; ps = ps->NextQuadrantEntry)
+                                if (ps->MapPos == tile)
+                                    oldEntries.push_back(ps);
+                }
+                ColumnClearQuadrants(*fresh);
+                fresh->paintEntries.truncate(0);
+                const uint64_t tileStarted = gSpriteStatsOn && gPaintClock != nullptr ? gPaintClock() : 0;
+                bool freshNodesOk;
+                {
+                    PAINT_TIMING(patchTile);
+                    PaintSessionGenerateTile(*fresh, tile);
+                    freshNodesOk = PaintCollectNodes(*fresh, freshNodes);
+                }
+                if (gSpriteStatsOn && gPaintClock != nullptr)
+                {
+                    const auto elapsed = gPaintClock() - tileStarted;
+                    unsigned type = 255;
+                    for (const auto* ps : oldEntries)
+                        if (ps->Element != nullptr && ps->Element->getType() == TileElementType::track)
+                            if (const auto* ride = GetRide(ps->Element->asTrack()->getRideIndex()); ride != nullptr)
+                            {
+                                type = std::min<unsigned>(ride->type, 254);
+                                break;
+                            }
+                    gPaintTileSourceMicros[type] += elapsed;
+                    gPaintTileSourceCalls[type]++;
+                }
+                bool same = oldEntries.size() == freshNodes.size();
+                {
+                    PAINT_TIMING(patchCompare);
+                    matches.resize(oldEntries.size());
+                    if (same)
+                        for (size_t i = 0; i < oldEntries.size(); i++)
+                        {
+                            matches[i] = ColumnSameEntry(oldEntries[i], freshNodes[i].ps, false, compareElements);
+                            if (matches[i])
+                                ColumnRefreshElementPointers(oldEntries[i], freshNodes[i].ps);
+                            same = same && matches[i];
+                        }
+                }
+                // An unchanged object can still be in the moving overlay from
+                // an earlier patch. Terrain edits change its occlusion context;
+                // put it back into the map picture with the repaired surface.
+                if (same && change.surfaceChange)
+                    for (auto* ps : oldEntries)
+                        same = same && column.animatedEntries.count(ps) == 0;
+                if (same)
+                {
+                    gPaintPatchKinds[oldEntries.empty() ? 0 : 1]++;
+                    continue;
+                }
+                gPaintPatchKinds[2]++;
+                changed = true;
+                const auto dirty = [&](int32_t top, int32_t bottom) {
+                    for (auto& site : column.signSites)
+                        if (site.bounds.getTop() < bottom && site.bounds.getBottom() > top)
+                            site.backdropValid = false;
+                    const int32_t first = std::max(0, (top - column.top) / kPictureBlockRows);
+                    const int32_t last = std::min<int32_t>(column.pictureRowsValid.size() - 1,
+                                                         (bottom - 1 - column.top) / kPictureBlockRows);
+                    for (int32_t block = first; block <= last; block++)
+                        column.pictureRowsValid[block] = 0;
+                    for (auto& patch : column.picturePatches)
+                        if (patch.top < bottom && patch.bottom > top)
+                            patch.revision = 0;
+                };
+                bool layout = column.nodesOk && !roots.empty()
+                    && oldEntries.size() == freshNodes.size();
+                {
+                    PAINT_TIMING(patchLayout);
+                    for (size_t i = 0; layout && i < oldEntries.size(); i++)
+                        layout = ColumnSameLayout(oldEntries[i], freshNodes[i].ps);
+                    if (layout)
+                    {
+                        layout = ColumnNodeTileRange(column, roots.front()) == ColumnTilePaintRange(column, tile);
+                    }
+                }
+                if (layout)
+                {
+                    for (size_t i = 0; i < oldEntries.size(); i++)
+                    {
+                        if (gPaintSkipUnchangedRoots && matches[i]
+                            && !(change.surfaceChange && column.animatedEntries.count(oldEntries[i]) != 0))
+                            continue;
+                        auto* ps = oldEntries[i];
+                        auto& node = column.mapNodes[roots[i]];
+                        const bool extentChanged = node.top != freshNodes[i].top || node.bottom != freshNodes[i].bottom;
+                        const bool wasMoving = node.moving;
+                        bool animated = node.moving;
+                        if (!matches[i] || change.surfaceChange)
+                        {
+                            const bool overlay = ColumnUseOverlay(column, freshNodes[i], change.surfaceChange)
+                                || ColumnSignNeedsOverlay(column, freshNodes[i].ps);
+                            if (!animated || !overlay)
+                            {
+                                dirty(ps->ExtentTop, ps->ExtentBottom);
+                                dirty(freshNodes[i].top, freshNodes[i].bottom);
+                            }
+                            animated = overlay;
+                            if (animated)
+                            {
+                                column.animatedEntries.insert(ps);
+                                column.hasAnimated = true;
+                            }
+                            else
+                                column.animatedEntries.erase(ps);
+                        }
+                        // A cached row selection takes an animated entry whatever its extent (see
+                        // ColumnLocalList), so only scenery in the picture can invalidate one.
+                        if (wasMoving != animated
+                            || (extentChanged && !(ColumnUsesDirectOwners() && gPaintOwnerPictures && wasMoving && animated)))
+                        {
+                            PAINT_TIMING(selectionClear);
+                            column.mapSelections.clear();
+                        }
+                        if (gPaintRetainSignSites
+                            && (PaintStructScrollingImage(ps) != 0 || PaintStructScrollingImage(freshNodes[i].ps) != 0))
+                            column.signNodesSerial++;
+                        if (ColumnSameTreeLayout(ps, freshNodes[i].ps))
+                            ColumnUpdateEntry(ps, freshNodes[i].ps);
+                        else
+                            ColumnUpdateTree(column, ps, freshNodes[i].ps);
+                        // Moving opaque roots do not change the static blend context.
+                        if ((!node.moving && node.blend) || (!animated && freshNodes[i].blend))
+                            column.blendRevision++;
+                        if (wasMoving != animated || (extentChanged && (wasMoving || animated)))
+                            column.moverRevision++;
+                        const auto baseRank = node.baseRank;
+                        node = freshNodes[i];
+                        node.baseRank = baseRank;
+                        node.moving = animated;
+                        node.ps = ps;
+                        auto& entry = column.baseList[baseRank];
+                        entry = { ps, node.left, node.top, node.right, node.bottom,
+                                  static_cast<bool>(node.moving), static_cast<bool>(node.blend), baseRank };
+                    }
+                    continue;
+                }
+                structural = true;
+                PAINT_TIMING(patchStructural);
+                static const bool traceShape = std::getenv("RCT_FLATRIDE_SHAPES") != nullptr;
+                if (traceShape)
+                {
+                    bool boxes = oldEntries.size() == freshNodes.size();
+                    for (size_t i = 0; boxes && i < oldEntries.size(); i++)
+                        boxes = oldEntries[i]->QuadrantIndex == freshNodes[i].ps->QuadrantIndex
+                            && oldEntries[i]->GenerateStep == freshNodes[i].ps->GenerateStep
+                            && std::memcmp(&oldEntries[i]->Bounds, &freshNodes[i].ps->Bounds, sizeof(oldEntries[i]->Bounds)) == 0;
+                    std::fprintf(stderr, "FR,shape,%u,%d,%d,%d,%zu,%zu,%d\n", gPaintFrameSerial,
+                        column.x, tile.x, tile.y, oldEntries.size(), freshNodes.size(), boxes);
+                }
+                if (gSpriteStatsOn)
+                {
+                    unsigned type = 127;
+                    for (const auto* ps : oldEntries)
+                        if (ps->Element != nullptr && ps->Element->getType() == TileElementType::track)
+                            if (const auto* ride = GetRide(ps->Element->asTrack()->getRideIndex()); ride != nullptr)
+                                type = std::min<unsigned>(ride->type, 126);
+                    gPaintCensusRide[type][1][0]++;
+                    gPaintCensusRide[type][1][1] += oldEntries.size() * 100 + freshNodes.size();
+                }
+                // A ghost changes a tile's root count without changing its
+                // terrain. Retain identical trees and their owner identities,
+                // and invalidate only entries that actually leave the picture.
+                matches.assign(oldEntries.size(), false);
+                reused.assign(freshNodes.size(), nullptr);
+                if (freshNodesOk && gPaintSkipUnchangedRoots)
+                    for (size_t i = 0; i < freshNodes.size(); i++)
+                        for (size_t j = 0; j < oldEntries.size(); j++)
+                            if (!matches[j] && ColumnSameEntry(oldEntries[j], freshNodes[i].ps, false, compareElements))
+                            {
+                                matches[j] = true;
+                                reused[i] = oldEntries[j];
+                                ColumnRefreshElementPointers(reused[i], freshNodes[i].ps);
+                                break;
+                            }
+                for (size_t i = 0; i < oldEntries.size(); i++)
+                    if (!matches[i])
+                    {
+                        auto* ps = oldEntries[i];
+                        if (column.animatedEntries.erase(ps) == 0)
+                            dirty(ps->ExtentTop, ps->ExtentBottom);
+                    }
+                if (session->QuadrantBackIndex != std::numeric_limits<uint32_t>::max())
+                {
+                    for (uint32_t i = session->QuadrantBackIndex; i <= session->QuadrantFrontIndex; i++)
+                    {
+                        PaintStruct** link = &session->Quadrants[i];
+                        while (*link != nullptr)
+                        {
+                            if ((*link)->MapPos == tile)
+                                *link = (*link)->NextQuadrantEntry;
+                            else
+                                link = &(*link)->NextQuadrantEntry;
+                        }
+                    }
+                }
+                if (freshNodesOk)
+                {
+                    // Nodes are in quadrant-list order (newest first). Insert in
+                    // reverse order to retain the single-pass order within a tile.
+                    for (auto it = freshNodes.rbegin(); it != freshNodes.rend(); ++it)
+                    {
+                        const auto index = static_cast<size_t>(it.base() - freshNodes.begin() - 1);
+                        auto* ps = reused[index];
+                        if (ps != nullptr && change.surfaceChange && column.animatedEntries.erase(ps) != 0)
+                            dirty(ps->ExtentTop, ps->ExtentBottom);
+                        if (ps == nullptr)
+                        {
+                            ps = ColumnCopyEntry(*session, it->ps);
+                            if (ColumnUseOverlay(column, *it, change.surfaceChange))
+                            {
+                                column.animatedEntries.insert(ps);
+                                column.hasAnimated = true;
+                            }
+                            else
+                                dirty(it->top, it->bottom);
+                        }
+                        auto** link = &session->Quadrants[ps->QuadrantIndex];
+                        while (*link != nullptr && (*link)->GenerateStep > ps->GenerateStep)
+                            link = &(*link)->NextQuadrantEntry;
+                        ps->NextQuadrantEntry = *link;
+                        *link = ps;
+                        session->QuadrantBackIndex = std::min<uint32_t>(session->QuadrantBackIndex, ps->QuadrantIndex);
+                        session->QuadrantFrontIndex = std::max<uint32_t>(session->QuadrantFrontIndex, ps->QuadrantIndex);
+                    }
+                }
+                else
+                {
+                    dirty(column.top, column.bottom);
+                    PaintSessionGenerateTile(*session, tile);
+                }
+            }
+            if (!gPaintRetainPatchScratch)
+                PaintSessionFree(fresh);
+            column.changedTiles.clear();
+            if (changed)
+            {
+                column.nodesSerial++;
+                // A stable root can acquire children without rebuilding its quadrant list.
+                // Keep new descendants alive when the next picture drops entity entries.
+                column.mapEntryCount = session->paintEntries.size();
+                if (structural)
+                {
+                    PAINT_TIMING(patchSnapshot);
+                    ColumnSnapshot(column);
+                }
+                column.pictureComplete = false;
+                if (structural)
+                    column.mapRevision++;
+                gPaintColumnPatches++;
+            }
+            if (gPaintClock != nullptr)
+                gSpriteRasterCacheStats.tilePatchMicros += gPaintClock() - patchStarted;
+            return structural;
+        }
+
+        // Debug oracle: compare quadrant order, the sorted base list and the whole retained
+        // picture against a single pass over exactly this range, including children/attachments.
+        void ColumnPaintPicture(CachedColumn& column, int32_t top = INT32_MIN, int32_t bottom = INT32_MAX, bool owners = true);
+        bool ColumnSameEntry(const PaintStruct* a, const PaintStruct* b, bool report, bool compareElements)
+        {
+            for (; a != nullptr && b != nullptr; a = a->Children, b = b->Children)
+            {
+                if (a->image_id != b->image_id || a->ScreenPos != b->ScreenPos
+                    || std::memcmp(&a->Bounds, &b->Bounds, sizeof(a->Bounds)) != 0 || a->InteractionItem != b->InteractionItem
+                    || a->MapPos != b->MapPos || (compareElements && a->Element != b->Element))
+                {
+                    if (report) std::fprintf(
+                        stderr, "entry image %u/%u interaction %d/%d bounds %d,%d,%d,%d,%d,%d / %d,%d,%d,%d,%d,%d\n",
+                        a->image_id.GetIndex(), b->image_id.GetIndex(), static_cast<int>(a->InteractionItem),
+                        static_cast<int>(b->InteractionItem), a->Bounds.x, a->Bounds.y, a->Bounds.z, a->Bounds.x_end,
+                        a->Bounds.y_end, a->Bounds.z_end, b->Bounds.x, b->Bounds.y, b->Bounds.z, b->Bounds.x_end,
+                        b->Bounds.y_end, b->Bounds.z_end);
+                    if (report && a->Element != nullptr && a->Element->getType() == TileElementType::track)
+                    {
+                        const auto* track = a->Element->asTrack();
+                        const auto* ride = GetRide(track->getRideIndex());
+                        std::fprintf(
+                            stderr, "tile %d,%d track=%d ride=%d\n", a->MapPos.x, a->MapPos.y,
+                            static_cast<int>(track->getTrackType()), ride != nullptr ? ride->type : -1);
+                    }
+                    if (report) std::fprintf(stderr, "map position %d,%d / %d,%d\n",
+                        a->MapPos.x, a->MapPos.y, b->MapPos.x, b->MapPos.y);
+                    return false;
+                }
+                const auto* aa = a->Attached;
+                const auto* bb = b->Attached;
+                for (; aa != nullptr && bb != nullptr; aa = aa->NextEntry, bb = bb->NextEntry)
+                    if (aa->image_id != bb->image_id || (aa->IsMasked && aa->ColourImageId != bb->ColourImageId)
+                        || aa->RelativePos != bb->RelativePos || aa->IsMasked != bb->IsMasked)
+                    {
+                        if (report) std::fprintf(stderr, "attachment mismatch\n");
+                        return false;
+                    }
+                if (aa != nullptr || bb != nullptr)
+                    return false;
+            }
+            if (report && (a != nullptr || b != nullptr))
+                std::fprintf(stderr, "child chain length differs\n");
+            return a == nullptr && b == nullptr;
+        }
+
+        void ColumnCheckShift(CachedColumn& column, const Viewport* viewport)
+        {
+            static const bool check = std::getenv("RCT_CHECK_COLUMN_SHIFT") != nullptr;
+            if (!check || !column.nodesOk)
+                return;
+            CachedColumn fresh;
+            fresh.x = column.x;
+            ColumnBuild(fresh, viewport, column.top, column.bottom);
+            gPaintColumnBuilds--; // an oracle build is not part of the cache's work
+            const auto fail = [&](const char* what) {
+                std::fprintf(
+                    stderr, "column shift mismatch x=%d rows=%d..%d zoom=%d nodes=%zu/%zu\n", column.x, column.top,
+                    column.bottom, static_cast<int8_t>(column.zoom), column.mapNodes.size(), fresh.mapNodes.size());
+                std::fprintf(stderr, "stage: %s\n", what);
+                std::abort();
+            };
+            const auto sameEntry = [](const PaintStruct* a, const PaintStruct* b) {
+                if (!ColumnSameEntry(a, b, true, false)) return false;
+                for (; a != nullptr && b != nullptr; a = a->Children, b = b->Children)
+                    // Noninteractive overlays inherit the collector's last
+                    // tile pointer. Keep element identity for interactive
+                    // children; the render identity is checked above.
+                    if (a->InteractionItem != ViewportInteractionItem::none && a->Element != b->Element)
+                        return false;
+                return true;
+            };
+            if (column.mapNodes.size() != fresh.mapNodes.size() || column.baseList.size() != fresh.baseList.size())
+                fail("size");
+            for (size_t i = 0; i < column.mapNodes.size(); i++)
+            {
+                const auto& a = column.mapNodes[i];
+                const auto& b = fresh.mapNodes[i];
+                if (a.QuadrantIndex != b.QuadrantIndex || a.GenerateStep != b.GenerateStep || !sameEntry(a.ps, b.ps))
+                {
+                    std::fprintf(
+                        stderr, "node %zu quadrant %u/%u step %u/%u pos %d,%d/%d,%d\n", i, a.QuadrantIndex, b.QuadrantIndex,
+                        a.GenerateStep, b.GenerateStep, a.ps->ScreenPos.x, a.ps->ScreenPos.y, b.ps->ScreenPos.x,
+                        b.ps->ScreenPos.y);
+                    fail("quadrants");
+                }
+            }
+            for (size_t i = 0; i < column.baseList.size(); i++)
+                if (!sameEntry(column.baseList[i].ps, fresh.baseList[i].ps))
+                    fail("base list");
+            ColumnPaintPicture(column);
+            ColumnPaintPicture(fresh);
+            if (column.picture != fresh.picture)
+                fail("picture");
+            ColumnOwnersToWords(column);ColumnOwnersToWords(fresh);
+            if (column.pictureOwners != fresh.pictureOwners)
+                fail("owner ranks");
+            PaintSessionFree(fresh.session);
+            gPaintColumnShiftChecks++;
+        }
+
+        bool ColumnShift(CachedColumn& column, const Viewport* viewport, int32_t top, int32_t bottom, size_t maxEntries)
+        {
+            // Remapping supports both widths. Avoid expanding and repacking an
+            // otherwise byte-sized owner plane solely to move its rows.
+            const bool byteOwners = gPaintScrollAhead && !column.pictureOwners8.empty();
+            if (!byteOwners) ColumnOwnersToWords(column);
+            ScrollTrace::Scope<26> origin;
+            SC_SCOPE(shift);
+            OG_SCOPE(collect);
+            ColumnTimer timer{gPaintColumnShiftMicros};
+            // A large jump or a spent entry arena is cheaper to collect afresh. Removed entries
+            // remain allocated until then, just as with tile patches; no unbounded scroll history.
+            // Validity bits and owner rows move in whole kPictureBlockRows blocks. Zoom 3
+            // ranges are not row-grid snapped, so reject shifts that are not block-aligned
+            // (a 4-row shift moved owner rows to a negative offset).
+            if (gPaintColdCull || column.mapEntryCount > maxEntries || bottom - top != column.bottom - column.top
+                || std::abs(top - column.top) >= bottom - top || (top - column.top) % kPictureBlockRows != 0)
+                return false;
+            if (column.nodesOk)
+                ColumnDropEntities(column);
+            else
+                ColumnRestore(column);
+            if (!column.changedTiles.empty())
+                ColumnPatch(column);
+            const auto previous = column.fullRT;
+            const int32_t delta = top - column.top;
+            column.session->rt.y = top;
+            column.session->rt.height = bottom - top;
+            uint32_t tiles = 0;
+            static std::vector<std::pair<int32_t, int32_t>> dirtyRows;
+            static std::vector<PaintStruct*> reused;
+            if (!PaintSessionShiftMap(*column.session, previous, tiles, dirtyRows, reused))
+                return false;
+            // A regenerated root starts in the static picture, as in the full
+            // collection path. Former overlays therefore still require repair.
+            for (auto* ps : reused)
+                if (column.animatedEntries.erase(ps) != 0)
+                    dirtyRows.emplace_back(ps->ExtentTop, ps->ExtentBottom);
+            // A uniform scan-step translation cannot change the sort result.
+            // Reuse it only if every quadrant root is still the same object in
+            // exactly the same sequence; any insertion/removal takes the full path.
+            // A contextual cold pass can seed baseList from the combined
+            // map/entity order at higher zooms. Equal map membership alone
+            // does not prove that it equals the map-only sort used by shifts.
+            bool sameNodes = column.nodesOk && !_set->fullDepth;
+            size_t index = 0;
+            if (column.session->QuadrantBackIndex != UINT32_MAX)
+                for (uint32_t q = column.session->QuadrantBackIndex; sameNodes && q <= column.session->QuadrantFrontIndex; q++)
+                    for (auto* ps = column.session->Quadrants[q]; ps != nullptr; ps = ps->NextQuadrantEntry)
+                    {
+                        if (index >= column.mapNodes.size() || column.mapNodes[index].ps != ps) { sameNodes = false; break; }
+                        index++;
+                    }
+            sameNodes = sameNodes && index == column.mapNodes.size();
+            if (sameNodes)
+                for (auto& node : column.mapNodes) node.GenerateStep = node.ps->GenerateStep;
+            column.top = top;
+            column.bottom = bottom;
+            column.fullRT = column.session->rt;
+            // Shift the picture and its validity bits by the same (block-aligned) amount.
+            const int32_t height = bottom - top, kept = height - std::abs(delta);
+            const int32_t source = std::max(delta, 0), target = std::max(-delta, 0);
+            const auto ownerShiftStart = CacheCPUTrace() && gPaintClock != nullptr ? gPaintClock() : 0;
+            std::memmove(
+                column.picture.data() + static_cast<size_t>(target) * column.width,
+                column.picture.data() + static_cast<size_t>(source) * column.width, static_cast<size_t>(kept) * column.width);
+            size_t ownerRows = 0;
+            const auto shiftOwners = [&](int32_t from, int32_t to, int32_t rows) {
+                if (byteOwners)
+                    std::memmove(column.pictureOwners8.data() + static_cast<size_t>(to) * column.width,
+                                 column.pictureOwners8.data() + static_cast<size_t>(from) * column.width,
+                                 static_cast<size_t>(rows) * column.width);
+                else
+                    std::memmove(column.pictureOwners.data() + static_cast<size_t>(to) * column.width,
+                                 column.pictureOwners.data() + static_cast<size_t>(from) * column.width,
+                                 static_cast<size_t>(rows) * column.width * sizeof(uint16_t));
+            };
+            if (CacheCPUEagerOwners())
+            {
+                shiftOwners(source, target, kept);
+                ownerRows = kept;
+            }
+            else
+                ownerRows = ViewportCache::ShiftOwnerRows(column.pictureRowsValid, source, target, kept, kPictureBlockRows,
+                    shiftOwners);
+            if (CacheCPUTrace())
+            {
+                SC_SCOPE(metadata);
+                std::fprintf(stderr, "CC,shift,%u,%d,%d,%zu,%zu,%u\n", gPaintFrameSerial, column.x,
+                    static_cast<int8_t>(column.zoom), static_cast<size_t>(kept) * column.width,
+                    ownerRows * column.width * (byteOwners ? sizeof(uint8_t) : sizeof(uint16_t)),
+                    static_cast<unsigned>(gPaintClock != nullptr ? gPaintClock() - ownerShiftStart : 0));
+            }
+            const int32_t blocks = static_cast<int32_t>(column.pictureRowsValid.size());
+            const int32_t blockDelta = delta / kPictureBlockRows;
+            if (blockDelta > 0)
+            {
+                std::memmove(column.pictureRowsValid.data(), column.pictureRowsValid.data() + blockDelta, blocks - blockDelta);
+                std::fill(column.pictureRowsValid.end() - blockDelta, column.pictureRowsValid.end(), 0);
+            }
+            else
+            {
+                std::memmove(column.pictureRowsValid.data() - blockDelta, column.pictureRowsValid.data(), blocks + blockDelta);
+                std::fill_n(column.pictureRowsValid.begin(), -blockDelta, 0);
+            }
+            // Changes at the collection boundary (and refreshed off-screen animations) may
+            // draw into retained rows. Invalidate their extents, leaving other overlap intact.
+            for (const auto& [dirtyTop, dirtyBottom] : dirtyRows)
+            {
+                const int32_t first = std::max(0, (dirtyTop - column.top) / kPictureBlockRows);
+                const int32_t last = std::min(blocks - 1, (dirtyBottom - 1 - column.top) / kPictureBlockRows);
+                for (int32_t block = first; block <= last; block++)
+                    column.pictureRowsValid[block] = 0;
+            }
+            column.pictureComplete = false;
+            column.mapRevision++;
+            column.listIsMapOnly = false;
+            ColumnSnapshot(column, !gPaintCompactColdSnapshot || !column.nodesOk);
+            bool retainedOrder = false;
+            ColumnCollectNodes(column, sameNodes, false, &retainedOrder);
+            if (gPaintCompactColdSnapshot && !column.nodesOk) ColumnSnapshot(column);
+            // Equality of a refreshed tree is insufficient if other retained
+            // roots crossed it in the full sort. Added/removed roots already
+            // invalidate their extents; repair these too on any retained reorder.
+            if (!retainedOrder || !column.nodesOk)
+                for (const auto* ps : reused)
+                {
+                    const int32_t first = std::max(0, (ps->ExtentTop - column.top) / kPictureBlockRows);
+                    const int32_t last = std::min(blocks - 1, (ps->ExtentBottom - 1 - column.top) / kPictureBlockRows);
+                    for (int32_t block = first; block <= last; block++) column.pictureRowsValid[block] = 0;
+                }
+            ColumnCheckShift(column, viewport);
+#ifdef OPENRCT2_SCROLL_TRACE
+            column.traceShifted = gPaintFrameSerial;
+            {
+                SC_SCOPE(metadata);
+                std::fprintf(stderr, "VP,shift,%u,%d,%d,%u,%zu,%zu,%zu,%u\n", gPaintFrameSerial, column.x, delta, tiles,
+                    dirtyRows.size(), static_cast<size_t>(std::count(
+                        column.pictureRowsValid.begin(), column.pictureRowsValid.end(), uint8_t{0})), reused.size(), static_cast<unsigned>(sameNodes));
+            }
+#endif
+            gPaintColumnShifts++;
+            gPaintColumnShiftTiles += tiles;
+            return true;
+        }
+
+        bool ColumnPictureReady(const CachedColumn& column, int32_t top, int32_t bottom, uint8_t mask)
+        {
+            if ((column.pictureComplete & mask) == mask)
+                return true;
+            const int32_t first = (top - column.top) / kPictureBlockRows;
+            const int32_t end = (bottom - column.top + kPictureBlockRows - 1) / kPictureBlockRows;
+            for (int32_t block = first; block < end; block++)
+                if ((column.pictureRowsValid[block] & mask) != mask)
+                    return false;
+            return true;
+        }
+
+        // Index the whole retained blend context, shared by sign refresh and
+        // mover ordering. Opaque animation patches leave this index valid.
+        void ColumnCollectBlends(CachedColumn& column)
+        {
+            if (column.blendNodesSerial != column.blendRevision)
+            {
+                column.blendNodes.clear();
+                column.maxBlendHeight = 0;
+                for (size_t i = 0; i < column.mapNodes.size(); ++i)
+                    if (column.mapNodes[i].blend && !column.mapNodes[i].moving)
+                    {
+                        column.blendNodes.push_back(static_cast<uint16_t>(i));
+                        column.maxBlendHeight = std::max<int32_t>(column.maxBlendHeight,
+                            column.mapNodes[i].bottom - column.mapNodes[i].top);
+                    }
+                std::sort(column.blendNodes.begin(), column.blendNodes.end(), [&column](uint16_t a, uint16_t b) {
+                    return column.mapNodes[a].top < column.mapNodes[b].top;
+                });
+                column.blendNodesSerial = column.blendRevision;
+                column.blendPositionsFrame = 0;
+            }
+        }
+
+        // Map overlays keep their retained map rank. Include them with the
+        // whole blend context when positioning entities, so promoting a root
+        // cannot put it across a guest merely because their blend slots differ.
+        void ColumnCollectOrderNodes(CachedColumn& column)
+        {
+            ColumnCollectBlends(column);
+            if (column.orderBlendSerial == column.blendRevision && column.orderMoverSerial == column.moverRevision)
+                return;
+            column.orderNodes.assign(column.blendNodes.begin(), column.blendNodes.end());
+            column.maxOrderHeight = column.maxBlendHeight;
+            for (size_t i = 0; i < column.mapNodes.size(); ++i)
+                if (column.mapNodes[i].moving)
+                {
+                    column.orderNodes.push_back(static_cast<uint16_t>(i));
+                    column.maxOrderHeight = std::max<int32_t>(column.maxOrderHeight,
+                        column.mapNodes[i].bottom - column.mapNodes[i].top);
+                }
+            std::sort(column.orderNodes.begin(), column.orderNodes.end(), [&column](uint16_t a, uint16_t b) {
+                return column.mapNodes[a].top < column.mapNodes[b].top;
+            });
+            column.orderBlendSerial = column.blendRevision;
+            column.orderMoverSerial = column.moverRevision;
+            column.blendPositionsFrame = 0;
+        }
+
+        // Repaint the scrolling image's rectangle from the retained map order. Clearing
+        // restores vacated glyph pixels, including overhangs without sign ownership.
+        // All intersecting map roots and filters participate, preserving their order.
+        void ColumnRepairSignRegionFull(CachedColumn& column, const CachedColumn::SignSite& site)
+        {
+            const int32_t left = std::max(column.x, site.bounds.getLeft());
+            const int32_t right = std::min(column.x + column.width, site.bounds.getRight());
+            const int32_t top = std::max(column.top, site.bounds.getTop());
+            const int32_t bottom = std::min(column.bottom, site.bounds.getBottom());
+            if (left >= right || top >= bottom || column.picture.empty()) return;
+            static std::vector<PaintDrawEntry> entries;
+            entries.clear();
+            for (const auto& entry : column.baseList)
+                if (!entry.moving && entry.left < right && entry.right > left
+                    && entry.top < bottom && entry.bottom > top) entries.push_back(entry);
+            auto* session = column.session;
+            const auto saved = session->rt;
+            const bool haveOwners = ColumnOwnerSize(column) == column.picture.size();
+            static std::vector<uint16_t> ownerScratch;
+            const int32_t firstBlock = (top - column.top) / kPictureBlockRows;
+            const int32_t lastBlock = (bottom - 1 - column.top) / kPictureBlockRows;
+            for (int32_t block = firstBlock; block <= lastBlock;)
+            {
+                const uint8_t mask = column.pictureRowsValid[block] & 3;
+                if ((mask & 1) == 0) {++block;continue;}
+                int32_t end = block + 1;
+                while (end <= lastBlock && (column.pictureRowsValid[end] & 3) == mask) ++end;
+                const int32_t y0 = std::max(top, column.top + block * kPictureBlockRows);
+                const int32_t y1 = std::min(bottom, column.top + end * kPictureBlockRows);
+                RenderTarget rt = column.fullRT;
+                const size_t offset = static_cast<size_t>(y0-column.top)*column.width;
+                rt.bits = column.picture.data()+offset+(left-column.x);
+                rt.x = left; rt.y = y0; rt.width = right-left; rt.height = y1-y0;
+                rt.pitch = column.width-rt.width;
+                const bool owners = haveOwners && (mask & 2) != 0;
+                const bool narrow = owners && !column.pictureOwners8.empty();
+                if (narrow) ownerScratch.assign(static_cast<size_t>(rt.height)*column.width, 0);
+                for (int32_t y = 0; y < rt.height; ++y)
+                {
+                    std::fill_n(rt.bits + y*column.width, rt.width,
+                        column.flags.has(ViewportFlag::undergroundInside) ? PaletteIndex::pi10 : PaletteIndex::transparent);
+                    if (owners && !narrow)
+                        std::fill_n(column.pictureOwners.data()+offset+y*column.width+(left-column.x), rt.width, 0);
+                }
+                if (owners && gPaintOwnerPictures)
+                    gSpriteOwnerTarget = {narrow ? column.picture.data()+offset : column.picture.data(),
+                        narrow ? ownerScratch.data() : column.pictureOwners.data(), 0, true};
+                session->rt = rt;
+                PaintDrawMapEntries(*session, entries);
+                gSpriteOwnerTarget = {};
+                if (narrow)
+                    for (int32_t y=0;y<rt.height;++y)
+                        for (int32_t x=left-column.x;x<right-column.x;++x)
+                            column.pictureOwners8[offset+y*column.width+x]=static_cast<uint8_t>(ownerScratch[y*column.width+x]);
+                gPaintSignRegionPixels += uint64_t(rt.width)*rt.height;
+                block = end;
+            }
+            session->rt = saved;
+            gPaintSignRegionEntries += entries.size();
+            gPaintSignRegionRefreshes[ColumnSignRegionKind(column.mapNodes[site.node].ps)]++;
+        }
+
+        void ColumnRepairSignRegion(CachedColumn& column, CachedColumn::SignSite& site)
+        {
+            const int32_t left = std::max(column.x, site.bounds.getLeft());
+            const int32_t right = std::min(column.x + column.width, site.bounds.getRight());
+            const int32_t top = std::max(column.top, site.bounds.getTop());
+            const int32_t bottom = std::min(column.bottom, site.bounds.getBottom());
+            if (left >= right || top >= bottom || column.picture.empty()) return;
+            const auto& node = column.mapNodes[site.node];
+            const int32_t width = right-left, height = bottom-top;
+            const size_t pixels = static_cast<size_t>(width)*height;
+            auto* session = column.session;
+            const auto saved = session->rt;
+            if (!site.backdropValid)
+            {
+                try
+                {
+                    site.backdrop.assign(pixels, column.flags.has(ViewportFlag::undergroundInside)
+                        ? PaletteIndex::pi10 : PaletteIndex::transparent);
+                    site.backdropOwners.assign(pixels, 0);
+                    site.foreground.clear();
+                    static std::vector<PaintDrawEntry> entries;
+                    entries.clear();
+                    for (const auto& entry : column.baseList)
+                        if (!entry.moving && entry.ps != node.ps && entry.left < right && entry.right > left
+                            && entry.top < bottom && entry.bottom > top)
+                        {
+                            entries.push_back(entry);
+                            if (entry.blend && entry.baseRank > node.baseRank) site.foreground.push_back(entry);
+                        }
+                    RenderTarget rt = column.fullRT;
+                    rt.bits = site.backdrop.data();rt.x=left;rt.y=top;rt.width=width;rt.height=height;rt.pitch=0;
+                    session->rt = rt;
+                    gSpriteOwnerTarget = {rt.bits,site.backdropOwners.data(),0,true};
+                    PaintDrawMapEntries(*session, entries);
+                    gSpriteOwnerTarget = {};
+                    session->rt = saved;
+                    site.backdropValid = true;
+                    gPaintSignRegionEntries += entries.size();
+                }
+                catch (const std::bad_alloc&)
+                {
+                    gSpriteOwnerTarget = {};session->rt = saved;
+                    ColumnRepairSignRegionFull(column,site);return;
+                }
+            }
+            const bool haveOwners = ColumnOwnerSize(column) == column.picture.size();
+            static std::vector<uint16_t> coverage;
+            coverage.assign(pixels,0);
+            RenderTarget rt = column.fullRT;
+            rt.bits=column.picture.data()+static_cast<size_t>(top-column.top)*column.width+(left-column.x);
+            rt.x=left;rt.y=top;rt.width=width;rt.height=height;rt.pitch=column.width-width;
+            for (int32_t y=0;y<height;++y)
+                std::copy_n(site.backdrop.data()+y*width,width,rt.bits+y*column.width);
+            session->rt=rt;
+            // The backdrop omits this opaque root. Its body/glyphs overwrite it
+            // only where no later opaque map owner covers them. Last rank has
+            // no later owner; cap the threshold to keep coverage nonzero.
+            const auto owner=static_cast<uint16_t>(node.baseRank+1);
+            gSpriteOcclusionTarget={rt.bits,site.backdropOwners.data(),nullptr,column.width,width,
+                static_cast<uint16_t>(std::min<uint32_t>(owner,65534)),false,coverage.data(),width,false};
+            static std::vector<PaintDrawEntry> root(1);
+            root[0]=column.baseList[node.baseRank];
+            PaintDrawListClipped(*session,root);
+            bool handled=!gSpriteOcclusionTarget.unhandled;
+            gSpriteOcclusionTarget={};
+            if (handled && !site.foreground.empty())
+            {
+                gSpriteOcclusionTarget={rt.bits,nullptr,nullptr,column.width,0,65535,false,coverage.data(),width,true};
+                PaintDrawListClipped(*session,site.foreground);
+                handled=!gSpriteOcclusionTarget.unhandled;
+                gSpriteOcclusionTarget={};
+            }
+            if (handled && haveOwners)
+                for (int32_t y=0;y<height;++y)
+                {
+                    const int32_t block=(top+y-column.top)/kPictureBlockRows;
+                    if ((column.pictureRowsValid[block]&2)==0) continue;
+                    const size_t offset=static_cast<size_t>(top+y-column.top)*column.width+(left-column.x);
+                    for (int32_t x=0;x<width;++x)
+                    {
+                        const auto value=coverage[y*width+x]!=0 ? owner : site.backdropOwners[y*width+x];
+                        if (column.pictureOwners8.empty()) column.pictureOwners[offset+x]=value;
+                        else column.pictureOwners8[offset+x]=static_cast<uint8_t>(value);
+                    }
+                }
+            session->rt=saved;
+            if (!handled) {ColumnRepairSignRegionFull(column,site);return;}
+            gPaintSignRegionPixels+=pixels;
+            gPaintSignRegionRefreshes[ColumnSignRegionKind(node.ps)]++;
+        }
+
+        // Scrolling signs keep one sprite each (see ScrollingText::refresh), so their paint
+        // entries never change. When the text has moved, the entry is redrawn where it shows
+        // in the column's picture; nothing is collected again.
+        void ColumnUpdateSigns(CachedColumn& column)
+        {
+            if (!Drawing::ScrollingText::gScrollingTextStable || !column.nodesOk || column.session == nullptr)
+                return;
+            const uint32_t serial = gPaintRetainSignSites ? column.signNodesSerial : column.nodesSerial;
+            const bool sameMode = column.signSitesRetained == gPaintRetainSignSites;
+            if (sameMode && column.signFrame == gPaintFrameSerial && column.signSerial == serial)
+                return;
+            column.signFrame = gPaintFrameSerial;
+            if (!sameMode || column.signSerial != serial)
+            {
+                column.signSitesRetained = gPaintRetainSignSites;
+                column.signSerial = serial;
+                column.signSites.clear();
+                for (size_t i = 0; i < column.mapNodes.size(); i++)
+                {
+                    const auto& node = column.mapNodes[i];
+                    int32_t textTop = node.top, textBottom = node.bottom;
+                    const auto image = PaintStructScrollingImage(node.ps, &textTop, &textBottom);
+                    if (image == 0)
+                        continue;
+                    // (The sprite's own rows only at the normal zoom; the whole entry otherwise.)
+                    if (column.zoom != ZoomLevel{ 0 })
+                    {
+                        textTop = node.top;
+                        textBottom = node.bottom;
+                    }
+                    column.signSites.push_back({ static_cast<uint32_t>(i), image, 0, std::max<int32_t>(textTop - 1, node.top),
+                                                 std::min<int32_t>(textBottom + 1, node.bottom) });
+                    auto& site = column.signSites.back();
+                    const int kind = ColumnSignRegionKind(node.ps);
+                    site.repairRegion = !node.moving && kind >= 0 && (gPaintSignRegions & (1u << kind)) != 0
+                        && !node.blend && !node.ps->HasMasked
+                        && PaintStructScrollingBounds(node.ps, column.zoom, site.bounds) != 0;
+                }
+            }
+            static std::vector<uint16_t> only;
+            for (auto& site : column.signSites)
+            {
+                const auto revision = Drawing::ScrollingText::refresh(site.image);
+                if (revision == site.revision)
+                    continue;
+                site.revision = revision;
+                // A backdrop may contain a neighbour's glyph. Its next refresh
+                // must capture that neighbour's new text too.
+                for (auto& other : column.signSites)
+                    if (&other != &site && other.repairRegion
+                        && other.bounds.getLeft()<site.bounds.getRight() && other.bounds.getRight()>site.bounds.getLeft()
+                        && other.bounds.getTop()<site.bounds.getBottom() && other.bounds.getBottom()>site.bounds.getTop())
+                        other.backdropValid=false;
+                const auto& node = column.mapNodes[site.node];
+                // Reordered patches contain the prior text too; refresh them on this phase.
+                std::erase_if(column.picturePatches, [&site](const auto& patch) {
+                    return patch.top < site.bottom && patch.bottom > site.top;
+                });
+                // An animated entry is drawn afresh over the picture anyway.
+                if (node.moving || node.baseRank == 0xffff || column.picture.empty())
+                    continue;
+                if (site.repairRegion)
+                {
+                    ColumnRepairSignRegion(column, site);
+                    continue;
+                }
+                const int32_t top = std::max<int32_t>(site.top, column.top);
+                const int32_t bottom = std::min<int32_t>(site.bottom, column.bottom);
+                if (top >= bottom)
+                    continue;
+                const bool haveOwners = ColumnOwnerSize(column) == column.picture.size();
+                if (only.size() < column.baseList.size() + 2)
+                    only.resize(column.baseList.size() + 2, 0xffff);
+                const auto owner = static_cast<uint16_t>(node.baseRank + 1);
+                const int32_t firstBlock = (top - column.top) / kPictureBlockRows;
+                const int32_t lastBlock = std::min<int32_t>(
+                    static_cast<int32_t>(column.pictureRowsValid.size()) - 1, (bottom - 1 - column.top) / kPictureBlockRows);
+                // Runs of blocks that hold both colours and owners are redrawn in one go; a block
+                // with colours only is painted again when next needed.
+                for (int32_t block = firstBlock; block <= lastBlock;)
+                {
+                    auto& valid = column.pictureRowsValid[block];
+                    if ((valid & 1) == 0)
+                    {
+                        block++; // not painted yet: it will be, with the text as it then is
+                        continue;
+                    }
+                    if (!haveOwners || (valid & 2) == 0)
+                    {
+                        valid = 0;
+                        column.pictureComplete = 0;
+                        block++;
+                        continue;
+                    }
+                    int32_t end = block + 1;
+                    while (end <= lastBlock && (column.pictureRowsValid[end] & 3) == 3)
+                        end++;
+                    const int32_t y0 = std::max(top, column.top + block * kPictureBlockRows);
+                    const int32_t y1 = std::min(bottom, column.top + end * kPictureBlockRows);
+                    auto* session = column.session;
+                    const auto saved = session->rt;
+                    session->rt = column.fullRT;
+                    session->rt.bits = column.picture.data() + static_cast<size_t>(y0 - column.top) * column.width;
+                    session->rt.y = y0;
+                    session->rt.height = y1 - y0;
+                    session->rt.pitch = 0;
+                    only[owner] = 0;
+                    bool drawn = PaintDrawOwnedInPlace(
+                        *session, node.ps, column.pictureOwners.empty() ? nullptr : column.pictureOwners.data() + static_cast<size_t>(y0 - column.top) * column.width,
+                        column.width, only.data(), column.pictureOwners8.empty() ? nullptr : column.pictureOwners8.data() + static_cast<size_t>(y0-column.top)*column.width);
+                    // A foreground palette filter has no opaque owner of its
+                    // own. Redrawing the sign's face removes that filter too.
+                    // Reapply higher blends only at pixels owned by this sign.
+                    if (drawn)
+                    {
+                        ColumnCollectBlends(column);
+                        static std::vector<const PaintSortNode*> foreground;
+                        foreground.clear();
+                        for (const auto index : column.blendNodes)
+                        {
+                            const auto& blend = column.mapNodes[index];
+                            if (blend.baseRank > node.baseRank && blend.bottom > y0 && blend.top < y1
+                                && blend.right > node.left && blend.left < node.right)
+                                foreground.push_back(&blend);
+                        }
+                        std::sort(foreground.begin(), foreground.end(), [](const auto* a, const auto* b) {
+                            return a->baseRank < b->baseRank;
+                        });
+                        for (const auto* blend : foreground)
+                            drawn = drawn && PaintDrawOwnedInPlace(*session, blend->ps,
+                                column.pictureOwners.empty() ? nullptr : column.pictureOwners.data()
+                                    + static_cast<size_t>(y0 - column.top) * column.width,
+                                column.width, only.data(), column.pictureOwners8.empty() ? nullptr
+                                    : column.pictureOwners8.data() + static_cast<size_t>(y0-column.top)*column.width);
+                    }
+                    only[owner] = 0xffff;
+                    session->rt = saved;
+                    if (!drawn)
+                    {
+                        for (int32_t failed = block; failed < end; failed++)
+                            column.pictureRowsValid[failed] = 0;
+                        column.pictureComplete = 0;
+                    }
+                    block = end;
+                }
+            }
+        }
