+    }
+    const auto peepAfter = [](const auto& a, const auto& b) {
+        if (a.node->QuadrantIndex != b.node->QuadrantIndex)
+            return a.node->QuadrantIndex > b.node->QuadrantIndex;
+        if (a.node->GenerateStep != b.node->GenerateStep)
+            return a.node->GenerateStep > b.node->GenerateStep;
+        return a.node->ps->Entity->id.ToUnderlying() > b.node->ps->Entity->id.ToUnderlying();
+    };
+    // Back to front among the things that move: by position, then by their own comparison.
+    for (size_t i = 1; i < movers.size(); i++)
+    {
+        const auto mover = movers[i];
+        size_t j = i;
+        while (j > 0)
+        {
+            const auto& earlier = movers[j - 1];
+            const bool after = earlier.position != mover.position ? earlier.position < mover.position
