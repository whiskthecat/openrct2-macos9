+    // Images read one by one each sit in a block of their own (tens of thousands of blocks for
+    // a park's objects, each with a header and rounded up in size): move them into one block.
+    void ImageTable::Consolidate()
+    {
+        if (_data != nullptr || _entries.empty())
+            return;
+        size_t total = 0;
+        for (const auto& entry : _entries)
+            if (entry.offset != nullptr)
+                total += G1CalculateDataSize(&entry);
+        if (total == 0)
+            return;
+        auto data = std::make_unique<uint8_t[]>(total);
+        size_t at = 0;
+        for (auto& entry : _entries)
+        {
+            if (entry.offset == nullptr)
+                continue;
+            const size_t length = G1CalculateDataSize(&entry);
+            std::memcpy(data.get() + at, entry.offset, length);
+            if (!_scratchBacked)
+                delete[] entry.offset;
+            entry.offset = data.get() + at;
+            at += length;
+#ifdef OPENRCT2_PAK_VFS
+            if ((&entry - &_entries.front()) % 64 == 0)
+                ClassicLoadProgress::Report(at, total);
+#endif
+        }
+        _data = std::move(data);
+        _scratchBacked = false;
+    }
