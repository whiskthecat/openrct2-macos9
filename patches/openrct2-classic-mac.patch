+static void PaintDrawListClippedImpl(PaintSession& session, const std::vector<PaintDrawEntry>& list)
+{
+    OG_SCOPE(paint);
+    const int32_t clipTop = session.rt.y, clipBottom = session.rt.y + session.rt.height;
+    for (const auto& entry : list)
+    {
+        if (entry.bottom <= clipTop || entry.top >= clipBottom)
+            continue;
+        if (entry.ps->Moving)
+            gPaintDrawnEntityEntries++;
+        else
+            gPaintDrawnMapEntries++;
+        PaintDrawStruct(session, entry.ps);
+    }
+}
