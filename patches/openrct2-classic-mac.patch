+        // blitters draw it, with no owner test per pixel.
+        const bool unobstructed = direct && !hasForegroundBlend
+            && (moverIndex == 0 ? 0 : _directOverEnds[moverIndex - 1]) == _directOverEnds[moverIndex];
+        if (unobstructed)
+        {
+            gPaintDirectFallbacks++;
