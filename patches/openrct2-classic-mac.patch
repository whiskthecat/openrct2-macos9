+    size_t nextMover = 0;
+    const size_t drawCount = gPaintCompactMoving ? movingEntries.size() : list.size();
+    PAINT_COUNT(ownerDrawEntries, drawCount);
+    for (size_t i = 0; i < drawCount; i++)
+    {
+        const auto& entity = gPaintCompactMoving ? *movingEntries[i].entry : list[i];
+        if (!entity.moving)
+        {
+            mapIndex++;
+            continue;
+        }
+        if (gPaintCompactMoving)
+            mapIndex = movingEntries[i].mapIndex;
+        const size_t moverIndex = nextMover++;
+        if constexpr (TRepair)
+            if (std::binary_search(repair->entries.begin(), repair->entries.end(), &entity))
+                continue;
+        const int left = std::max<int>(clip.x, entity.left), top = std::max<int>(clip.y, entity.top);
+        const int right = std::min<int>(clip.x + clip.width, entity.right);
+        const int bottom = std::min<int>(clip.y + clip.height, entity.bottom);
+        if (left >= right || top >= bottom)
+            continue;
+        if (entity.ps->Moving)
