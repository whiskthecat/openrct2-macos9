+static void PaintStructResolveVisibility(PaintStruct* root, ViewportFlags flags)
+{
+    if (root->ExtentKnown & 2)
+        return;
+    bool blend = false;
+    for (auto* part = root; part != nullptr; part = part->Children)
+    {
+        const auto visibility = GetPaintStructVisibility(part, flags);
+        const auto resolve = [visibility](ImageId image) {
+            switch (visibility)
+            {
+                case VisibilityKind::partial: return image.WithTransparency(FilterPaletteID::paletteDarken1);
+                case VisibilityKind::hidden: return ImageId();
+                default: return image;
+            }
+        };
+        part->image_id = resolve(part->image_id);
+        blend = blend || part->image_id.IsBlended();
+        for (auto* attached = part->Attached; attached != nullptr; attached = attached->NextEntry)
+        {
+            attached->image_id = resolve(attached->image_id);
+            blend = blend || attached->image_id.IsBlended()
+                || (attached->IsMasked && attached->ColourImageId.IsBlended());
+        }
+        part->ExtentKnown = (part->ExtentKnown & 1) | 2 | (static_cast<uint8_t>(visibility) << 2);
+    }
+    root->HasBlend = blend;
+}
