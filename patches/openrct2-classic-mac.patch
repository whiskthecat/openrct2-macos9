+bool PaintCollectNodes(PaintSession& session, std::vector<PaintSortNode>& nodes)
+{
+    OG_SCOPE(collect);
+    PAINT_TIMING(collect);
+    nodes.clear();
+    if (session.QuadrantBackIndex == std::numeric_limits<uint32_t>::max())
+        return true;
+    const auto zoom = session.rt.zoom_level;
+    const auto fits = [](int32_t value) { return value >= -32768 && value <= 32767; };
+    for (uint32_t i = session.QuadrantBackIndex; i <= session.QuadrantFrontIndex; i++)
+    {
+        for (PaintStruct* ps = session.Quadrants[i]; ps != nullptr; ps = ps->NextQuadrantEntry)
+        {
+            const auto& b = ps->Bounds;
+            if (!fits(b.x) || !fits(b.y) || !fits(b.z) || !fits(b.x_end) || !fits(b.y_end) || !fits(b.z_end))
+                return false;
+            if (!(ps->ExtentKnown & 1))
+                PaintStructFindExtent(ps, zoom);
+            PaintSortNode node{};
+            node.ps = ps;
+            node.Bounds = { static_cast<int16_t>(b.x),     static_cast<int16_t>(b.y),     static_cast<int16_t>(b.z),
+                            static_cast<int16_t>(b.x_end), static_cast<int16_t>(b.y_end), static_cast<int16_t>(b.z_end) };
+            node.QuadrantIndex = ps->QuadrantIndex;
+            node.GenerateStep = ps->GenerateStep;
+            node.left = ps->ExtentLeft;
+            node.top = ps->ExtentTop;
+            node.right = ps->ExtentRight;
+            node.bottom = ps->ExtentBottom;
+            node.moving = ps->Moving;
+            node.blend = ps->HasBlend;
+            nodes.push_back(node);
+        }
+    }
+    if (gPaintVisibilityCache && session.ViewFlags.hasAny(ViewportFlag::undergroundInside,
+            ViewportFlag::hideRides, ViewportFlag::hideScenery, ViewportFlag::hidePaths))
+        for (auto& node : nodes)
+        {
+            PaintStructResolveVisibility(node.ps, session.ViewFlags);
+            node.blend = node.ps->HasBlend;
+        }
+    gPaintNodesCollected += nodes.size();
+    return true;
+}
