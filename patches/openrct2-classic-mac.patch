+    void WindowDrawTitleBarControls(WindowBase& w, RenderTarget& rt)
+    {
+        const auto colour = w.colours[w.widgets[2].colour];
+        const auto ink = getColourMap(colour.colour).darkest;
+        for (const auto control : { TitleBarControl::shade, TitleBarControl::zoom })
+        {
+            const auto rect = WindowGetTitleBarControlRect(w, control);
+            if (!rect)
+                continue;
+            const bool pressed = w.titleBarControlPressed == static_cast<uint8_t>(control);
+            const ScreenCoordsXY offset{ pressed ? 1 : 0, pressed ? 1 : 0 };
+            const auto l = rect->getLeft() + 3 + offset.x;
+            const auto r = rect->getRight() - 4 + offset.x;
+            const auto t = rect->getTop() + 3 + offset.y;
+            const auto b = rect->getBottom() - 4 + offset.y;
+            Rectangle::fillInset(
+                rt, { rect->point1, rect->point2 - ScreenCoordsXY{ 1, 1 } }, colour,
+                pressed ? Rectangle::BorderStyle::inset : Rectangle::BorderStyle::outset, Rectangle::FillBrightness::light);
+            if (control == TitleBarControl::shade)
+            {
+                const auto y = w.windowShaded ? t : b;
+                Rectangle::fill(rt, { { l, y }, { r, y + 1 } }, ink);
+            }
+            else
+            {
+                // Seven-pixel silhouettes with a two-row title bar, like the
+                // neighbouring solid shade/close marks. Restore's front window
+                // masks the rear outline; no inset bevel cuts through the ink.
+                static constexpr std::array<uint8_t, 7> maximize = { 0x7f, 0x7f, 0x41, 0x41, 0x41, 0x41, 0x7f };
+                static constexpr std::array<uint8_t, 7> restore = { 0x1f, 0x1f, 0x7d, 0x7d, 0x47, 0x44, 0x7c };
+                const auto& glyph = w.windowZoomed ? restore : maximize;
+                const auto origin = rect->point1 + ScreenCoordsXY{ (rect->getWidth() - 7) / 2, (rect->getHeight() - 7) / 2 }
+                    + offset;
+                for (int32_t y = 0; y < 7; y++)
+                    for (int32_t x = 0; x < 7;)
+                    {
+                        if ((glyph[y] & (0x40 >> x)) == 0)
+                        {
+                            x++;
+                            continue;
+                        }
+                        const auto first = x;
+                        while (x < 7 && (glyph[y] & (0x40 >> x)) != 0)
+                            x++;
+                        Rectangle::fill(rt, { origin + ScreenCoordsXY{ first, y }, origin + ScreenCoordsXY{ x - 1, y } }, ink);
+                    }
+            }
+        }
+    }
