+        }
+    }
+    const auto checked = gPaintClock != nullptr ? gPaintClock() : 0;
+    gSpriteRasterCacheStats.checkMicros += checked - start;
+    uint16_t mapIndex = 0;
+    uint64_t restored = 0;
+    const bool direct = gPaintDirectOwners && _directListValid && ownerRanks != nullptr;
+    // Reject a mismatched producer before drawing anything: the caller can use
+    // its ordinary full-list fallback. Never index stale per-mover coverage.
+    if (direct && (gPaintCompactMoving ? movingEntries.size()
+            : static_cast<size_t>(std::count_if(list.begin(), list.end(),
+                [](const auto& entry) { return entry.moving; }))) != _directOverEnds.size())
