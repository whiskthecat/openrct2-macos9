+    static uint32_t FarEntityPopulation(const Viewport& viewport)
+    {
+        if (GameIsPaused()) return 0; // stationary sprites have no continuing redraw cost
+        uint32_t count = 0;
+        const auto left = viewport.viewPos.x, top = viewport.viewPos.y;
+        const auto right = left + viewport.ViewWidth(), bottom = top + viewport.ViewHeight();
+        auto& registry = getGameState().entities;
+        // At most once per second, only for an AUTO quarter-size viewport.
+        // Include all the types the distant-entity switch suppresses; sprite
+        // bounds conservatively include objects crossing a viewport edge.
+        for (unsigned type = 0; type < EnumValue(EntityType::count); ++type)
+            for (const auto id : registry.getEntityList(static_cast<EntityType>(type)))
+            {
+                const auto* entity = registry.tryGetEntity(id);
+                if (!entity || entity->x == kLocationNull) continue;
+                const auto p = Translate3DTo2DWithZ(viewport.rotation, entity->getLocation());
+                if (p.x + entity->spriteData.width >= left && p.x - entity->spriteData.width < right
+                    && p.y + entity->spriteData.heightMin >= top && p.y - entity->spriteData.heightMax < bottom)
+                    ++count;
+            }
+        return count;
+    }
