+static void PaintStructFindExtent(PaintStruct* ps, ZoomLevel zoom)
+{
+    PAINT_TIMING(extent);
+    OG_SCOPE_NUMBER(10); // cold study: sprite extents
+    PaintExtent extent;
+    bool masked = false;
+    for (const PaintStruct* part = ps; part != nullptr; part = part->Children)
+    {
+        // Entities are drawn at positions rounded to the zoom's pixel size (see PaintDrawStruct).
+        auto screenPos = part->ScreenPos;
+        if (part->InteractionItem == ViewportInteractionItem::entity)
+        {
+            if (zoom >= ZoomLevel{ 1 })
+                screenPos = { floor2(screenPos.x, 2), floor2(screenPos.y, 2) };
+            if (zoom >= ZoomLevel{ 2 })
+                screenPos = { floor2(screenPos.x, 4), floor2(screenPos.y, 4) };
+        }
+        extent.Add(part->image_id, screenPos, zoom);
+        for (const auto* attached = part->Attached; attached != nullptr; attached = attached->NextEntry)
+        {
+            masked = masked || attached->IsMasked;
+            extent.Add(attached->image_id, part->ScreenPos + attached->RelativePos, zoom);
+            if (attached->IsMasked)
+                extent.Add(attached->ColourImageId, part->ScreenPos + attached->RelativePos, zoom);
+        }
+    }
+    const auto fit = [](int32_t value) { return static_cast<int16_t>(std::clamp<int32_t>(value, -32768, 32767)); };
+    // (Zoomed in, a world pixel is 2 or 4 target pixels.)
+    const int32_t slack = zoom < ZoomLevel{ 0 } ? zoom.ApplyInversedTo(2) : 1;
+    ps->ExtentLeft = fit(extent.left - slack);
+    ps->ExtentRight = fit(extent.right + slack);
+    ps->ExtentTop = fit(extent.top - slack);
+    ps->ExtentBottom = fit(extent.bottom + slack);
+    ps->HasBlend = extent.blend;
+    ps->HasMasked = masked;
+    ps->ExtentKnown |= 1;
+}
