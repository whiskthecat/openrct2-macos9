+                    [&mapNodes](int32_t y, uint16_t index) { return y < mapNodes[index].top; }) : blendContext->begin();
+                const auto lastBlend = maxBlendHeight > 0 ? std::lower_bound(firstBlend, blendContext->end(), int32_t{node.bottom},
+                    [&mapNodes](uint16_t index, int32_t y) { return mapNodes[index].top < y; }) : blendContext->end();
+                for (auto blend = firstBlend; blend != lastBlend; ++blend)
+                {
+                    const auto& map = mapNodes[*blend];
+                    if (!overlaps(map, node))
+                        continue;
+                    const bool over = !mover.entity && node.baseRank != 0xffff && map.baseRank != 0xffff
+                        ? node.baseRank > map.baseRank : DirectOver(rotation, node, mover.entity, map, false);
+                    if (over)
+                        mover.position = std::max(mover.position, uint32_t{map.baseRank} + 1);
+                }
+                if (cached != nullptr) *cached = mover.position;
+            }
+        }
+        overBegin.push_back(static_cast<uint32_t>(overOwners.size()));
+        for (size_t i = 0; i < statics.size(); i++)
+        {
+            const auto& map = *statics[i];
+            if (!overlaps(map, node))
+                continue;
+            ownerTests++;
+            // An animated map root keeps its map-only rank when promoted to
+            // the overlay. Its isolated pair comparison can disagree with
+            // that retained background's complete map sort.
+            const bool over = !mover.entity && node.baseRank != 0xffff && map.baseRank != 0xffff
+                ? node.baseRank > map.baseRank : DirectOver(rotation, node, mover.entity, map, false);
+            if (over)
+            {
+                // Opaque roots are already handled by the owner mask. Only
+                // an overlapping blend can position the mover against blends.
+                if (blendContext == nullptr && (!omitOpaqueScenery || map.blend))
+                    mover.position = static_cast<uint32_t>(i + 1);
+            }
+            else if (map.baseRank != 0xffff)
+                overOwners.push_back(static_cast<uint16_t>(map.baseRank + 1));
+        }
+        mover.index = static_cast<uint32_t>(overBegin.size() - 1);
+    }
+    gPaintDirectOwnerTests += ownerTests;
+    overBegin.push_back(static_cast<uint32_t>(overOwners.size()));
+    // Opaque scenery depth is already decided by each mover's covering owners.
+    // Its ordinal must not also change the order between overlapping guests as
+    // the dirty rectangle changes. Retain positions only against blends.
+    if (omitOpaqueScenery)
+    {
+        if (blendContext == nullptr)
+        {
+            static std::vector<uint32_t> blendPositions;
+            blendPositions.resize(statics.size() + 1);
+            blendPositions[0] = 0;
+            for (size_t i = 0; i < statics.size(); ++i)
+                blendPositions[i + 1] = blendPositions[i] + statics[i]->blend;
+            for (auto& mover : movers) mover.position = blendPositions[mover.position];
+        }
+        std::erase_if(statics, [](const auto* node) { return !node->blend; });
