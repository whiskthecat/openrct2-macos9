+            || std::memcmp(&a->Bounds, &b->Bounds, sizeof(a->Bounds)) != 0
+            || ScrollingText::isImage(a->image_id.GetIndex()))
+            return false;
+        const auto* aa = a->Attached;
+        const auto* bb = b->Attached;
+        for (; aa != nullptr && bb != nullptr; aa = aa->NextEntry, bb = bb->NextEntry)
+            if (aa->image_id != bb->image_id || aa->RelativePos != bb->RelativePos
+                || aa->IsMasked != bb->IsMasked || (aa->IsMasked && aa->ColourImageId != bb->ColourImageId)
