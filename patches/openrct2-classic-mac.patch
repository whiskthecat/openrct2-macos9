diff --git a/src/openrct2-ui/windows/ClassicOptions.h b/src/openrct2-ui/windows/ClassicOptions.h
new file mode 100644
index 0000000..3d2aeba
--- /dev/null
+++ b/src/openrct2-ui/windows/ClassicOptions.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#ifdef OPENRCT2_SDL_SHIM
+#include <algorithm>
+#include "OriginalHud.h"
+#include <openrct2/Context.h>
+#include <openrct2-ui/interface/Window.h>
+
+namespace OpenRCT2::Ui::Windows
+{
+    // Toolbars stay in front of ordinary windows. Keep Options and its dialogs
+    // between them, even on a 320x240 logical canvas (640x480 at scale 2).
+    struct ClassicOptionsArea
+    {
+        int32_t width, top, bottom;
+        int32_t height() const { return std::max(96, bottom - top); }
+        void fit(WindowBase& window) const
+        {
+            WindowSetPosition(window, {
+                std::clamp(window.windowPos.x, 0, std::max(0, width - window.width)),
+                std::clamp(window.windowPos.y, top, std::max(top, bottom - window.height)) });
+        }
+    };
+    inline ClassicOptionsArea GetClassicOptionsArea()
+    {
+        return { ContextGetWidth(), HudToolbarHeight() + 1, ContextGetHeight() - OriginalHudBottomHeight() - 1 };
+    }
+}
+#endif
