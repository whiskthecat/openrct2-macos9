+
+bool PaintDrawMovingOverMapOwners(PaintSession& session, const std::vector<PaintDrawEntry>& list,
+                                  const PaletteIndex* picture, const uint16_t* owners,
+                                  int32_t pictureX, int32_t pictureY, int32_t pictureWidth, const uint16_t* ownerRanks,
+                                  const uint8_t* owners8)
+{
+    return PaintWithStaffPriority(session, list, [&] {
+        if (owners8 != nullptr)
+            return PaintDrawMovingOverMapOwnersImpl(session, list, picture, owners8, pictureX, pictureY, pictureWidth, ownerRanks);
+        return PaintDrawMovingOverMapOwnersImpl(session, list, picture, owners, pictureX, pictureY, pictureWidth, ownerRanks);
+    });
+}
+
+bool PaintDrawMovingOverMapOwnersRepair(PaintSession& session, const std::vector<PaintDrawEntry>& list,
+    const PaletteIndex* picture, const uint16_t* owners,
+    int32_t pictureX, int32_t pictureY, int32_t pictureWidth, const uint16_t* ownerRanks, const uint8_t* owners8)
+{
+    if (!gPaintCompactMoving || !gPaintOrderedBlends || !gPaintDirectOwners || !_directListValid)
+        return false;
+    return PaintWithStaffPriority(session, list, [&] {
+        if (owners8 != nullptr)
+            return PaintDrawMovingOverMapOwnersImpl<uint8_t, true>(session, list, picture, owners8,
+                pictureX, pictureY, pictureWidth, ownerRanks);
+        return PaintDrawMovingOverMapOwnersImpl<uint16_t, true>(session, list, picture, owners,
+            pictureX, pictureY, pictureWidth, ownerRanks);
+    });
+}
+
+// Experimental insertion keeps picture order and decides depth pairwise.
+// Full-sort producers retain the legacy sorter's contextual ordering.
+void PaintInsertSelected(
+    PaintSession& session, std::vector<PaintSortNode>& mapNodes, std::vector<PaintSortNode>& entityNodes,
+    const std::vector<uint16_t>& maps, const std::vector<uint16_t>& entities, std::vector<PaintDrawEntry>& list,
+    bool omitOpaqueScenery, const std::vector<uint16_t>* blendContext, std::vector<uint32_t>* entityBlendPositions,
+    int32_t maxBlendHeight)
+{
+    PAINT_TIMING(insertSelected);
+    OG_SCOPE(sort);
+    list.clear();
+    const auto& rt = session.rt;
+    const uint8_t rotation = session.CurrentRotation;
+    const auto inRect = [&rt](const PaintSortNode& node) {
+        return node.bottom > rt.y && node.top < rt.y + rt.height && node.right > rt.x && node.left < rt.x + rt.width;
+    };
+    const auto overlaps = [](const PaintSortNode& a, const PaintSortNode& b) {
+        return a.left < b.right && b.left < a.right && a.top < b.bottom && b.top < a.bottom;
+    };
+    static std::vector<const PaintSortNode*> statics;
+    struct Mover
+    {
+        const PaintSortNode* node;
+        uint32_t position;
+        bool entity;
+        bool peep = false;
+        uint32_t index = 0; // node index until covers are built, then its coverage-list index
+    };
+    static std::vector<Mover> movers;
+    statics.clear();
+    movers.clear();
+    for (const auto index : maps)
+    {
+        const auto& node = mapNodes[index];
+        if (!inRect(node))
+            continue;
+        if (node.moving)
+            movers.push_back({ &node, 0, false, false, index });
+        else
+            statics.push_back(&node);
+    }
+    for (const auto index : entities)
+        if (inRect(entityNodes[index]))
+            movers.push_back({ &entityNodes[index], 0, true,
+                entityNodes[index].ps->Entity != nullptr && entityNodes[index].ps->Entity->is<Peep>(), index });
+    const auto byRank = [](const auto* a, const auto* b) { return a->baseRank < b->baseRank; };
+    // Full context supplies absolute ranks. Opaque covering-owner sets need
+    // no ordering; compact mode sorts only the surviving blend roots below.
+    if (blendContext == nullptr && !std::is_sorted(statics.begin(), statics.end(), byRank))
+        std::sort(statics.begin(), statics.end(), byRank);
+    gPaintDirectPasses++;
+    // Pairwise: which scenery entries are over each mover. Its place in the list (which only
+    // orders movers among themselves and against translucent scenery) is after the last
+    // scenery entry it is over.
+    static std::vector<uint16_t> overOwners;
+    static std::vector<uint32_t> overBegin;
+    overOwners.clear();
+    overBegin.clear();
+    uint32_t ownerTests = 0;
+    for (auto& mover : movers)
+    {
+        const auto& node = *mover.node;
+        if (blendContext != nullptr)
+        {
+            uint32_t* cached = mover.entity ? &(*entityBlendPositions)[mover.index] : nullptr;
+            if (!mover.entity && node.baseRank != 0xffff)
