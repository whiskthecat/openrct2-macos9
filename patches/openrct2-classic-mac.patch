+    uint32_t Remaining(const ScreenshotJob& job)
+    {
+        const auto remaining = static_cast<int32_t>(job.deadline - Platform::GetTicks());
+        return remaining > 0 ? static_cast<uint32_t>(remaining) : 0;
+    }
