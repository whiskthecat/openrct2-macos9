+// Bounds of everything a paint entry draws, in pixels of the target it is drawn into (world
+// pixels at the normal zoom). At other zoom levels this follows what the sprite drawing does:
+// a smaller ready-made image at half the position per step out where there is one, otherwise
+// every 2nd/4th/8th pixel; enlarged pixels when zoomed in. One pixel of slack all round.
+struct PaintExtent
+{
+    int32_t left = 32767, top = 32767, right = -32768, bottom = -32768;
+    bool blend = false;
+    void Add(ImageId imageId, ScreenCoordsXY pos, ZoomLevel zoom)
+    {
+        const auto* g1 = GfxGetG1Element(imageId);
+        if (g1 == nullptr)
+            return;
+        blend = blend || imageId.IsBlended();
+        while (zoom > ZoomLevel{ 0 } && g1->flags.has(G1Flag::hasZoomSprite))
+        {
+            imageId = imageId.WithIndex(imageId.GetIndex() - g1->zoomedOffset);
+            pos = { pos.x / 2, pos.y / 2 };
+            zoom = zoom - 1;
+            g1 = GfxGetG1Element(imageId);
+            if (g1 == nullptr)
+                return;
+        }
+        if (zoom > ZoomLevel{ 0 } && g1->flags.has(G1Flag::noZoomDraw))
+            return;
+        int32_t l = pos.x + g1->xOffset, t = pos.y + g1->yOffset;
+        int32_t r = l + g1->width, b = t + g1->height;
+        if (zoom > ZoomLevel{ 0 })
+        {
+            // Every 2^n-th pixel; compressed sprites start up to 2^n - 1 pixels earlier.
+            const int8_t level = static_cast<int8_t>(zoom);
+            const int32_t step = (1 << level) - 1;
+            l = (l - step) >> level;
+            t = (t - step) >> level;
+            r = (r + step) >> level;
+            b = (b + step) >> level;
+        }
+        else if (zoom < ZoomLevel{ 0 })
+        {
+            l = zoom.ApplyInversedTo(l);
+            t = zoom.ApplyInversedTo(t);
+            r = zoom.ApplyInversedTo(r);
+            b = zoom.ApplyInversedTo(b);
+        }
+        left = std::min(left, l);
+        right = std::max(right, r);
+        top = std::min(top, t);
+        bottom = std::max(bottom, b);
+    }
+};
