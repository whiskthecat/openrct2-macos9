diff --git a/src/openrct2/drawing/Drawing.Sprite.Magnify.h b/src/openrct2/drawing/Drawing.Sprite.Magnify.h
new file mode 100644
index 0000000..2324c12
--- /dev/null
+++ b/src/openrct2/drawing/Drawing.Sprite.Magnify.h
@@ -0,0 +1,44 @@
+#pragma once
+
+#include "Drawing.Sprite.h"
+#include "SpriteRasterCache.h"
+#include <algorithm>
+#include <cstring>
+
+namespace OpenRCT2::Drawing
+{
+    // Equal bytes are endian-independent. memcpy permits clipped/unaligned
+    // destinations; the compiler selects stores suitable for the target CPU.
+    template<int Scale>
+    inline void StoreMagnifiedPixel(PaletteIndex* output, int count, PaletteIndex pixel)
+    {
+        if (count == Scale)
+        {
+            const uint32_t repeated = uint32_t(EnumValue(pixel)) * 0x01010101u;
+            std::memcpy(output, &repeated, Scale);
+        }
+        else
+            std::fill_n(output, count, pixel);
+        PERF_WRITE(output, count);
+    }
+
+    // Only opaque spans may be copied vertically: gaps must retain the
+    // independently painted background in each destination row.
+    template<bool Owned>
+    inline void ReplicateMagnifiedSpan(PaletteIndex* first, int stride, int rows, int start, int end)
+    {
+        if (start >= end) return;
+        for (int row = 0; row < rows; ++row)
+        {
+            auto* output = first + row * stride + start;
+            if (row != 0)
+            {
+                std::memcpy(output, first + start, end - start);
+                PERF_WRITE(output, end - start);
+            }
+            if constexpr (Owned)
+                std::fill_n(gSpriteOwnerTarget.owners + (output - gSpriteOwnerTarget.pixels), end - start,
+                    gSpriteOwnerTarget.entry);
+        }
+    }
+}
