+        // Called only when a viewport switches visits, before a new set allocates.
+        void ColumnHistoryTrim()
+        {
+            std::array<uint64_t, 64> profile{};
+            const auto collect = [&] {
+                profile.fill(0);
+                for (auto& set : _columnSets)
+                    if (SetIsHistory(set))
+                    {
+                        if (!set.storageValid)
+                        {
+                            set.storageProfile.fill(0);
+                            _storageProfile = &set.storageProfile;
+                            SetStorageBytes(set);
+                            _storageProfile = nullptr;
+                            set.storageValid = true;
+                        }
+                        for (size_t i = 0; i < profile.size(); i++) profile[i] += set.storageProfile[i];
+                    }
+            };
+            const auto budgetCharge = [&] {
+                uint64_t charge = profile[63];
+                for (size_t i = 0; i < 63; i++) charge += std::max(profile[i], _historySmallHighWater[i]);
+                return charge;
+            };
+            collect();
+            while (budgetCharge() > gPaintHistoryBytes || (profile[63] != 0 && gPaintHistoryFreeBytes != nullptr
+                && gPaintHistoryFreeBytes() < 32 * 1024 * 1024))
+            {
+                ColumnCacheSet* oldest = nullptr;
+                for (auto& set : _columnSets)
+                    if (SetIsHistory(set) && (oldest == nullptr || set.lastPainted < oldest->lastPainted)) oldest = &set;
+                if (oldest == nullptr) break;
+                auto* selected = _set;
+                _set = oldest;
+                ColumnCacheClear();
+                oldest->viewport = nullptr;
+                _set = selected;
+                gPaintHistoryEvictions++;
+                collect();
+            }
+            uint64_t bytes = profile[63];
+            for (size_t i = 0; i < 63; i++)
+            {
+                bytes += profile[i];
+                _historySmallHighWater[i] = std::max(_historySmallHighWater[i], profile[i]);
+            }
+            gPaintHistoryPeakBytes = std::max(gPaintHistoryPeakBytes, bytes);
+        }
