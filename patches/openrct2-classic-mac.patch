@@ -0,0 +1,84 @@
+#pragma once
+
+// Opt-in Linux experiment counters. Native builds compile the probes out.
+// This observes geometric inputs; it never supplies positions or bounds.
+#include "../paint/Paint.Cache.h"
+#include "../interface/Viewport.h"
+#include "../world/Location.hpp"
+#include <array>
+#ifndef OPENRCT2_CLASSIC_MAC
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <set>
+#include <string>
+#endif
+
+namespace OpenRCT2::PresentationProbe
+{
+    enum Stage { bitmap, diagonal, sorting, rectangles, stages };
+#ifndef OPENRCT2_CLASSIC_MAC
+    inline const bool forceFull = std::getenv("RCT_PRESENT_FORCE_FULL") != nullptr;
+    inline const bool projectionEnabled = std::getenv("RCT_PRESENT_PROJECTIONS") != nullptr;
+    inline const bool enabled = std::getenv("RCT_PRESENT_PROBE") != nullptr;
+    struct Stats
+    {
+        uint64_t calls[stages]{}, micros[stages]{};
+        uint64_t keys = 0, bitmapBytes = 0, occupied = 0, changedBits = 0, changedPictures = 0;
+        uint64_t rebuilds = 0, reused = 0, rectangleEntities = 0, tileVisits = 0, peakOrderBytes = 0;
+        uint64_t endpointHits = 0, endpointMisses = 0;
+        uint32_t projectionFrame = 0;
+        using Projection = std::array<int32_t, 4>;
+        std::set<Projection> unique;
+        std::map<std::string, std::array<uint64_t, 2>> projections;
+        ~Stats()
+        {
+            if (!enabled) return;
+            std::fprintf(stderr, "PRESENT {\"keys\":%llu,\"bitmap_bytes\":%llu,\"occupied\":%llu,\"changed_bits\":%llu,\"changed_pictures\":%llu,\"rebuilds\":%llu,\"reused\":%llu,\"rectangle_entities\":%llu,\"tile_visits\":%llu,\"stages\":[",
+                (unsigned long long)keys, (unsigned long long)bitmapBytes, (unsigned long long)occupied,
+                (unsigned long long)changedBits, (unsigned long long)changedPictures, (unsigned long long)rebuilds,
+                (unsigned long long)reused, (unsigned long long)rectangleEntities, (unsigned long long)tileVisits);
+            for (int i = 0; i < stages; ++i)
+                std::fprintf(stderr, "%s[%llu,%llu]", i ? "," : "", (unsigned long long)calls[i], (unsigned long long)micros[i]);
+            std::fprintf(stderr, "],\"peak_order_bytes\":%llu,\"endpoint_hits\":%llu,\"endpoint_misses\":%llu,\"projections\":{", (unsigned long long)peakOrderBytes, (unsigned long long)endpointHits, (unsigned long long)endpointMisses);
+            bool first = true;
+            for (const auto& [name, values] : projections)
+            {
+                std::fprintf(stderr, "%s\"%s\":[%llu,%llu]", first ? "" : ",", name.c_str(),
+                    (unsigned long long)values[0], (unsigned long long)values[1]);
+                first = false;
+            }
+            std::fprintf(stderr, "}}\n");
+        }
+    };
+    inline Stats stats;
+    struct Scope
+    {
+        Stage stage; uint64_t start;
+        explicit Scope(Stage s) : stage(s), start(enabled && gPaintClock ? gPaintClock() : 0) {}
+        ~Scope() { if (enabled) { stats.calls[stage]++; if (gPaintClock) stats.micros[stage] += gPaintClock() - start; } }
+    };
+    inline void Projection(const char* source, uint8_t rotation, const CoordsXYZ& p)
+    {
+        if (!enabled || !projectionEnabled) return;
+        if (stats.projectionFrame != gPaintFrameSerial)
+        {
+            stats.unique.clear(); stats.projectionFrame = gPaintFrameSerial;
+        }
+        auto& count = stats.projections[source]; count[0]++;
+        if (!stats.unique.insert({p.x, p.y, p.z, rotation}).second) count[1]++;
+    }
+#else
+    inline constexpr bool enabled = false;
+    inline constexpr bool forceFull = false;
+    struct Stats
+    {
+        uint64_t keys, bitmapBytes, occupied, changedBits, changedPictures;
+        uint64_t rebuilds, reused, rectangleEntities, tileVisits, peakOrderBytes;
+        uint64_t endpointHits, endpointMisses;
+    };
+    inline Stats stats{};
+    struct Scope { explicit Scope(Stage) {} };
+    inline void Projection(const char*, uint8_t, const CoordsXYZ&) {}
+#endif
+}
