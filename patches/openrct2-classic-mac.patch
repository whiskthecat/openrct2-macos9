+
+        uint64_t ColdAllocationCharge(uint64_t bytes, uint64_t count = 1)
+        {
+            if (bytes == 0) return 0;
+            if (bytes > 16384)
+            {
+                const auto charge = (bytes + 24) * count;
+                if (_storageProfile != nullptr) (*_storageProfile)[63] += charge;
+                return charge;
+            }
+            uint64_t size = 16;
+            size_t sizeClass = 0;
+            while (size < bytes)
+            {
+                uint64_t power = 16;
+                while (power * 2 <= size) power *= 2;
+                size += size < 32 ? 8 : power / 4;
+                sizeClass++;
+            }
+            const auto charge = (size + 8) * count;
+            if (_storageProfile != nullptr) (*_storageProfile)[sizeClass] += charge;
+            return charge;
+        }
+
+        uint64_t ColumnStorageBytes(const CachedColumn& column)
+        {
+            uint64_t bytes = 0;
+            const auto vectorBytes = [&](const auto& data) {
+                using Value = typename std::decay_t<decltype(data)>::value_type;
+                bytes += ColdAllocationCharge(data.capacity() * sizeof(Value));
+            };
+            if (column.session != nullptr)
+            {
+                bytes += ColdAllocationCharge(sizeof(PaintSession) + column.session->paintEntries.fixed_capacity() * sizeof(PaintEntry));
+                if (column.session->paintEntries.dynamicPaintEntries)
+                {
+                    const size_t capacity = column.session->paintEntries.dynamicPaintEntries->capacity();
+                    // segmented_vector's 256-entry blocks plus a conservative
+                    // pointer table and control allocation allowance.
+                    bytes += ColdAllocationCharge(256 * sizeof(PaintEntry), capacity / 256);
+                    bytes += ColdAllocationCharge((capacity / 256 + 1) * sizeof(void*) * 2 + 128);
+                }
+            }
+            vectorBytes(column.quadrantHeads); vectorBytes(column.links);
+            // Offscreen tile damage may grow this while the visit is retained.
+            bytes += ColdAllocationCharge(std::max(column.changedTiles.capacity(), kColumnMaxChangedTiles)
+                * sizeof(CachedColumn::ChangedTile));
+            vectorBytes(column.spareChildren); vectorBytes(column.spareAttachments);
+            vectorBytes(column.picture); vectorBytes(column.pictureOwners); vectorBytes(column.pictureOwners8);
+            vectorBytes(column.pictureRowsValid); vectorBytes(column.picturePatches);
+            vectorBytes(column.mapSelections); vectorBytes(column.signSites);
+            for (const auto& site : column.signSites)
+            {
+                vectorBytes(site.backdrop); vectorBytes(site.backdropOwners); vectorBytes(site.foreground);
+            }
+            vectorBytes(column.drawList); vectorBytes(column.mapNodes); vectorBytes(column.entityNodes);
+            vectorBytes(column.entityRanges); vectorBytes(column.tileRanges); vectorBytes(column.baseList);
+            vectorBytes(column.tileSlots); vectorBytes(column.tileRoots);
+            vectorBytes(column.bands);
+            vectorBytes(column.blendNodes); vectorBytes(column.orderNodes); vectorBytes(column.entityBlendPositions);
+            for (const auto& band : column.bands) vectorBytes(band);
+            for (const auto& selection : column.mapSelections) vectorBytes(selection.maps);
+            const auto tableBytes = [&](const auto& table) {
+                using Value = typename std::decay_t<decltype(table)>::value_type;
+                bytes += ColdAllocationCharge(sizeof(Value) + 2 * sizeof(void*), table.size());
+                if (table.bucket_count() > 1)
+                    bytes += ColdAllocationCharge(table.bucket_count() * sizeof(void*));
+            };
+            tableBytes(column.tileNodes); tableBytes(column.ownerBaseOrder); tableBytes(column.animatedEntries);
+            for (const auto& [tile, indices] : column.tileNodes) vectorBytes(indices);
+            for (const auto& patch : column.picturePatches)
+            {
+                vectorBytes(patch.pixels); vectorBytes(patch.owners); vectorBytes(patch.order);
+            }
+            return bytes;
+        }
