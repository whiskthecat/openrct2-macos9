+            const auto oldHeight = viewport->ViewHeight();
+            const bool wasOriginal = viewport->pos.y != windowPos.y;
+            int32_t top = 0;
+            int32_t bottom = 0;
+            if (OriginalHudEnabled())
+            {
+                if (auto* toolbar = GetWindowManager()->FindByClass(WindowClass::topToolbar)) top = toolbar->height;
+                bottom = OriginalHudBottomHeight();
+            }
+            viewport->pos = windowPos + ScreenCoordsXY{ 0, top };
+            viewport->width = width;
+            viewport->height = std::max(1, height - top - bottom);
+            // Park files store the world-space centre, never a screen/HUD offset.
+            // Preserve that centre when changing the option or resizing its view.
+            if (OriginalHudEnabled() || wasOriginal)
+            {
+                const auto delta = ScreenCoordsXY{ oldWidth / 2 - viewport->ViewWidth() / 2,
+                                                   oldHeight / 2 - viewport->ViewHeight() / 2 };
+                viewport->viewPos += delta;
+                savedViewPos += delta;
+            }
+            widgets[0].top = top;
+            widgets[0].right = width;
+            widgets[0].bottom = top + viewport->height;
+        }
