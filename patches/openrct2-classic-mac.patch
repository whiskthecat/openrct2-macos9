+        {
+            return *this = static_cast<T>(static_cast<T>(*this) - other);
+        }
+        template<typename U>
+        constexpr LittleEndian& operator|=(U other) noexcept
+        {
+            return *this = static_cast<T>(static_cast<T>(*this) | other);
+        }
+        template<typename U>
+        constexpr LittleEndian& operator&=(U other) noexcept
+        {
+            return *this = static_cast<T>(static_cast<T>(*this) & other);
+        }
+        constexpr LittleEndian& operator++() noexcept
+        {
+            return *this = static_cast<T>(static_cast<T>(*this) + 1);
+        }
+        constexpr LittleEndian& operator--() noexcept
+        {
+            return *this = static_cast<T>(static_cast<T>(*this) - 1);
+        }
